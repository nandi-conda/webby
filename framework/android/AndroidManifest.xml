<?xml version="1.0" encoding="utf-8"?>
<!-- A nimkit app's manifest; build.sh fills in @ID@, @LABEL@ and @LIB@. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="@ID@">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="@LABEL@"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name="dev.nimkit.Host"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="nimkit.lib" android:value="@LIB@"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
