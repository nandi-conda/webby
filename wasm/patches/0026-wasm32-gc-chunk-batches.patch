         return wasi_allocate_direct_range(align_up_to(reservation_size, wasi_page_size));
     }
+    if (reservation_size == wasi_page_size)
+        return wasi_allocate_page();
     // NB: The memory is accessible as soon as it is allocated, and committed memory is expected to read as zero.
     auto* range = aligned_alloc(page_size(), reservation_size);
     if (!range)
@@ -468,6 +502,10 @@ void PrimitiveStorage::Allocator::release_cage_range(size_t offset, size_t size)
         wasi_release_direct_range(offset, align_up_to(size, wasi_page_size));
         return;
     }
+    if (round_up_to_page(size) == wasi_page_size) {
