diff --git a/Libraries/LibGC/MemoryPressure.h b/Libraries/LibGC/MemoryPressure.h
new file mode 100644
index 00000000..9b81756f
--- /dev/null
+++ b/Libraries/LibGC/MemoryPressure.h
@@ -0,0 +1,27 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Types.h>
+#include <LibGC/Forward.h>
+
+namespace GC {
+
+// wasm32 (WASI): the GC's view of linear memory, for an embedder that has to keep it from running out. (A header of
+// its own, not BlockAllocator.h, which nearly every file includes.)
+struct MemoryStats {
+    u64 linear_memory_bytes { 0 }; // WASI: memory.size
+    u64 chunk_bytes { 0 };         // WASI: GC chunks handed out
+    u64 spare_chunk_bytes { 0 };   // WASI: taken from malloc in a batch, not handed out yet
+    u64 free_block_bytes { 0 };    // blocks freed by sweeps and ready for reuse
+    size_t reserve_releases { 0 }; // WASI: times the last-resort reserve was released
+};
+
+// True once since the last call when GC chunks ran short (linear memory is nearly full): the embedder should put
+// pages away and collect garbage. Always false outside WASI.
+GC_API bool take_memory_pressure();
+GC_API MemoryStats memory_stats();
+
+}
diff --git a/Libraries/LibGC/PrimitiveStorage.cpp b/Libraries/LibGC/PrimitiveStorage.cpp
