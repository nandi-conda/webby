--- a/Libraries/LibGC/PrimitiveStorage.cpp
+++ b/Libraries/LibGC/PrimitiveStorage.cpp
@@ -100,6 +100,38 @@ static ErrorOr<size_t> wasi_allocate_direct_range(size_t size)
     return address.value();
 }
 
+// NB: A range of one page (64 KiB), such as every small-storage slab, would cost dlmalloc's aligned_alloc about two
+//     pages of new memory, the second never touched (the same waste LibGC's chunks had). One-page ranges come from
+//     2 MiB batches instead and go back to a free list when released.
+static constexpr size_t wasi_page_batch_size = 2 * MiB;
+
+static Vector<size_t>& wasi_free_pages()
+{
+    static NeverDestroyed<Vector<size_t>> pages;
+    return *pages;
+}
+
+static ErrorOr<size_t> wasi_allocate_page()
+{
+    auto& pages = wasi_free_pages();
+    if (pages.is_empty()) {
+        auto* batch = static_cast<u8*>(aligned_alloc(wasi_page_size, wasi_page_batch_size));
+        size_t batch_size = wasi_page_batch_size;
+        if (!batch) {
+            batch = static_cast<u8*>(aligned_alloc(wasi_page_size, wasi_page_size));
+            batch_size = wasi_page_size;
+        }
+        if (!batch)
+            return Error::from_errno(ENOMEM);
+        // Highest first, so pages are handed out from the bottom of the batch up.
+        for (size_t offset = batch_size; offset > 0; offset -= wasi_page_size)
+            TRY(pages.try_append(bit_cast<FlatPtr>(batch) + offset - wasi_page_size));
+    }
+    auto address = pages.take_last();
+    __builtin_memset(bit_cast<void*>(address), 0, wasi_page_size);
+    return address;
+}
+
 static void wasi_release_direct_range(size_t address, size_t size)
 {
     auto& free_ranges = wasi_free_direct_ranges();
@@ -341,6 +373,8 @@ ErrorOr<size_t> PrimitiveStorage::Allocator::allocate_cage_range(size_t reservat
