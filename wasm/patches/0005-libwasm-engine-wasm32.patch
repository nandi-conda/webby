 pub(crate) fn enabled() -> bool {
+    // NB: A wasm32 host cannot run machine code it generates.
+    if cfg!(target_arch = "wasm32") {
+        return false;
+    }
     options().enabled && native::try_stubs().is_some()
 }
 
