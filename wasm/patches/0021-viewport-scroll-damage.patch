+                    rect,
+                    color,
+                    compositing_and_blending_operator: CompositingAndBlendingOperator::Normal,
+                    background_color_animation_effect: EffectNodeIndex::NONE,
+                },
+                Some(rect),
+                context,
+            )
+        };
+        let list = |changed_color: Color| {
+            let mut list = fill(IntRect::new(0, 0, 100, 300), RED, scrolled);
+            list.extend_from_slice(&fill(IntRect::new(0, 60, 100, 10), changed_color, scrolled));
+            list.extend_from_slice(&fill(IntRect::new(0, 50, 100, 10), BLUE, ContextRef::default()));
+            list
+        };
+        // The canvas background, in the viewport's own space, over all of it.
+        let with_background = |changed_color: Color| {
+            let mut with_background = fill(IntRect::new(0, 0, 100, 100), CYAN, ContextRef::default());
+            with_background.extend_from_slice(&list(changed_color));
+            with_background
+        };
+        let old_offsets = [FloatPoint::default(), FloatPoint::default()];
+        // The page scrolled down by 40 device pixels.
+        let new_offsets = [FloatPoint::default(), FloatPoint { x: 0.0, y: -40.0 }];
+
+        let damage = viewport_scroll_damage(&list(GREEN), &list(GREEN), &tree, &old_offsets, &new_offsets).unwrap();
+        assert_eq!(damage.scroll, FloatPoint { x: 0.0, y: -40.0 });
+        assert!(damage.content.is_empty());
+        assert_eq!(damage.unscrolled_new, IntRect::new(0, 49, 100, 12));
+        assert_eq!(damage.unscrolled_old, IntRect::new(0, 9, 100, 12));
+
+        let damage =
+            viewport_scroll_damage(&with_background(GREEN), &with_background(GREEN), &tree, &old_offsets, &new_offsets).unwrap();
+        assert!(damage.content.is_empty());
+        assert_eq!(damage.unscrolled_new, IntRect::new(0, 49, 100, 12));
+
+        let damage = viewport_scroll_damage(&list(GREEN), &list(YELLOW), &tree, &old_offsets, &new_offsets).unwrap();
+        assert_eq!(damage.content, IntRect::new(0, 19, 100, 12));
+
+        assert_eq!(damage.content_pieces, vec![IntRect::new(0, 19, 100, 12)]);
+
+        let damage = viewport_scroll_damage(&list(GREEN), &list(YELLOW), &tree, &old_offsets, &old_offsets).unwrap();
+        assert_eq!(damage.scroll, FloatPoint::default());
+        assert_eq!(damage.content, IntRect::new(0, 59, 100, 12));
+    }
