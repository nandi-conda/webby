+// What a scroll of the layout viewport changed, for a rasterizer that keeps the last frame and moves its pixels
+// instead of repainting them (webby's wasm UI). Moving the last frame by the viewport's scroll draws everything that
+// scrolls with the viewport where it now is, so what still has to be repainted is:
+// - `content`: what changed apart from that scroll, which is the damage between the old list replayed with the
+//   viewport's new offset and the new list;
+// - `unscrolled_new` and `unscrolled_old`: what does not move with the viewport (fixed boxes, the viewport's own
+//   scrollbar, content under a fixed clip or filter that is not the viewport's), where it is drawn now and where the
+//   moved pixels put its old drawing.
+pub struct ViewportScrollDamage {
+    pub viewport_scroll_node: SpatialNodeIndex,
+    pub scroll: FloatPoint,
+    pub content: IntRect,
+    pub unscrolled_new: IntRect,
+    pub unscrolled_old: IntRect,
+}
+
+// The layout viewport's scroll node: the first scroll node right under the visual viewport.
+pub fn find_viewport_scroll_node(tree: &VisualContextTree) -> Option<SpatialNodeIndex> {
+    tree.spatial_nodes
+        .iter()
+        .enumerate()
+        .skip(1)
+        .find(|(_, node)| matches!(node.data, SpatialData::Scroll(_)) && node.parent == VISUAL_VIEWPORT_NODE_INDEX)
+        .map(|(index, _)| SpatialNodeIndex(index as u32))
+}
+
+// Per spatial node: whether what it draws moves exactly as the viewport scrolls (its root path goes through the
+// viewport's scroll node and holds no anchor shift, which can follow the viewport's offset by its own rules).
+fn spatial_nodes_moving_with(tree: &VisualContextTree, viewport_scroll_node: SpatialNodeIndex) -> Vec<bool> {
+    let count = tree.spatial_nodes.len();
+    // 0: not known yet, 1: moves, 2: does not.
+    let mut verdicts = vec![0u8; count];
+    let mut path = Vec::new();
+    for start in 0..count {
+        path.clear();
+        let mut index = start;
+        let verdict = loop {
+            if verdicts[index] != 0 {
+                break verdicts[index];
+            }
+            if index == viewport_scroll_node.0 as usize {
+                break 1;
+            }
+            let node = &tree.spatial_nodes[index];
+            if index == VISUAL_VIEWPORT_NODE_INDEX.0 as usize
+                || matches!(node.data, SpatialData::AnchorScrollShift(_))
+                || path.len() > count
+            {
+                break 2;
+            }
+            path.push(index);
+            let parent = node.parent.0 as usize;
+            if parent >= count {
+                break 2;
+            }
+            index = parent;
+        };
+        for &index in &path {
+            verdicts[index] = verdict;
+        }
+        if verdicts[start] == 0 {
+            verdicts[start] = verdict;
+        }
+    }
+    // The viewport's scroll node itself moves what it draws.
+    if let Some(verdict) = verdicts.get_mut(viewport_scroll_node.0 as usize) {
+        *verdict = 1;
+    }
+    verdicts.into_iter().map(|verdict| verdict == 1).collect()
+}
+
+// The viewport-space bounds of what `frame` draws that does not move with the viewport's scroll, or None when they
+// have no bounds.
+fn unscrolled_bounds(
+    frame: DisplayListFrame<'_>,
+    viewport_scroll_node: SpatialNodeIndex,
+    viewport_rect: IntRect,
+) -> Option<IntRect> {
+    let tree = frame.visual_context_tree;
+    let moves = spatial_nodes_moving_with(tree, viewport_scroll_node);
+    let spatial_moves = |index: SpatialNodeIndex| moves.get(index.0 as usize).copied().unwrap_or(false);
+    let viewport = viewport_rect.to_float();
+
+    // A clip that does not move cuts moving content at the same place before and after the scroll. One that holds
+    // the whole viewport cuts nothing the moved pixels get wrong; any other does.
+    let mut clip_verdicts = vec![0u8; tree.clip_nodes.len()];
+    let clip_is_ok = |start: ClipNodeIndex, clip_verdicts: &mut Vec<u8>| -> bool {
+        let mut index = start;
+        let mut path = Vec::new();
+        let verdict = loop {
+            if index.is_none() {
+                break 1;
+            }
+            let i = index.0 as usize;
+            if i >= tree.clip_nodes.len() || path.len() > tree.clip_nodes.len() {
+                break 2;
+            }
+            if clip_verdicts[i] != 0 {
+                break clip_verdicts[i];
+            }
+            let node = &tree.clip_nodes[i];
+            let ok = spatial_moves(node.spatial)
+                || match &node.data {
+                    ClipNodeData::Rect(clip) => {
+                        clip.mode == ClipMode::Intersect
+                            && !clip.corner_radii.has_any_radius()
+                            && tree
+                                .transform_rect_to_viewport(
+                                    node.spatial,
+                                    clip.rect,
+                                    frame.scroll_offsets,
+                                    IncludeVisualViewportTransform::Yes,
+                                )
+                                .contains_rect(viewport)
+                    }
+                    ClipNodeData::Dead => true,
+                    ClipNodeData::Path(_) => false,
+                };
+            if !ok {
+                break 2;
+            }
+            path.push(i);
+            index = node.parent;
+        };
+        for i in path {
+            clip_verdicts[i] = verdict;
+        }
+        verdict == 1
+    };
+    // An effect that does not move changes moving pixels one by one (opacity, blending) and so the same before and
+    // after the scroll; a filter or a mask reaches around and does not.
+    let mut effect_verdicts = vec![0u8; tree.effect_nodes.len()];
+    let effect_is_ok = |start: EffectNodeIndex, effect_verdicts: &mut Vec<u8>, clip_verdicts: &mut Vec<u8>| -> bool {
+        let mut index = start;
+        let mut path = Vec::new();
+        let verdict = loop {
+            if index.is_none() {
+                break 1;
+            }
+            let i = index.0 as usize;
+            if i >= tree.effect_nodes.len() || path.len() > tree.effect_nodes.len() {
+                break 2;
+            }
+            if effect_verdicts[i] != 0 {
+                break effect_verdicts[i];
+            }
+            let node = &tree.effect_nodes[i];
+            let ok = (spatial_moves(node.spatial)
+                || match &node.data {
+                    EffectNodeData::Effects(effects) => effects.filter.is_none() && effects.backdrop_filter.is_none(),
+                    EffectNodeData::BackgroundColorAnimation | EffectNodeData::Dead => true,
+                    EffectNodeData::Mask(_) => false,
+                })
+                && clip_is_ok(node.local_clip, clip_verdicts);
+            if !ok {
+                break 2;
+            }
+            path.push(i);
+            index = node.parent;
+        };
+        for i in path {
+            effect_verdicts[i] = verdict;
+        }
+        verdict == 1
+    };
+
+    let mut culling = TreeCullingScratch::default();
+    tree.fill_culling_scratch(&mut culling);
+    let effect_clips = EffectClipPlan::from_contexts(tree, frame.command_runs.iter().map(|run| run.context))?;
+    let filter_spreading = FilterSpreading::default();
+    let side = TreeSide {
+        tree,
+        scroll_offsets: frame.scroll_offsets,
+        culling: &culling,
+        effect_clips: &effect_clips,
+        filter_spreading: &filter_spreading,
+    };
+    let mut damage = DamageAccumulator {
+        damage_rect: None,
+        changed_unbounded_command: false,
+        viewport_rect,
+    };
+    let tape = Tape {
+        bytes: frame.command_bytes,
+        runs: frame.command_runs,
+    };
+    let mut commands = Vec::new();
+    for run in frame.command_runs {
+        if damage.covers_viewport() {
+            break;
+        }
+        let context = run.context;
+        let context_moves = spatial_moves(context.spatial)
+            && clip_is_ok(context.clip, &mut clip_verdicts)
+            && effect_is_ok(context.effect, &mut effect_verdicts, &mut clip_verdicts);
+        commands.clear();
+        tape.collect_commands_of_runs(std::slice::from_ref(run), &mut commands);
+        for command in &commands {
+            // The viewport's scrollbar sits still while its thumb follows the scroll.
+            let is_viewport_scrollbar = command.header.command_type == DisplayListCommandType::PaintScrollBar
+                && read_command::<PaintScrollBar>(command.payload).scroll_node_index == viewport_scroll_node;
+            if context_moves && !is_viewport_scrollbar {
+                continue;
+            }
+            damage.add_command_damage(command, side);
+        }
+    }
+    if damage.changed_unbounded_command {
+        return None;
+    }
+    let Some(damage_rect) = damage.damage_rect else {
+        return Some(IntRect::default());
+    };
+    Some(intersect_like_gfx_int_rect(damage_rect.inflated_edges(1, 1, 1, 1), viewport_rect))
+}
+
+// None when the change cannot be told as a move plus damage: the trees disagree on the viewport's scroll node, or a
+// change has no bounds.
+pub fn compute_viewport_scroll_damage(
+    old_frame: DisplayListFrame<'_>,
+    new_frame: DisplayListFrame<'_>,
+    viewport_rect: IntRect,
+    live_content_changes: LiveContentChanges<'_>,
+) -> Option<ViewportScrollDamage> {
+    let viewport_scroll_node = find_viewport_scroll_node(new_frame.visual_context_tree)?;
+    if find_viewport_scroll_node(old_frame.visual_context_tree) != Some(viewport_scroll_node) {
+        return None;
+    }
+    let old_offset = device_offset_for_index(old_frame.scroll_offsets, viewport_scroll_node);
+    let new_offset = device_offset_for_index(new_frame.scroll_offsets, viewport_scroll_node);
+    let scroll = FloatPoint {
+        x: new_offset.x - old_offset.x,
+        y: new_offset.y - old_offset.y,
+    };
+    if scroll.x == 0.0 && scroll.y == 0.0 {
+        let content = compute_display_list_damage(old_frame, new_frame, viewport_rect, live_content_changes)?;
+        return Some(ViewportScrollDamage {
+            viewport_scroll_node,
+            scroll,
+            content,
+            unscrolled_new: IntRect::default(),
+            unscrolled_old: IntRect::default(),
+        });
+    }
+    let mut old_offsets_after_scroll = old_frame.scroll_offsets.to_vec();
+    if (viewport_scroll_node.0 as usize) >= old_offsets_after_scroll.len() {
+        old_offsets_after_scroll.resize(viewport_scroll_node.0 as usize + 1, FloatPoint::default());
+    }
+    old_offsets_after_scroll[viewport_scroll_node.0 as usize] = new_offset;
+    let content = compute_display_list_damage(
+        DisplayListFrame {
+            scroll_offsets: &old_offsets_after_scroll,
+            ..old_frame
+        },
+        new_frame,
+        viewport_rect,
+        live_content_changes,
+    )?;
+    let unscrolled_new = unscrolled_bounds(new_frame, viewport_scroll_node, viewport_rect)?;
+    // Where the moved pixels put the old drawing: a device offset is where the scrolled content's origin is drawn, so
+    // the content moves by the offset's change (up, negative, as the page scrolls down).
+    let unscrolled_old = unscrolled_bounds(old_frame, viewport_scroll_node, viewport_rect)?;
+    let unscrolled_old = if unscrolled_old.is_empty() {
+        unscrolled_old
+    } else {
+        intersect_like_gfx_int_rect(
+            enclosing_int_rect(unscrolled_old.to_float().translated(scroll.x, scroll.y)),
+            viewport_rect,
+        )
+    };
+    Some(ViewportScrollDamage {
+        viewport_scroll_node,
+        scroll,
+        content,
+        unscrolled_new,
+        unscrolled_old,
+    })
+}
