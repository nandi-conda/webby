 #include <AudioServer/PlatformAudio.h>
 
+#if defined(AK_OS_WASI)
+#    include <AK/AtomicRefCounted.h>
+#    include <LibAudio/NullPlaybackStream.h>
+
+// webby's wasm build: the host's sound output (latha:gui's audio interface, wasm/ui/LocalAudio.cpp), when the module
+// has one.
+extern "C" __attribute__((weak)) int webby_audio_open(unsigned sample_rate, unsigned channels);
+extern "C" __attribute__((weak)) void webby_audio_write(int id, float const* samples, size_t count);
+extern "C" __attribute__((weak)) void webby_audio_flush(int id);
+extern "C" __attribute__((weak)) void webby_audio_close(int id);
+#endif
+
 namespace Audio {
 
-#if !defined(AUDIOSERVER_PLAYBACK_BACKEND)
+#if defined(AK_OS_WASI)
+
+// The host plays what it is given and keeps no clock we can read, so the stream is a null stream (which keeps the
+// device's pace by the wall clock) that also hands every buffer it mixed to the host. The host's short queue absorbs
+// the difference between the two clocks.
+class HostOutput final : public AtomicRefCounted<HostOutput> {
+public:
+    explicit HostOutput(int id)
+        : m_id(id)
+    {
+    }
+    ~HostOutput() { webby_audio_close(m_id); }
+    int id() const { return m_id; }
+
+private:
+    int m_id { 0 };
+};
+
+class HostPlaybackStream final : public PlaybackStream {
+public:
+    HostPlaybackStream(NonnullRefPtr<PlaybackStream> inner, NonnullRefPtr<HostOutput> output)
+        : m_inner(move(inner))
+        , m_output(move(output))
+    {
+    }
+
+    virtual SampleSpecification sample_specification() const override { return m_inner->sample_specification(); }
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> resume() override { return m_inner->resume(); }
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> drain_buffer_and_suspend() override { return m_inner->drain_buffer_and_suspend(); }
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> discard_buffer_and_suspend() override
+    {
+        webby_audio_flush(m_output->id());
+        return m_inner->discard_buffer_and_suspend();
+    }
+    virtual void notify_data_available() override { m_inner->notify_data_available(); }
+    virtual NonnullRefPtr<Core::ThreadedPromise<void>> set_volume(double volume) override { return m_inner->set_volume(volume); }
+
+private:
+    NonnullRefPtr<PlaybackStream> m_inner;
+    NonnullRefPtr<HostOutput> m_output;
+};
+
+NonnullRefPtr<PlaybackStream::CreatePromise> create_platform_playback_stream(OutputState initial_output_state, u32 target_latency_ms, PlaybackStream::AudioDataRequestCallback data_request_callback)
+{
+    if (!&webby_audio_open)
+        return PlaybackStream::CreatePromise::rejected(Error::from_string_literal("No platform audio backend"));
+    // NullPlaybackStream's format: 44.1 kHz stereo.
+    auto id = webby_audio_open(44100, 2);
+    if (id <= 0)
+        return PlaybackStream::CreatePromise::rejected(Error::from_string_literal("The host has no sound output"));
+    auto output = make_ref_counted<HostOutput>(id);
+    auto inner = NullPlaybackStream::create(initial_output_state, target_latency_ms,
+        [output, callback = move(data_request_callback)](Span<float> buffer, MonotonicTime buffer_starts_playing_at) {
+            auto samples = callback(buffer, buffer_starts_playing_at);
+            if (!samples.is_empty())
+                webby_audio_write(output->id(), samples.data(), samples.size());
+            return samples;
+        });
+    auto promise = PlaybackStream::CreatePromise::construct();
+    promise->resolve(adopt_ref(*new HostPlaybackStream(move(inner), move(output))));
+    return promise;
+}
+
+#elif !defined(AUDIOSERVER_PLAYBACK_BACKEND)
 
 NonnullRefPtr<PlaybackStream::CreatePromise> create_platform_playback_stream(OutputState, u32, PlaybackStream::AudioDataRequestCallback)
