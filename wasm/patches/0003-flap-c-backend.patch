+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+use flapc::{Architecture, CompilationUnit, CompileOptions, Compiler, ObjectFormat, SourceInput, Target};
+use std::process::Command;
+
+const INTERPRETER: &str = include_str!("../../Interpreter/interpreter.flap");
+const LAYOUT: &str = include_str!("interpreter-layout.conf");
+
+fn interpreter_c(profiling: bool) -> String {
+    interpreter_c_with_layout(profiling, LAYOUT)
+}
+
+fn interpreter_c_with_layout(profiling: bool, layout: &str) -> String {
+    let compiler = Compiler::new(CompileOptions {
+        target: Target {
+            architecture: Architecture::X86_64,
+            object_format: ObjectFormat::Elf,
+        },
+        has_jscvt: false,
+        has_lzcnt: false,
+        has_bmi1: false,
+        enable_assertions: true,
+        profiling,
+        profile: flapc::Profile::JavaScript,
+    });
+    let prepared = compiler
+        .prepare(CompilationUnit {
+            source: SourceInput {
+                name: "interpreter.flap",
+                contents: INTERPRETER,
+            },
+            constants: Some(SourceInput {
+                name: "interpreter-layout.conf",
+                contents: layout,
+            }),
+        })
+        .expect("interpreter preparation should succeed");
+    compiler
+        .compile_prepared_c(&prepared)
+        .expect("the interpreter should print as C")
+        .as_str()
+        .to_owned()
+}
+
+#[test]
+fn prints_the_interpreter_as_c() {
+    let c = interpreter_c(false);
+    for symbol in [
+        "void js_interpreter(",
+        "flap_handler* const js_interpreter_dispatch_table[256]",
+        "flap_handler* const js_interpreter_debug_dispatch_table[256]",
+        "js_interpreter_handler_ranges[1024]",
+        "static void flap_handler_Add(FLAP_PARAMETERS)",
+    ] {
+        assert!(c.contains(symbol), "the C interpreter lacks {symbol}");
+    }
+    let profiling = interpreter_c(true);
+    assert!(profiling.contains("void js_interpreter_profiling("));
+    assert!(profiling.contains("js_interpreter_dispatch_table_profiling[256]"));
+}
+
+/// A 4-byte cage base, as on wasm32, once let the lowering of GetByValue and
+/// PutByValue skip an Int32 unbox that their array index conversion still
+/// read. The C backend refuses a register nothing assigns.
+#[test]
+fn narrow_cage_base_reads_no_unassigned_register() {
+    let layout = format!("{LAYOUT}\nconst VM_PRIMITIVE_STORAGE_CAGE_BASE_WIDTH = 4\n");
+    let c = interpreter_c_with_layout(false, &layout);
+    assert!(c.contains("static void flap_handler_GetByValue(FLAP_PARAMETERS)"));
+}
+
+/// Compiles the C with clang when it is installed, which checks that every
+/// dispatch is a tail call clang can guarantee.
+#[test]
+fn interpreter_c_compiles_with_clang() {
+    let clang = std::env::var("FLAP_TEST_CLANG").unwrap_or_else(|_| "clang".to_string());
+    if Command::new(&clang).arg("--version").output().is_err() {
+        eprintln!("skipping: {clang} is not installed");
+        return;
+    }
+    let directory = std::env::temp_dir().join(format!("flapc-c-test-{}", std::process::id()));
+    std::fs::create_dir_all(&directory).unwrap();
+    let source = directory.join("interpreter.c");
+    std::fs::write(&source, interpreter_c(false)).unwrap();
+    let output = Command::new(&clang)
+        .args(["-std=c11", "-fsyntax-only", "-Werror=return-type"])
+        .arg(&source)
+        .output()
+        .expect("run clang");
+    let _ = std::fs::remove_dir_all(&directory);
+    assert!(
+        output.status.success(),
+        "clang rejected the C interpreter:\n{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
