+
+/// Compile the interpreter Flap printed as C. Its handlers tail-call each other, which only clang guarantees, and on
+/// WebAssembly only with the tail-call proposal.
+fn compile_c_interpreter(source_paths: &[PathBuf]) {
+    let mut build = cc::Build::new();
+    build.files(source_paths);
+    if env::var_os("CC").is_none() && !build.get_compiler().is_like_clang() {
+        build.compiler("clang");
+    }
+    build.std("c11");
+    build.opt_level(2);
+    build.warnings(false);
+    build.flag("-fno-strict-aliasing");
+    if target_is_wasm32() {
+        build.flag("-mtail-call");
+        // The heap region starts at address 0 and cells are addressed by their uncompressed offset.
+        build.define("FLAP_COMPRESSED_CELL_POINTER_SHIFT", "0");
+    }
+    build.compile("libjs_runtime_interpreter");
 }
 
