WebGL on WASI (webby wasm/gl, wasm/ui/LocalWebGL.cpp): LibWeb asks a local WebGL transport factory when the page
has no Compositor host, and OpenGLContext reads frames back into a CPU painting surface on WASI, the host's
GL behind EGL_PLATFORM_ANGLE_TYPE_DEFAULT_ANGLE.

diff --git a/Libraries/LibWeb/WebGL/LocalWebGLTransport.h b/Libraries/LibWeb/WebGL/LocalWebGLTransport.h
new file mode 100644
index 0000000000..ac09757e38
--- /dev/null
+++ b/Libraries/LibWeb/WebGL/LocalWebGLTransport.h
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2026, the webby developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/RefPtr.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+
+namespace Web::WebGL {
+
+// A page with no Compositor host (webby's wasm UI runs LibWeb and the Compositor's canvas code in one module) can
+// still have WebGL contexts: when this is set, a context of such a page gets its transport from it. Null: no WebGL.
+using LocalWebGLTransportFactory = RefPtr<RemoteWebGLTransport> (*)(Page&);
+WEB_API void set_local_webgl_transport_factory(LocalWebGLTransportFactory);
+
+}
diff --git a/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp b/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
