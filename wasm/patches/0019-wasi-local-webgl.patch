+#include <LibWeb/WebGL/LocalWebGLTransport.h>
 #include <LibWeb/WebGL/RemoteWebGLTransport.h>
 #include <LibWeb/WebGL/WebGL2RenderingContext.h>
 #include <LibWeb/WebGL/WebGLContextAttributes.h>
@@ -218,12 +219,16 @@ struct RemoteWebGLContext {
     }
 };
 
+LocalWebGLTransportFactory s_local_webgl_transport_factory;
+
 Optional<RemoteWebGLContext> create_remote_webgl_context(HTML::CanvasHost& canvas, WebGLVersion webgl_version, bool depth, bool stencil, bool antialias)
 {
     auto& page = canvas.canvas_page();
-    if (!page.has_compositor_host())
-        return {};
-    auto transport = page.compositor_host().create_webgl_transport();
+    RefPtr<RemoteWebGLTransport> transport;
+    if (page.has_compositor_host())
+        transport = page.compositor_host().create_webgl_transport();
+    else if (s_local_webgl_transport_factory)
+        transport = s_local_webgl_transport_factory(page);
     if (!transport)
         return {};
 
@@ -240,6 +245,11 @@ Optional<RemoteWebGLContext> create_remote_webgl_context(HTML::CanvasHost& canva
 
 }
 
+void set_local_webgl_transport_factory(LocalWebGLTransportFactory factory)
+{
+    s_local_webgl_transport_factory = factory;
+}
