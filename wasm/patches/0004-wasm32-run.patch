+/// On wasm32 the heap region is the low part of linear memory, base 0, which LibGC's chunks share with the static data,
+/// the shadow stack and malloc. Only what lies past the static data and the stack (`__heap_base`, where wasm-ld starts
+/// the allocators' memory) can be a cell, so a value on the stack or in a static is told apart from one; a value that
+/// malloc allocated is not.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn is_in_heap_region(address: usize) -> bool {
+    unsafe extern "C" {
+        static __heap_base: u8;
+    }
+    let heap_base = core::ptr::addr_of!(__heap_base).addr();
+    address >= heap_base && address as u64 <= crate::build_configuration::HEAP_REGION_OFFSET_MASK
