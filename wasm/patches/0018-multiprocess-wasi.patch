+/*
+ * Copyright (c) 2026, the webby authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// WASI has no GL driver (ANGLE is headers only there), so the Compositor makes no WebGL contexts: create() fails,
+// which WebContent reports to the page as a failed getContext("webgl"). Nothing else here can be reached.
+
+#include <Compositor/HostWebGLContext.h>
+#include <Compositor/OpenGLContext.h>
+#include <LibGfx/ShareableBitmap.h>
+#include <Compositor/PaintingSurface.h>
+
+namespace Compositor {
+
+struct OpenGLContext::Impl { };
+struct OpenGLContext::ColorBuffer { };
+
+OwnPtr<OpenGLContext> OpenGLContext::create(RefPtr<Gfx::SkiaBackendContext>, WebGLVersion, DrawingBufferOptions) { return {}; }
+OpenGLContext::~OpenGLContext() = default;
+Vector<String> OpenGLContext::get_supported_opengl_extensions() { return {}; }
+
+OwnPtr<HostWebGLContext> HostWebGLContext::create(RefPtr<Gfx::SkiaBackendContext>, OpenGLContext::WebGLVersion, OpenGLContext::DrawingBufferOptions, Gfx::IntSize)
+{
+    dbgln("Compositor: no WebGL on WASI");
+    return {};
+}
+
+ErrorOr<void> HostWebGLContext::execute_commands(ReadonlyBytes, Vector<UploadSource> const&) { VERIFY_NOT_REACHED(); }
+Optional<ReadonlyBytes> HostWebGLContext::shared_command_buffer_range(u64, u64) const { VERIFY_NOT_REACHED(); }
+ErrorOr<ByteBuffer> HostWebGLContext::execute_sync_call(ReadonlyBytes) { VERIFY_NOT_REACHED(); }
+Gfx::ShareableBitmap HostWebGLContext::read_back_drawing_buffer(Gfx::IntRect) { VERIFY_NOT_REACHED(); }
+Compositing::WebGL::ReadPixelsResult HostWebGLContext::read_pixels_robust_angle(Compositing::WebGL::GLint, Compositing::WebGL::GLint, Compositing::WebGL::GLsizei, Compositing::WebGL::GLsizei, Compositing::WebGL::GLenum, Compositing::WebGL::GLenum, Compositing::WebGL::GLsizei, Core::AnonymousBuffer) { VERIFY_NOT_REACHED(); }
+bool HostWebGLContext::read_buffer_sub_data(Compositing::WebGL::GLenum, Compositing::WebGL::GLintptr, Compositing::WebGL::GLintptr, Core::AnonymousBuffer) { VERIFY_NOT_REACHED(); }
+ErrorOr<NonnullRefPtr<Gfx::PaintingSurface>> HostWebGLContext::prepare_for_compositing(bool) { VERIFY_NOT_REACHED(); }
+void HostWebGLContext::clear_drawing_buffer() { VERIFY_NOT_REACHED(); }
+RefPtr<Gfx::PaintingSurface> HostWebGLContext::presented_surface() { VERIFY_NOT_REACHED(); }
+
+}
