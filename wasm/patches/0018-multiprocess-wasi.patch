+#if defined(AK_OS_WASI)
+// The read end of a latha:proc channel lives in one instance at a time, so it moves to the client it is sent to, while
+// natively the request keeps a copy for the next owner. A request that changes owners gives the new one a new pipe,
+// with what the previous owner was sent while the transfer lease was held (as a lease holder, it was paused, and read
+// none of it). Writes to a channel never block.
+ErrorOr<void> Request::wasi_replace_client_pipe()
+{
+    m_client_writer_notifier = nullptr;
+    m_client_request_pipe = TRY(RequestPipe::create());
+    ReadonlyBytes replay = m_wasi_replay.bytes();
+    while (!replay.is_empty())
+        replay = replay.slice(TRY(m_client_request_pipe->write(replay)));
+    if (!m_transfer_lease.has_value())
+        m_wasi_replay.clear();
+    return {};
+}
+#endif
