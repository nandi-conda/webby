new file mode 100644
index 00000000000..5c813d046eb
--- /dev/null
+++ b/Utilities/webby-headless.cpp
@@ -0,0 +1,44 @@
+/*
+ * Copyright (c) 2026, the webby authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// webby-headless: the browser process of wasm webby without a window. LibWebView's Application starts WebContent,
+// Compositor, RequestServer and ImageDecoder as it does natively; on WASI each is a .wasm next to this one that
+// compat's posix_spawn runs as a latha:proc child instance, connected over latha:proc channels, with page bitmaps
+// in latha:proc shared memory. Application's own --headless modes do the rest, e.g.
+//   latha-run webby-headless.wasm --headless=screenshot --screenshot-path out.png --screenshot-delay 2 https://example.com
+
+#include <LibCore/EventLoop.h>
+#include <LibMain/Main.h>
+#include <LibWebView/Application.h>
+
+class WebbyHeadless final : public WebView::Application {
+    WEB_VIEW_APPLICATION(WebbyHeadless)
+
+public:
+    explicit WebbyHeadless(Optional<ByteString> ladybird_binary_path)
+        : WebView::Application(move(ladybird_binary_path))
+    {
+    }
+
+private:
+    virtual void create_platform_options(WebView::BrowserOptions& browser_options, WebView::RequestServerOptions&, WebView::WebContentOptions&) override
+    {
+        if (!browser_options.headless_mode.has_value())
+            browser_options.headless_mode = WebView::HeadlessMode::Screenshot;
+        // No SQLite in the wasm build's sysroot.
+        browser_options.disable_sql_database = WebView::DisableSQLDatabase::Yes;
+    }
+    virtual Core::EventLoop& create_platform_event_loop() override { return Core::EventLoop::current(); }
+    // One browser process per run: no profile lock or hand-off to a running one.
+    virtual bool should_coordinate_browser_process() const override { return false; }
+};
+
+ErrorOr<int> ladybird_main(Main::Arguments arguments)
+{
+    Core::EventLoop event_loop;
+    auto app = TRY(WebbyHeadless::create(arguments, OptionalNone {}));
+    return app->execute();
+}
