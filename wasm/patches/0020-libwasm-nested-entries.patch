 }
+
+fn host_functions_call_back_into_webassembly_on_this_thread() {
+    use libwasm_engine::runtime::FunctionAddress;
+    use libwasm_engine::types::{FuncType, ValType};
+    use std::cell::Cell;
+    use std::rc::Rc;
+    let mut store = Store::new();
+    let outer: Rc<Cell<Option<FunctionAddress>>> = Rc::new(Cell::new(None));
+    let callee = outer.clone();
+    let call_back = store.allocate_host_function(
+        FuncType {
+            params: vec![ValType::I32],
+            results: vec![ValType::I32],
+        },
+        Rc::new(move |store: &mut Store, arguments: &[Value]| {
+            store.invoke(callee.get().unwrap(), arguments)
+        }),
+    );
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/reentry.wasm");
+    let module = libwasm_engine::compile(&std::fs::read(path).unwrap()).unwrap();
+    let instance = store
+        .instantiate(Arc::new(module), &[ExternValue::Function(call_back)])
+        .unwrap();
+    let Some(ExternValue::Function(function)) = store.instance(instance).export("outer") else {
+        panic!("no function export outer");
+    };
+    outer.set(Some(function));
+    // NB: Each level is an entry into the interpreter from a host function that an outer entry called.
+    for depth in [1, 2, 3, 10, 20] {
+        assert_eq!(
+            call(&mut store, instance, "outer", &[Value::I32(depth)]),
+            Ok(vec![Value::I32(depth)]),
+            "{depth} nested entries"
+        );
+    }
+}
+
+#[test]
+fn host_functions_call_back_into_webassembly() {
+    // NB: Like a browser's main thread (and the WASI modules' 8 MiB stack), not a test thread's 2 MiB.
+    std::thread::Builder::new()
+        .stack_size(8 * 1024 * 1024)
+        .spawn(host_functions_call_back_into_webassembly_on_this_thread)
+        .unwrap()
+        .join()
+        .unwrap();
+}
