index 00000000..aa814c55
--- /dev/null
+++ b/Libraries/LibWasm/Engine/tests/fixtures/reentry.wat
@@ -0,0 +1,8 @@
+;; Calls from WebAssembly into the host that call back into WebAssembly, the way wasm-bindgen glue calls exports
+;; such as __externref_table_alloc from the imports a module calls.
+(module
+  (import "host" "call_back" (func $call_back (param i32) (result i32)))
+  (func (export "outer") (param $n i32) (result i32)
+    (if (result i32) (i32.eqz (local.get $n))
+      (then (i32.const 0))
+      (else (i32.add (call $call_back (i32.sub (local.get $n) (i32.const 1))) (i32.const 1))))))
