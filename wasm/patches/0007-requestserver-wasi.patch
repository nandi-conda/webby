 ThreadPool::ThreadPool()
 {
     for (size_t i = 0; i < THREAD_COUNT; ++i) {
@@ -74,4 +95,6 @@ void ThreadPool::submit(Function<void()> work)
     m_condition.signal();
 }
 
+#endif
+
 }
