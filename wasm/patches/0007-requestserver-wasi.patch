     return *instance;
 }
 
+#if defined(AK_OS_WASI)
+// NB: A wasm32-wasip1 module has one thread. Pool work runs as a task on the event loop of the thread that submits it,
+//     which is what the users of the pool (e.g. LibDNS's system resolver) hand their results back to anyway.
+ThreadPool::ThreadPool() = default;
+
+intptr_t ThreadPool::worker_thread_func()
+{
+    VERIFY_NOT_REACHED();
+}
+
+void ThreadPool::submit(Function<void()> work)
+{
+    Core::deferred_invoke(move(work));
+}
