diff --git a/Utilities/requestserver-ipc.cpp b/Utilities/requestserver-ipc.cpp
new file mode 100644
index 00000000000..1074ae90b4a
--- /dev/null
+++ b/Utilities/requestserver-ipc.cpp
@@ -0,0 +1,150 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// requestserver-ipc: RequestServer over IPC inside WebAssembly. URLs are fetched through Requests::RequestClient, as
+// WebContent fetches them, from a RequestServer that is reached the way the browser reaches it: a control connection
+// (RequestControlClient <-> ControlConnectionFromClient), connect_new_client() over it (a synchronous request that
+// hands back a new transport), and the request's body coming through a descriptor RequestServer passes along.
+//
+// By default RequestServer runs in this same module: both ends are TransportSockets over a socketpair in this
+// instance's memory (compat/webby_wasi_local.c), with LibIPC's thread-less WASI transport. With --spawn PATH it runs as
+// RequestServer.wasm in a child instance started over latha:proc, and the socket is a latha:proc channel.
+//
+// usage: requestserver-ipc [--spawn RequestServer.wasm] [-C ca-bundle] [-o FILE] URL...
+//        prints "<url> <http code> <bytes> <network error>" for each URL.
+
+#include <AK/Vector.h>
+#include <LibCore/ArgsParser.h>
+#include <LibCore/EventLoop.h>
+#include <LibCore/File.h>
+#include <LibHTTP/Cache/DiskCache.h>
+#include <LibHTTP/HeaderList.h>
+#include <LibIPC/ConnectionFromClient.h>
+#include <LibIPC/Transport.h>
+#include <LibMain/Main.h>
+#include <LibRequests/Request.h>
+#include <LibRequests/RequestClient.h>
+#include <LibRequests/RequestControlClient.h>
+#include <LibURL/Parser.h>
+#include <RequestServer/CURL.h>
+#include <RequestServer/ConnectionFromClient.h>
+#include <RequestServer/ControlConnectionFromClient.h>
+#include <RequestServer/Resolver.h>
+#include <RequestServer/ResourceSubstitutionMap.h>
+#include <webby_wasi_local.h>
+
+namespace RequestServer {
+
+// Defined by RequestServer's main.cpp, which this program takes the place of.
+OwnPtr<ResourceSubstitutionMap> g_resource_substitution_map;
+
+}
+
+ErrorOr<int> ladybird_main(Main::Arguments arguments)
+{
+    Vector<StringView> urls;
+    StringView spawn_path;
+    StringView certificate;
+    StringView output_path;
+    Core::ArgsParser args_parser;
+    args_parser.add_option(spawn_path, "Run RequestServer as this wasm program in a child instance (latha:proc)", "spawn", 0, "path");
+    args_parser.add_option(certificate, "Path to a CA bundle", "certificate", 'C', "file");
+    args_parser.add_option(output_path, "Write the first URL's body here", "output", 'o', "file");
+    args_parser.add_positional_argument(urls, "URLs to fetch", "url");
+    args_parser.parse(arguments);
+
+    Core::EventLoop event_loop;
+
+    // RequestServer's side, when it is in this module.
+    RequestServer::ConnectionFromClient::ConnectionMap connections;
+    RequestServer::ConnectionFromClient::RequestTransferLeaseMap request_transfer_leases;
+    Optional<HTTP::DiskCache> disk_cache;
+    RefPtr<RequestServer::ControlConnectionFromClient> server;
+
+    NonnullOwnPtr<IPC::Transport> control_transport = TRY([&]() -> ErrorOr<NonnullOwnPtr<IPC::Transport>> {
+        if (!spawn_path.is_empty()) {
+            Vector<ByteString> child_arguments { "RequestServer", "--disable-sandbox", "--http-disk-cache-mode=disabled" };
+            if (!certificate.is_empty())
+                child_arguments.append(ByteString::formatted("--certificate={}", certificate));
+            Vector<char*> argv;
+            for (auto& argument : child_arguments)
+                argv.append(const_cast<char*>(argument.characters()));
+            argv.append(nullptr);
+            auto path = ByteString { spawn_path };
+            u32 pid = 0;
+            int fd = -1;
+            if (webby_local_spawn(path.characters(), argv.data(), &pid, &fd) < 0)
+                return Error::from_syscall("webby_local_spawn"sv, errno);
+            outln("requestserver-ipc: RequestServer is process {}", pid);
+            return TRY(IPC::Transport::adopt_fd(fd));
+        }
+
+        if (!certificate.is_empty())
+            RequestServer::set_default_certificate_path(certificate);
+        TRY(RequestServer::initialize_libcurl());
+        auto [local, remote_handle] = TRY(IPC::Transport::create_paired());
+        server = IPC::new_client_connection<RequestServer::ControlConnectionFromClient>(
+            TRY(remote_handle.create_transport()), connections, request_transfer_leases, disk_cache);
+        return move(local);
+    }());
+
+    auto control = adopt_ref(*new Requests::RequestControlClient(move(control_transport)));
+    control->on_request_server_died = [] {
+        warnln("requestserver-ipc: RequestServer went away");
+        Core::EventLoop::current().quit(3);
+    };
+
+    // A synchronous request: the answer only comes once RequestServer's side has run.
+    auto response = control->send_sync_but_allow_failure<Messages::RequestServerControl::ConnectNewClient>(RequestServer::IsPrivate::No, RequestServer::SiteBinding::Unrestricted);
+    if (!response || response->client_id() < 0)
+        return Error::from_string_literal("connect_new_client failed");
+    auto client_id = response->client_id();
+    auto client = make_ref_counted<Requests::RequestClient>(TRY(response->take_handle().create_transport()), client_id);
+    outln("requestserver-ipc: RequestClient {} connected", client_id);
+
+    size_t remaining = urls.size();
+    int failures = 0;
+    Vector<RefPtr<Requests::Request>> requests;
+    Optional<Core::ImmutableBytes> first_body;
+    for (size_t i = 0; i < urls.size(); ++i) {
+        auto url_string = urls[i];
+        auto url = URL::Parser::basic_parse(url_string);
+        if (!url.has_value()) {
+            warnln("{}: not a URL", url_string);
+            return 2;
+        }
+        auto request = client->start_request("GET"sv, *url);
+        if (!request) {
+            warnln("{}: start_request failed", url_string);
+            return 1;
+        }
+        request->set_buffered_request_finished_callback(
+            [&, url_string, i](u64 total_size, Requests::RequestTimingInfo const&, Optional<Requests::NetworkError> const& network_error,
+                NonnullRefPtr<HTTP::HeaderList>, Optional<u32> response_code, Optional<String>, Optional<Core::ImmutableBytes>,
+                Optional<u64>, Requests::CacheState, Core::ImmutableBytes payload) {
+                outln("{} {} {} {}", url_string, response_code.value_or(0), payload.size(),
+                    network_error.has_value() ? Requests::network_error_to_string(*network_error) : "none"sv);
+                (void)total_size;
+                if (network_error.has_value() || !response_code.has_value())
+                    ++failures;
+                if (i == 0)
+                    first_body = payload;
+                if (--remaining == 0)
+                    Core::EventLoop::current().quit(failures ? 1 : 0);
+            });
+        requests.append(move(request));
+    }
+
+    auto result = event_loop.exec();
+    if (!output_path.is_empty() && first_body.has_value()) {
+        auto file = TRY(Core::File::open(output_path, Core::File::OpenMode::Write | Core::File::OpenMode::Truncate));
+        TRY(file->write_until_depleted(first_body->bytes()));
+    }
+    requests.clear();
+    client->shutdown();
+    control->shutdown();
+    return result;
+}
