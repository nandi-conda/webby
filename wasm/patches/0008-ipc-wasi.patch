+#if defined(AK_OS_WASI)
+
+// A WASI instance has one thread. So, the socket is read when this thread's event loop sees it readable, written
+// right away when a message is posted (and on the event loop when it is writable again), and the waits (flush(),
+// wait_until_readable()) poll the socket themselves. The socket is one of compat/webby_wasi_local.c's: in this
+// instance's memory, or a latha:proc channel to another instance.
+TransportSocket::TransportSocket(NonnullOwnPtr<Core::LocalSocket> socket)
+    : m_socket(move(socket))
+{
+    m_socket->set_notifications_enabled(false);
+    m_send_queue = adopt_ref(*new SendQueue);
+
+    auto fd = m_socket->fd().value();
+    m_socket_read_notifier = Core::Notifier::construct(fd, Core::NotificationType::Read);
+    m_socket_read_notifier->on_activation = [this] { on_socket_readable(); };
+    m_socket_write_notifier = Core::Notifier::construct(fd, Core::NotificationType::Write);
+    m_socket_write_notifier->set_enabled(false);
+    m_socket_write_notifier->on_activation = [this] {
+        if (send_pending_messages() != SendResult::Pending)
+            m_socket_write_notifier->set_enabled(false);
+    };
+}
+
+TransportSocket::~TransportSocket()
+{
+    m_alive->alive = false;
+    if (m_socket_read_notifier)
+        m_socket_read_notifier->set_enabled(false);
+    if (m_socket_write_notifier)
+        m_socket_write_notifier->set_enabled(false);
+    m_socket_read_notifier.clear();
+    m_socket_write_notifier.clear();
+    m_read_hook_notifier.clear();
+}
+
+void TransportSocket::notify_read_available()
+{
+}
+
+void TransportSocket::socket_stopped()
+{
+    m_io_thread_state = IOThreadState::Stopped;
+    m_send_queue->release_drain_waiters();
+    if (m_socket_read_notifier)
+        m_socket_read_notifier->set_enabled(false);
+    if (m_socket_write_notifier)
+        m_socket_write_notifier->set_enabled(false);
+    MutexLocker locker(m_incoming_mutex);
+    m_incoming_eof = true;
+    m_receive_loop_finished = true;
+}
+
+void TransportSocket::on_socket_readable()
+{
+    if (m_io_thread_state != IOThreadState::Running)
+        return;
+    while (read_incoming_messages() == MoreToRead::Yes) { }
+    if (m_peer_eof)
+        socket_stopped();
+    // NB: A wait_until_readable() further up the stack takes the messages itself. Calling the hook here would hand them
+    //     to the connection, which only keeps the ones for its own endpoint: the response being waited for would be lost.
+    if (m_in_wait)
+        return;
+    bool have_messages;
+    {
+        MutexLocker locker(m_incoming_mutex);
+        have_messages = !m_incoming_messages.is_empty() || m_incoming_eof;
+    }
+    if (have_messages && m_on_read_hook)
+        m_on_read_hook();
+}
+
+TransportSocket::SendResult TransportSocket::send_pending_messages()
+{
+    for (;;) {
+        if (m_io_thread_state == IOThreadState::Stopped)
+            return SendResult::Closed;
+        // NB: Big batches, as one write to a latha:proc channel is one message to the host.
+        auto [bytes, fds] = m_send_queue->peek(MAX_INLINE_PAYLOAD_SIZE + sizeof(SocketMessageHeader));
+        if (bytes.is_empty() && fds.is_empty())
+            return SendResult::Drained;
+        ReadonlyBytes remaining = bytes;
+        if (transfer_data(remaining, fds) == TransferState::SocketClosed) {
+            socket_stopped();
+            return SendResult::Closed;
+        }
+        if (remaining.size() == bytes.size())
+            return SendResult::Pending;
+    }
+}
+
+void TransportSocket::wait_for_socket(short events)
+{
+    struct pollfd pollfd = { .fd = m_socket->fd().value(), .events = events, .revents = 0 };
+    Array<struct pollfd, 1> pollfds { pollfd };
+    // NB: A peer in this instance's memory can only answer once this thread lets it run. So, run the event loop for
+    //     one round instead of blocking here; that also delivers the answer, as our own notifier reads it.
+    if (webby_local_peer_in_memory(pollfd.fd)) {
+        if (Core::System::poll(pollfds, 0).value_or(0) == 0)
+            Core::EventLoop::current().pump(Core::EventLoop::WaitMode::WaitForEvents);
+        return;
+    }
+    ErrorOr<int> result { 0 };
+    do {
+        result = Core::System::poll(pollfds, -1);
+    } while (result.is_error() && result.error().code() == EINTR);
+}
+
+void TransportSocket::set_up_read_hook(Function<void()> hook)
+{
+    m_on_read_hook = move(hook);
+    bool have_messages;
+    {
+        MutexLocker locker(m_incoming_mutex);
+        have_messages = !m_incoming_messages.is_empty();
+    }
+    if (have_messages) {
+        Core::deferred_invoke([this, alive = m_alive] {
+            if (alive->alive && m_on_read_hook)
+                m_on_read_hook();
+        });
+    }
+}
+
+bool TransportSocket::is_open() const
+{
+    return m_socket_is_open.load(AK::MemoryOrder::memory_order_relaxed);
+}
+
+void TransportSocket::close()
+{
+    m_socket_is_open.store(false, AK::MemoryOrder::memory_order_relaxed);
+    socket_stopped();
+    m_socket->close();
+}
+
+void TransportSocket::close_after_sending_all_pending_messages()
+{
+    flush();
+    close();
+}
+
+void TransportSocket::flush()
+{
+    while (m_socket_is_open.load(AK::MemoryOrder::memory_order_relaxed) && send_pending_messages() == SendResult::Pending)
+        wait_for_socket(POLLOUT);
+}
+
+void TransportSocket::wait_until_incoming_is_current()
+{
+    if (m_io_thread_state != IOThreadState::Running)
+        return;
+    while (read_incoming_messages() == MoreToRead::Yes) { }
+    if (m_peer_eof)
+        socket_stopped();
+}
+
+void TransportSocket::wait_until_readable()
+{
+    TemporaryChange in_wait { m_in_wait, true };
+    for (;;) {
+        {
+            MutexLocker locker(m_incoming_mutex);
+            if (!m_incoming_messages.is_empty())
+                return;
+        }
+        if (m_io_thread_state != IOThreadState::Running)
+            return;
+        wait_until_incoming_is_current();
+        {
+            MutexLocker locker(m_incoming_mutex);
+            if (!m_incoming_messages.is_empty() || m_io_thread_state != IOThreadState::Running)
+                return;
+        }
+        wait_for_socket(POLLIN);
+    }
+}
+
+ErrorOr<TransportHandle> TransportSocket::release_for_transfer()
+{
+    m_is_being_transferred.store(true, AK::MemoryOrder::memory_order_release);
+    flush();
+    m_socket_is_open.store(false, AK::MemoryOrder::memory_order_relaxed);
+    m_io_thread_state = IOThreadState::Stopped;
+    if (m_socket_read_notifier)
+        m_socket_read_notifier->set_enabled(false);
+    if (m_socket_write_notifier)
+        m_socket_write_notifier->set_enabled(false);
+    auto fd = TRY(m_socket->release_fd());
+    return TransportHandle { File::adopt_fd(fd) };
+}
 
+#endif
 }
