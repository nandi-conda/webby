+ErrorOr<NonnullRefPtr<ConfigFile>> ConfigFile::open_from_text(ByteString const& filename, StringView text)
+{
+    auto config_file = TRY(adopt_nonnull_ref_or_enomem(new (nothrow) ConfigFile(filename, nullptr)));
+    HashMap<ByteString, ByteString>* current_group = nullptr;
+    text.for_each_split_view('\n', SplitBehavior::KeepEmpty, [&](StringView line) {
+        config_file->parse_line(line, current_group);
+    });
+    return config_file;
+}
