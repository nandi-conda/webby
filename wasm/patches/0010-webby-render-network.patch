+// RequestServer, reached the way WebContent reaches it: a control connection, then connect_new_client() over it for
+// the RequestClient that LibWeb's ResourceLoader uses.
+struct RequestServerConnection {
+    // RequestServer's side, when it runs in this module.
+    RequestServer::ConnectionFromClient::ConnectionMap connections;
+    RequestServer::ConnectionFromClient::RequestTransferLeaseMap request_transfer_leases;
+    Optional<HTTP::DiskCache> disk_cache;
+    RefPtr<RequestServer::ControlConnectionFromClient> server;
+
+    RefPtr<Requests::RequestControlClient> control;
+    RefPtr<Requests::RequestClient> client;
+};
+
+ErrorOr<NonnullOwnPtr<RequestServerConnection>> connect_to_request_server(StringView spawn_path, StringView certificate)
+{
+    auto connection = make<RequestServerConnection>();
+    NonnullOwnPtr<IPC::Transport> control_transport = TRY([&]() -> ErrorOr<NonnullOwnPtr<IPC::Transport>> {
+        if (!spawn_path.is_empty()) {
+            Vector<ByteString> child_arguments { "RequestServer", "--disable-sandbox", "--http-disk-cache-mode=disabled" };
+            if (!certificate.is_empty())
+                child_arguments.append(ByteString::formatted("--certificate={}", certificate));
+            Vector<char*> argv;
+            for (auto& argument : child_arguments)
+                argv.append(const_cast<char*>(argument.characters()));
+            argv.append(nullptr);
+            auto path = ByteString { spawn_path };
+            u32 pid = 0;
+            int fd = -1;
+            if (webby_local_spawn(path.characters(), argv.data(), &pid, &fd) < 0)
+                return Error::from_syscall("webby_local_spawn"sv, errno);
+            warnln("webby-render: RequestServer is process {}", pid);
+            return TRY(IPC::Transport::adopt_fd(fd));
+        }
+
+        if (!certificate.is_empty())
+            RequestServer::set_default_certificate_path(certificate);
+        TRY(RequestServer::initialize_libcurl());
+        auto [local, remote_handle] = TRY(IPC::Transport::create_paired());
+        connection->server = IPC::new_client_connection<RequestServer::ControlConnectionFromClient>(
+            TRY(remote_handle.create_transport()), connection->connections, connection->request_transfer_leases, connection->disk_cache);
+        return move(local);
+    }());
+
+    connection->control = adopt_ref(*new Requests::RequestControlClient(move(control_transport)));
+    connection->control->on_request_server_died = [] {
+        warnln("webby-render: RequestServer went away");
+        Core::EventLoop::current().quit(3);
+    };
+
+    // A synchronous request: the answer only comes once RequestServer's side has run.
+    auto response = connection->control->send_sync_but_allow_failure<Messages::RequestServerControl::ConnectNewClient>(RequestServer::IsPrivate::No, RequestServer::SiteBinding::Unrestricted);
+    if (!response || response->client_id() < 0)
+        return Error::from_string_literal("RequestServer's connect_new_client failed");
+    auto client_id = response->client_id();
+    connection->client = TRY(try_make_ref_counted<Requests::RequestClient>(TRY(response->take_handle().create_transport()), client_id));
+    return connection;
+}
+
+struct FetchedDocument {
+    URL::URL url;
+    ByteBuffer body;
+    Optional<ByteString> content_type;
+};
+
+// The document itself, fetched straight from RequestServer (redirects followed here, as Fetch would) rather than by a
+// navigation: like a file, its bytes are then parsed into a document made directly.
+ErrorOr<FetchedDocument> fetch_document(Core::EventLoop& event_loop, Requests::RequestClient& client, URL::URL url)
+{
+    for (int redirects = 0; redirects <= 20; ++redirects) {
+        auto headers = HTTP::HeaderList::create();
+        headers->append(HTTP::Header::isomorphic_encode("User-Agent"sv, Web::default_user_agent));
+        headers->append(HTTP::Header::isomorphic_encode("Accept"sv, "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"sv));
+        headers->append(HTTP::Header::isomorphic_encode("Accept-Language"sv, "en-US,en;q=0.9"sv));
+        auto request = client.start_request("GET"sv, url, *headers);
+        if (!request)
+            return Error::from_string_literal("RequestServer did not start the request");
+
+        bool done = false;
+        Optional<Requests::NetworkError> error;
+        Optional<u32> status;
+        RefPtr<HTTP::HeaderList> response_headers;
+        ByteBuffer body;
+        request->set_buffered_request_finished_callback(
+            [&](u64, Requests::RequestTimingInfo const&, Optional<Requests::NetworkError> const& network_error,
+                NonnullRefPtr<HTTP::HeaderList> headers, Optional<u32> response_code, Optional<String>, Optional<Core::ImmutableBytes>,
+                Optional<u64>, Requests::CacheState, Core::ImmutableBytes payload) {
+                error = network_error;
+                status = response_code;
+                response_headers = move(headers);
+                body = MUST(ByteBuffer::copy(payload.bytes()));
+                done = true;
+            });
+        event_loop.spin_until([&] { return done; });
+
+        if (error.has_value())
+            return Error::from_string_view(Requests::network_error_to_string(*error));
+        if (!status.has_value())
+            return Error::from_string_literal("No HTTP status");
+        warnln("webby-render: {} {} ({} bytes)", url, *status, body.size());
+        if (*status >= 300 && *status < 400 && *status != 304) {
+            auto location = response_headers->get("Location"sv);
+            if (!location.has_value())
+                return Error::from_string_literal("A redirect without a Location");
+            auto next = URL::Parser::basic_parse(*location, url);
+            if (!next.has_value())
+                return Error::from_string_literal("A redirect to something that is not a URL");
+            url = next.release_value();
+            continue;
+        }
+        return FetchedDocument { move(url), move(body), response_headers->get("Content-Type"sv) };
+    }
+    return Error::from_string_literal("Too many redirects");
+}
