+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// webby-render: lays out and paints one HTML file into a PNG, all inside one process, with no WebContent, Compositor,
+// RequestServer or ImageDecoder. This is what the WebAssembly build of webby runs: the page lives in this module's
+// LibWeb, and its display list is rasterized on the CPU by the Compositor's Skia player linked in beside it.
+
+#include <AK/LexicalPath.h>
+#include <Compositor/RasterizeDisplayList.h>
+#include <LibCompositing/DisplayList/DisplayListResourceStorage.h>
+#include <LibCore/ArgsParser.h>
+#include <LibCore/EventLoop.h>
+#include <LibCore/File.h>
+#include <LibCore/Timer.h>
+#include <LibFileSystem/FileSystem.h>
+#include <LibGfx/Bitmap.h>
+#include <LibGfx/ImageFormats/PNGWriter.h>
+#include <LibGfx/Palette.h>
+#include <LibGfx/SystemTheme.h>
+#include <LibMain/Main.h>
+#include <LibURL/Parser.h>
+#include <LibWeb/Bindings/MainThreadVM.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/DOM/DocumentObserver.h>
+#include <LibWeb/HTML/LocalTraversableNavigable.h>
+#include <LibWeb/HTML/Parser/HTMLParser.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Layout/RenderDocument.h>
+#include <LibWeb/Loader/ResourceLoader.h>
+#include <LibWeb/Page/Page.h>
+#include <LibWeb/Painting/DocumentPaintState.h>
+#include <LibWeb/Platform/EventLoopPlugin.h>
+#include <LibWeb/Platform/FontPlugin.h>
+
+namespace {
+
+class HeadlessPageClient final : public Web::PageClient {
+    GC_CELL(HeadlessPageClient, Web::PageClient);
+    GC_DECLARE_ALLOCATOR(HeadlessPageClient);
+
+public:
+    static GC::Ref<HeadlessPageClient> create(Gfx::IntSize viewport, NonnullRefPtr<Gfx::PaletteImpl> palette_impl)
+    {
+        return GC::Heap::the().allocate<HeadlessPageClient>(viewport, move(palette_impl));
+    }
+
+    void set_page(Web::Page& page) { m_page = &page; }
+
+    virtual Web::PageId id() const override { return 1; }
+    virtual Web::Page& page() override { return *m_page; }
+    virtual Web::Page const& page() const override { return *m_page; }
+    virtual bool is_connection_open() const override { return false; }
+    virtual Gfx::Palette palette() const override { return Gfx::Palette { *m_palette_impl }; }
+    virtual Web::DevicePixelRect screen_rect() const override { return { { 0, 0 }, m_viewport.to_type<Web::DevicePixels>() }; }
+    virtual double zoom_level() const override { return 1.0; }
+    virtual double device_pixel_ratio() const override { return 1.0; }
+    virtual double device_pixels_per_css_pixel() const override { return 1.0; }
+    virtual Web::CSS::PreferredColorScheme preferred_color_scheme() const override { return Web::CSS::PreferredColorScheme::Light; }
+    virtual Web::CSS::PreferredContrast preferred_contrast() const override { return Web::CSS::PreferredContrast::NoPreference; }
+    virtual Web::CSS::PreferredMotion preferred_motion() const override { return Web::CSS::PreferredMotion::NoPreference; }
+    virtual size_t screen_count() const override { return 1; }
+    virtual Queue<Web::QueuedInputEvent>& input_event_queue() override { return m_input_event_queue; }
+    virtual void report_finished_handling_input_event(Web::PageId, u64, Web::EventResult) override { }
+    // Frames are painted once, when the page has loaded, by main() below.
+    virtual void request_frame() override { }
+    virtual void request_file(Web::FileRequest) override { }
+    virtual bool is_headless() const override { return true; }
+
+private:
+    HeadlessPageClient(Gfx::IntSize viewport, NonnullRefPtr<Gfx::PaletteImpl> palette_impl)
+        : m_viewport(viewport)
+        , m_palette_impl(move(palette_impl))
+    {
+    }
+
+    virtual void visit_edges(Visitor& visitor) override
+    {
+        Base::visit_edges(visitor);
+        visitor.visit(m_page);
+    }
+
+    GC::Ptr<Web::Page> m_page;
+    Gfx::IntSize m_viewport;
+    NonnullRefPtr<Gfx::PaletteImpl> m_palette_impl;
+    Queue<Web::QueuedInputEvent> m_input_event_queue;
+};
+
+GC_DEFINE_ALLOCATOR(HeadlessPageClient);
+
+ErrorOr<NonnullRefPtr<Gfx::Bitmap>> paint(Web::DOM::Document& document, Gfx::IntSize size)
+{
+    auto& navigable = *document.navigable();
+    auto& resource_storage = navigable.display_list_resource_storage();
+    navigable.set_viewport_size(size.to_type<Web::CSSPixels>());
+
+    Web::Layout::ForcedReadScope read { document };
+    document.update_layout(Web::DOM::UpdateLayoutReason::SVGDecodedImageDataRender);
+    auto display_list = document.record_display_list(read, {}, resource_storage, Web::Painting::PaintCommandCacheMode::ReadWrite);
+    if (!display_list)
+        return Error::from_string_literal("The document recorded no display list");
+
+    auto visual_context_tree = document.paint_state().visual_context_tree(document);
+    auto transaction = TRY(resource_storage.create_self_contained_transaction(*display_list, visual_context_tree));
+
+    auto bitmap = TRY(Gfx::Bitmap::create(Gfx::BitmapFormat::BGRA8888, Gfx::AlphaType::Premultiplied, size));
+    TRY(Compositor::rasterize_display_list(*display_list, visual_context_tree, move(transaction), *bitmap));
+    return bitmap;
+}
+
+}
+
+ErrorOr<int> ladybird_main(Main::Arguments arguments)
+{
+    StringView input_path;
+    StringView output_path = "out.png"sv;
+    int width = 800;
+    int height = 600;
+    int wait_ms = 0;
+    StringView theme_path = "Base/res/themes/Default.ini"sv;
+
+    Core::ArgsParser args_parser;
+    args_parser.set_general_help("Render an HTML file to a PNG, in one process.");
+    args_parser.add_option(output_path, "PNG to write (default out.png)", "output", 'o', "path");
+    args_parser.add_option(width, "Viewport width in CSS pixels (default 800)", "width", 'w', "pixels");
+    args_parser.add_option(height, "Viewport height in CSS pixels (default 600)", "height", 'h', "pixels");
+    args_parser.add_option(wait_ms, "Run the event loop this long after loading, for timers and late resources", "wait", 0, "ms");
+    args_parser.add_option(theme_path, "System theme for the palette (default Base/res/themes/Default.ini)", "theme", 0, "path");
+    args_parser.add_positional_argument(input_path, "HTML file to render", "file");
+    args_parser.parse(arguments);
+
+    Core::EventLoop event_loop;
+    Web::Platform::EventLoopPlugin::install(*new Web::Platform::EventLoopPlugin);
+    Web::Bindings::initialize_main_thread_vm(Web::HTML::AgentType::SimilarOriginWindow);
+    auto& heap = Web::Bindings::main_thread_vm().heap();
+    // file: and data: URLs load inside this process; nothing here makes network requests yet.
+    Web::ResourceLoader::initialize(heap);
+    Web::Platform::FontPlugin::install(*new Web::Platform::FontPlugin(false));
+
+    auto absolute_path = TRY(FileSystem::absolute_path(input_path));
+    auto url = URL::create_with_file_scheme(absolute_path).release_value();
+    auto file = TRY(Core::File::open(input_path, Core::File::OpenMode::Read));
+    auto html = TRY(file->read_until_eof());
+
+    Gfx::IntSize viewport { width, height };
+    auto theme = TRY(Gfx::load_system_theme(ByteString { theme_path }));
+    auto page_client = HeadlessPageClient::create(viewport, Gfx::PaletteImpl::create_with_anonymous_buffer(theme));
+    auto page = Web::Page::create(*page_client);
+    page_client->set_page(*page);
+    page->set_top_level_traversable(Web::HTML::LocalTraversableNavigable::create_a_new_top_level_traversable(page, nullptr, {}));
+    auto& navigable = *page->local_traversable();
+    auto& window = *navigable.active_window();
+
+    // The document a navigation would have made, made directly: its bytes are parsed here, in this process, and it
+    // takes the place of the initial about:blank document, as SVGDecodedImageData's documents do.
+    auto document = Web::DOM::Document::create(*page, window, url);
+    document->set_document_type(Web::DOM::Document::Type::HTML);
+    document->set_content_type("text/html"_utf16_fly_string);
+    document->set_browsing_context(navigable.active_browsing_context());
+    document->set_window(window);
+    window.set_associated_document(*document);
+    navigable.set_active_document(*document);
+
+    bool loaded = false;
+    auto observer = Web::DOM::DocumentObserver::create(*document);
+    observer->set_document_completely_loaded([&] { loaded = true; });
+
+    auto parser = Web::HTML::HTMLParser::create_from_byte_string(*document, StringView { html }, Web::HTML::ParserScriptingMode::Normal, "UTF-8"sv);
+    parser->run(url);
+
+    event_loop.spin_until([&] { return loaded; });
+    if (wait_ms > 0) {
+        bool waited = false;
+        auto timer = Core::Timer::create_single_shot(AK::Duration::from_milliseconds(wait_ms), [&] { waited = true; });
+        timer->start();
+        event_loop.spin_until([&] { return waited; });
+    }
+
+    auto bitmap = TRY(paint(*document, viewport));
+    auto png = TRY(Gfx::PNGWriter::encode(*bitmap));
+    auto output = TRY(Core::File::open(output_path, Core::File::OpenMode::Write));
+    TRY(output->write_until_depleted(png));
+    outln("{}: {}x{} -> {}", input_path, width, height, output_path);
+    return 0;
+}
