+RefPtr<Gfx::Font> PathFontProvider::get_font_for_code_point(u32 code_point, float point_size, u16 weight, u16 width, u8 slope, bool)
+{
+    // Ties go to the family that sorts first, so the same code point always picks the same face.
+    RefPtr<Typeface> best;
+    u32 best_score = NumericLimits<u32>::max();
+    for (auto const& [family, typefaces] : m_typeface_by_family) {
+        for (auto const& typeface : typefaces) {
+            if (typeface->glyph_id_for_code_point(code_point) == 0)
+                continue;
+            u32 score = (typeface->slope() == slope ? 0 : 100000)
+                + (typeface->width() == width ? 0 : 10000)
+                + (typeface->weight() > weight ? typeface->weight() - weight : weight - typeface->weight());
+            if (score < best_score || (score == best_score && best && typeface->family().bytes_as_string_view() < best->family().bytes_as_string_view())) {
+                best = typeface;
+                best_score = score;
+            }
+        }
+    }
+    if (!best)
+        return SystemFontProvider::get_font_for_code_point(code_point, point_size, weight, width, slope, false);
+    return best->font(point_size, {});
+}
+
 }
