diff --git a/Meta/CMake/check_for_dependencies_wasi.cmake b/Meta/CMake/check_for_dependencies_wasi.cmake
new file mode 100644
index 00000000..91931745
--- /dev/null
+++ b/Meta/CMake/check_for_dependencies_wasi.cmake
@@ -0,0 +1,31 @@
+# Dependencies of a WebAssembly build (wasm32-wasip1, webby's wasm/ directory). Only what the libraries built for WASI
+# use; each comes from the sysroot webby builds for it (CMAKE_PREFIX_PATH).
+include_guard()
+
+find_package(PkgConfig)
+find_package(mimalloc CONFIG REQUIRED)
+find_package(FastFloat CONFIG REQUIRED)
+find_package(simdutf REQUIRED)
+find_package(zmij CONFIG REQUIRED)
+find_package(ICU 78.3 EXACT REQUIRED COMPONENTS data i18n uc)
+find_package(OpenSSL REQUIRED)
+find_package(Python3 REQUIRED COMPONENTS Interpreter)
+find_package(Git)
+
+find_path(LIBTOMMATH_INCLUDE_DIR tommath.h REQUIRED)
+find_library(LIBTOMMATH_LIBRARY tommath REQUIRED)
+add_library(PkgConfig::libtommath INTERFACE IMPORTED)
+target_include_directories(PkgConfig::libtommath INTERFACE "${LIBTOMMATH_INCLUDE_DIR}")
+target_link_libraries(PkgConfig::libtommath INTERFACE "${LIBTOMMATH_LIBRARY}")
+
+set(HAS_FONTCONFIG OFF CACHE BOOL "" FORCE)
+set(HAS_VULKAN OFF CACHE BOOL "" FORCE)
+set(USE_VULKAN_DMABUF_IMAGES OFF CACHE BOOL "" FORCE)
+set(HAS_DIRECTX OFF CACHE BOOL "" FORCE)
+
+pkg_check_modules(LIBPSL REQUIRED IMPORTED_TARGET libpsl)
+
+# wasi-libc's pthreads are stubs for a single-threaded module and need no library.
+if (NOT TARGET Threads::Threads)
+    add_library(Threads::Threads INTERFACE IMPORTED)
+endif()
