diff --git a/AK/Types.h b/AK/Types.h
index 104679f1..546c853e 100644
--- a/AK/Types.h
+++ b/AK/Types.h
@@ -17,8 +17,101 @@ using i32 = __INT32_TYPE__;
 using i16 = __INT16_TYPE__;
 using i8 = __INT8_TYPE__;
 
+#if defined(__wasi__)
+// WebAssembly has no _Float16 (clang refuses it for wasm32), so f16 is a binary16 value that computes in float.
+namespace AK::Detail {
+struct SoftFloat16 {
+    __UINT16_TYPE__ bits { 0 };
+
+    constexpr SoftFloat16() = default;
+    constexpr SoftFloat16(float value)
+        : bits(from_float(value))
+    {
+    }
+    constexpr SoftFloat16(double value)
+        : bits(from_float(static_cast<float>(value)))
+    {
+    }
+    constexpr SoftFloat16(int value)
+        : bits(from_float(static_cast<float>(value)))
+    {
+    }
+    static constexpr SoftFloat16 from_bits(__UINT16_TYPE__ bits)
+    {
+        SoftFloat16 value;
+        value.bits = bits;
+        return value;
+    }
+    constexpr operator float() const { return to_float(bits); }
+    constexpr explicit operator double() const { return to_float(bits); }
+
+    constexpr SoftFloat16 operator-() const { return from_bits(bits ^ 0x8000); }
+    friend constexpr SoftFloat16 operator+(SoftFloat16 a, SoftFloat16 b) { return float(a) + float(b); }
+    friend constexpr SoftFloat16 operator-(SoftFloat16 a, SoftFloat16 b) { return float(a) - float(b); }
+    friend constexpr SoftFloat16 operator*(SoftFloat16 a, SoftFloat16 b) { return float(a) * float(b); }
+    friend constexpr SoftFloat16 operator/(SoftFloat16 a, SoftFloat16 b) { return float(a) / float(b); }
+
+    static constexpr float to_float(__UINT16_TYPE__ h)
+    {
+        __UINT32_TYPE__ sign = (h & 0x8000u) << 16;
+        __UINT32_TYPE__ exponent = (h >> 10) & 0x1f;
+        __UINT32_TYPE__ mantissa = h & 0x3ff;
+        __UINT32_TYPE__ f;
+        if (exponent == 0x1f) {
+            f = sign | 0x7f800000u | (mantissa << 13);
+        } else if (exponent != 0) {
+            f = sign | ((exponent + 112) << 23) | (mantissa << 13);
+        } else if (mantissa == 0) {
+            f = sign;
+        } else {
+            exponent = 113;
+            while (!(mantissa & 0x400)) {
+                mantissa <<= 1;
+                --exponent;
+            }
+            f = sign | (exponent << 23) | ((mantissa & 0x3ff) << 13);
+        }
+        return __builtin_bit_cast(float, f);
+    }
+
+    // Rounds to nearest, ties to even, as a hardware conversion does.
+    static constexpr __UINT16_TYPE__ from_float(float value)
+    {
+        __UINT32_TYPE__ f = __builtin_bit_cast(__UINT32_TYPE__, value);
+        __UINT32_TYPE__ sign = (f >> 16) & 0x8000;
+        __UINT32_TYPE__ exponent = (f >> 23) & 0xff;
+        __UINT32_TYPE__ mantissa = f & 0x7fffff;
+        if (exponent == 0xff)
+            return sign | 0x7c00 | (mantissa ? 0x200 | (mantissa >> 13) : 0);
+        __INT32_TYPE__ e = __INT32_TYPE__(exponent) - 127 + 15;
+        if (e >= 0x1f)
+            return sign | 0x7c00;
+        if (e <= 0) {
+            if (e < -10)
+                return sign;
+            mantissa |= 0x800000;
+            __UINT32_TYPE__ shift = 14 - e;
+            __UINT32_TYPE__ half = mantissa >> shift;
+            __UINT32_TYPE__ rest = mantissa & ((1u << shift) - 1);
+            __UINT32_TYPE__ midpoint = 1u << (shift - 1);
+            if (rest > midpoint || (rest == midpoint && (half & 1)))
+                ++half;
+            return sign | half;
+        }
+        __UINT32_TYPE__ half = (__UINT32_TYPE__(e) << 10) | (mantissa >> 13);
+        __UINT32_TYPE__ rest = mantissa & 0x1fff;
+        if (rest > 0x1000 || (rest == 0x1000 && (half & 1)))
+            ++half; // may carry into the exponent, up to infinity, which is right
+        return sign | half;
+    }
+};
+}
+using f16 = AK::Detail::SoftFloat16;
+#    define AK_HAS_SOFT_FLOAT16 1
+#else
 using f16 = _Float16;
 static_assert(__FLT16_MANT_DIG__ == 11 && __FLT16_MAX_EXP__ == 16);
+#endif
 
 using f32 = float;
 static_assert(__FLT_MANT_DIG__ == 24 && __FLT_MAX_EXP__ == 128);
