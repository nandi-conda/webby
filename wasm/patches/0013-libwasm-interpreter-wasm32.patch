+        SubtractFloat32 => format!("f32_bits(f32({}) - f32({}))", read(0)?, read(1)?),
+        MultiplyFloat32 => format!("f32_bits(f32({}) * f32({}))", read(0)?, read(1)?),
+        DivideFloat32 => format!("f32_bits(f32({}) / f32({}))", read(0)?, read(1)?),
+    };
+    assign(value)
+}
+
+/// An atomic access. Sequentially consistent, as the interpreter's other targets make them.
+fn atomic_statement(
+    operation: crate::intrinsic::AtomicOperation,
+    operands: &[Operand],
+    handler: &str,
+) -> Result<String, CompileError> {
+    use crate::intrinsic::AtomicOperationKind;
+    let what = format!("{operation:?}");
+    if operation.kind() == AtomicOperationKind::Fence {
+        return Ok("__atomic_thread_fence(__ATOMIC_SEQ_CST);".to_string());
+    }
+    let ty = unsigned_type(operation.width());
+    let address = memory_operand(operands.get(1), handler)?;
+    let pointer = format!("(volatile {ty}*)(uptr)({address})");
+    let read = |index: usize| read_operand(operand_at(operands, index, &what, handler)?, handler);
+    let destination = operand_at(operands, 0, &what, handler)?;
+    let value = match operation.kind() {
+        AtomicOperationKind::Load => format!("(u64)__atomic_load_n({pointer}, __ATOMIC_SEQ_CST)"),
+        AtomicOperationKind::Exchange => {
+            format!("(u64)__atomic_exchange_n({pointer}, ({ty})({}), __ATOMIC_SEQ_CST)", read(0)?)
+        }
+        AtomicOperationKind::FetchAdd => {
+            format!("(u64)__atomic_fetch_add({pointer}, ({ty})({}), __ATOMIC_SEQ_CST)", read(0)?)
+        }
+        AtomicOperationKind::CompareExchange => {
+            return Ok(format!(
+                "{{ {ty} expected = ({ty})({}); __atomic_compare_exchange_n({pointer}, &expected, ({ty})({}), 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); {} }}",
+                read(0)?,
+                read(2)?,
+                assign_operand(destination, "(u64)expected", handler)?
+            ));
+        }
+        AtomicOperationKind::Fence => unreachable!(),
+    };
+    assign_operand(destination, &value, handler)
+}
+
+/// A vector operation, as a call of the prelude's emulation of the SSE instruction it is on x86-64.
+fn vector_statement(
+    operation: crate::intrinsic::VectorOperation,
+    operands: &[Operand],
+    handler: &str,
+) -> Result<String, CompileError> {
+    use crate::intrinsic::VectorOperationKind;
+    let what = format!("{operation:?}");
+    let read = |index: usize| read_operand(operand_at(operands, index, &what, handler)?, handler);
+    let destination = operand_at(operands, 0, &what, handler)?;
+    let function = format!("flap_{}", operation.name());
+    let value = match operation.kind() {
+        VectorOperationKind::FromU64Pair => format!("flap_v128_from_u64x2({}, {})", read(1)?, read(2)?),
+        VectorOperationKind::Binary => format!("{function}({}, {})", read(0)?, read(1)?),
+        VectorOperationKind::Unary | VectorOperationKind::ToGeneralPurpose | VectorOperationKind::ToGeneralPurpose32 => {
+            format!("{function}({})", read(1)?)
+        }
+    };
+    assign_operand(destination, &value, handler)
+}
+
+/// Print the WebAssembly interpreter. Its handlers keep `ip`, `stp`, `vsp`, `memory_base`, the dispatch table, `sp`
+/// and `fp` in parameters. The frames that the assembly backends build on the machine stack go in a region the entry
+/// function allocates on the C stack instead, the upper half of what the context's stack limit leaves it, so that
+/// the native calls handlers make (the runtime's functions, and through them nested entries) run below the frames.
+/// While it runs, the entry makes the bottom of that region the context's stack limit.
+fn generate_webassembly(
+    program: &low_ir::Program,
+    options: &CompileOptions,
+    constants: &crate::frontend::layout::LayoutConstants,
+) -> Result<String, CompileError> {
+    WEBASSEMBLY.with(|webassembly| webassembly.set(true));
+    let result = generate_webassembly_unit(program, options, constants);
+    WEBASSEMBLY.with(|webassembly| webassembly.set(false));
+    result
+}
+
+fn generate_webassembly_unit(
+    program: &low_ir::Program,
+    options: &CompileOptions,
+    constants: &crate::frontend::layout::LayoutConstants,
+) -> Result<String, CompileError> {
+    let constant = |name: &str| -> Result<i64, CompileError> {
+        constants
+            .get(name)
+            .map(|constant| constant.value())
+            .ok_or_else(|| error(None, format!("the WebAssembly interpreter needs the layout constant '{name}'")))
+    };
+    let mut unit = Unit {
+        runtime: &program.runtime,
+        options,
+        declarations: HashMap::default(),
+        declaration_order: Vec::new(),
+        helpers: String::new(),
+        helper_count: 0,
+    };
+    let mut names = HashMap::default();
+    for handler in &program.handlers {
+        names.insert(handler.id, handler_function_name(&handler.name));
+    }
+    let fallback = program
+        .dispatch
+        .fallback
+        .and_then(|fallback| names.get(&fallback).cloned())
+        .ok_or_else(|| error(None, "the WebAssembly interpreter needs a @fallback handler"))?;
+    let mut bodies = String::new();
+    for handler in &program.handlers {
+        bodies.push_str(&unit.handler(handler, &names[&handler.id])?);
+    }
+
+    let symbol = |suffix: &str| {
+        let prefix = options.profile.symbol_prefix();
+        if suffix.is_empty() {
+            prefix.to_string()
+        } else {
+            format!("{prefix}_{suffix}")
+        }
+    };
+    let mut out = String::new();
+    out.push_str("/* Generated by flapc's C backend -- DO NOT EDIT */\n\n");
+    out.push_str(PRELUDE);
+    out.push_str(WEBASSEMBLY_STATE);
+    out.push_str(VECTOR_PRELUDE);
+    for name in ["ENTRY_CONTEXT", "CONTEXT_STACK_LIMIT"] {
+        w(&mut out, format_args!("#define FLAP_{name} {}\n", literal(constant(name)?)));
+    }
+    out.push('\n');
+    for symbol in &unit.declaration_order {
+        w(&mut out, format_args!("{}\n", unit.declarations[symbol]));
+    }
+    out.push('\n');
+    for handler in &program.handlers {
+        w(&mut out, format_args!("static void {}(FLAP_PARAMETERS);\n", names[&handler.id]));
+    }
+    let dispatch_table = symbol("dispatch_table");
+    w(&mut out, format_args!("extern flap_handler* const {dispatch_table}[{DISPATCH_TABLE_SIZE}];\n"));
+    for table in &program.dispatch.secondary {
+        w(&mut out, format_args!(
+            "static flap_handler* const flap_dispatch_table_{:02x}[{}];\n",
+            table.prefix,
+            crate::SECONDARY_DISPATCH_TABLE_SIZE
+        ));
+    }
+    out.push('\n');
+    out.push_str(&unit.helpers);
+    out.push_str(&bodies);
+
+    let table_entry = |handler: Option<crate::identity::HandlerId>| {
+        handler.and_then(|handler| names.get(&handler)).map_or(fallback.as_str(), String::as_str)
+    };
+    w(&mut out, format_args!("flap_handler* const {dispatch_table}[{DISPATCH_TABLE_SIZE}] = {{\n"));
+    for index in 0..DISPATCH_TABLE_SIZE {
+        w(&mut out, format_args!("    {},\n", table_entry(program.dispatch_handlers.get(index).copied().flatten())));
+    }
+    out.push_str("};\n\n");
+    for table in &program.dispatch.secondary {
+        w(&mut out, format_args!(
+            "static flap_handler* const flap_dispatch_table_{:02x}[{}] = {{\n",
+            table.prefix,
+            crate::SECONDARY_DISPATCH_TABLE_SIZE
+        ));
+        for index in 0..crate::SECONDARY_DISPATCH_TABLE_SIZE {
+            w(&mut out, format_args!("    {},\n", table_entry(table.handlers.get(index).copied().flatten())));
+        }
+        out.push_str("};\n\n");
+    }
+    // The runtime recognizes faults in the interpreter by its code range, which C code has none of: its accesses are
+    // all bounds checked instead.
+    w(&mut out, format_args!("const u8 {} = 0;\n\n", symbol("end")));
+    let entry = symbol("");
+    w(&mut out, format_args!(r#"/* The native stack limit of the outermost entry on this thread, which nested entries split further. */
+static _Thread_local u64 flap_native_stack_limit;
+
+void {entry}(const u8* code, u64 argument)
+{{
+    uptr context = ldptr(argument + FLAP_ENTRY_CONTEXT);
+    u64 context_limit = ld64(context + FLAP_CONTEXT_STACK_LIMIT);
+    u64 outer_native_limit = flap_native_stack_limit;
+    u64 native_limit = outer_native_limit != 0 ? outer_native_limit : context_limit;
+    uptr here = (uptr)__builtin_frame_address(0);
+    uptr size = here > native_limit + 4096 ? ((here - native_limit) / 2) & ~(uptr)15 : 0;
+    /* NB: The frames live in this region, which the native stack's conservative scans see. */
+    u8* region = (u8*)__builtin_alloca(size + 16);
+    u64 bottom = ((uptr)region + 15) & ~(uptr)15;
+    u64 top = bottom + size;
+    flap_native_stack_limit = here > size ? (u64)(here - size) : native_limit;
+    st64(context + FLAP_CONTEXT_STACK_LIMIT, bottom);
+    {dispatch_table}[ld8((uptr)code)]((u64)(uptr)code, 0, argument, 0, (uptr){dispatch_table}, top, top);
+    st64(context + FLAP_CONTEXT_STACK_LIMIT, context_limit);
+    flap_native_stack_limit = outer_native_limit;
+}}
+"#));
+    Ok(out)
+}
+
+const WEBASSEMBLY_STATE: &str = r#"
+#define FLAP_PARAMETERS u64 ip, u64 stp, u64 vsp, u64 mb, uptr dispatch, u64 sp, u64 fp
+#define FLAP_ARGUMENTS ip, stp, vsp, mb, dispatch, sp, fp
+typedef void flap_handler(FLAP_PARAMETERS);
+#define FLAP_DISPATCH() FLAP_MUSTTAIL return ((flap_handler* const*)dispatch)[ld8(ip)](FLAP_ARGUMENTS)
+
+/* Integer division and remainder. Handlers check for zero divisors and overflow first; these only stay defined. */
+FLAP_INLINE u64 flap_div_s32(u64 a, u64 b) { i32 x = (i32)a, y = (i32)b; if (y == 0 || (y == -1 && x == INT32_MIN)) return (u32)x; return (u32)(x / y); }
+FLAP_INLINE u64 flap_div_u32(u64 a, u64 b) { u32 x = (u32)a, y = (u32)b; return y == 0 ? 0 : x / y; }
+FLAP_INLINE u64 flap_rem_s32(u64 a, u64 b) { i32 x = (i32)a, y = (i32)b; if (y == 0 || y == -1) return 0; return (u32)(x % y); }
+FLAP_INLINE u64 flap_rem_u32(u64 a, u64 b) { u32 x = (u32)a, y = (u32)b; return y == 0 ? 0 : x % y; }
+FLAP_INLINE u64 flap_div_s64(u64 a, u64 b) { i64 x = (i64)a, y = (i64)b; if (y == 0 || (y == -1 && x == INT64_MIN)) return (u64)x; return (u64)(x / y); }
+FLAP_INLINE u64 flap_div_u64(u64 a, u64 b) { return b == 0 ? 0 : a / b; }
+FLAP_INLINE u64 flap_rem_s64(u64 a, u64 b) { i64 x = (i64)a, y = (i64)b; if (y == 0 || y == -1) return 0; return (u64)(x % y); }
+FLAP_INLINE u64 flap_rem_u64(u64 a, u64 b) { return b == 0 ? 0 : a % b; }
+FLAP_INLINE u64 flap_clz32(u64 a) { u32 x = (u32)a; return x == 0 ? 32 : (u64)__builtin_clz(x); }
+FLAP_INLINE u64 flap_ctz32(u64 a) { u32 x = (u32)a; return x == 0 ? 32 : (u64)__builtin_ctz(x); }
+FLAP_INLINE u64 flap_clz64(u64 a) { return a == 0 ? 64 : (u64)__builtin_clzll(a); }
+FLAP_INLINE u64 flap_ctz64(u64 a) { return a == 0 ? 64 : (u64)__builtin_ctzll(a); }
+FLAP_INLINE u64 flap_rotl32(u64 a, u64 n) { u32 x = (u32)a; unsigned c = (unsigned)n & 31; return (u32)((x << c) | (x >> ((32 - c) & 31))); }
+FLAP_INLINE u64 flap_rotr32(u64 a, u64 n) { u32 x = (u32)a; unsigned c = (unsigned)n & 31; return (u32)((x >> c) | (x << ((32 - c) & 31))); }
+FLAP_INLINE u64 flap_rotl64(u64 x, u64 n) { unsigned c = (unsigned)n & 63; return (x << c) | (x >> ((64 - c) & 63)); }
+FLAP_INLINE u64 flap_rotr64(u64 x, u64 n) { unsigned c = (unsigned)n & 63; return (x >> c) | (x << ((64 - c) & 63)); }
+/* cvttsd2si: NaN and values out of range give 0x8000000000000000. */
+FLAP_INLINE u64 flap_truncate_f64_to_s64(u64 bits) { u64 result; (void)flap_f64_to_i64(bits, &result); return result; }
+"#;
+
+/// The v128 operations, as the SSE instructions the x86-64 backend uses for them compute them (see
+/// `VectorOperation::x86_64_mnemonic`): lane by lane, the lowest lane in the lowest bytes.
+const VECTOR_PRELUDE: &str = r#"
+typedef struct { u64 lo, hi; } flap_v128;
+typedef union {
+    flap_v128 v;
+    u8 u8[16]; i8 i8[16]; u16 u16[8]; i16 i16[8]; u32 u32[4]; i32 i32[4]; u64 u64[2]; i64 i64[2]; float f32[4]; double f64[2];
+} flap_lanes;
+
+FLAP_INLINE flap_v128 ldv(u64 address) { flap_v128 value; __builtin_memcpy(&value, (const void*)(uptr)address, 16); return value; }
+FLAP_INLINE void stv(u64 address, flap_v128 value) { __builtin_memcpy((void*)(uptr)address, &value, 16); }
+FLAP_INLINE flap_v128 flap_v128_from_u64x2(u64 lo, u64 hi) { flap_v128 value = { lo, hi }; return value; }
+
+FLAP_INLINE i8 flap_sat_i8(i32 x) { return x < -128 ? -128 : x > 127 ? 127 : (i8)x; }
+FLAP_INLINE u8 flap_sat_u8(i32 x) { return x < 0 ? 0 : x > 255 ? 255 : (u8)x; }
+FLAP_INLINE i16 flap_sat_i16(i32 x) { return x < -32768 ? -32768 : x > 32767 ? 32767 : (i16)x; }
+FLAP_INLINE u16 flap_sat_u16(i32 x) { return x < 0 ? 0 : x > 65535 ? 65535 : (u16)x; }
+FLAP_INLINE i16 flap_sat_i16_from_i64(i64 x) { return x < -32768 ? -32768 : x > 32767 ? 32767 : (i16)x; }
+FLAP_INLINE u16 flap_sat_u16_from_i64(i64 x) { return x < 0 ? 0 : x > 65535 ? 65535 : (u16)x; }
+/* cvttps2dq and cvttpd2dq: NaN and values out of range give 0x80000000. */
+FLAP_INLINE i32 flap_truncate_to_i32(double x) { return (x > -2147483649.0 && x < 2147483648.0) ? (i32)x : INT32_MIN; }
+
+#define FLAP_V_BINARY(name, lane, count, expression)                          \
+    FLAP_INLINE flap_v128 flap_##name(flap_v128 lhs, flap_v128 rhs)            \
+    {                                                                          \
+        flap_lanes a = { .v = lhs }, b = { .v = rhs }, r;                      \
+        for (int i = 0; i < (count); ++i)                                      \
+            r.lane[i] = (expression);                                          \
+        return r.v;                                                            \
+    }
+#define FLAP_V_UNARY(name, lane, count, expression)                           \
+    FLAP_INLINE flap_v128 flap_##name(flap_v128 source)                        \
+    {                                                                          \
+        flap_lanes a = { .v = source }, r;                                     \
+        for (int i = 0; i < (count); ++i)                                      \
+            r.lane[i] = (expression);                                          \
+        return r.v;                                                            \
+    }
+#define FLAP_MASK(condition, type) ((condition) ? (type)~(type)0 : (type)0)
+
+FLAP_V_BINARY(v128_and, u64, 2, a.u64[i] & b.u64[i])
+FLAP_V_BINARY(v128_or, u64, 2, a.u64[i] | b.u64[i])
+FLAP_V_BINARY(v128_xor, u64, 2, a.u64[i] ^ b.u64[i])
+FLAP_V_BINARY(v128_andnot, u64, 2, ~a.u64[i] & b.u64[i])
+FLAP_V_BINARY(v128_add_i8, u8, 16, (u8)(a.u8[i] + b.u8[i]))
+FLAP_V_BINARY(v128_sub_i8, u8, 16, (u8)(a.u8[i] - b.u8[i]))
+FLAP_V_BINARY(v128_eq_i8, u8, 16, FLAP_MASK(a.u8[i] == b.u8[i], u8))
+FLAP_V_BINARY(v128_gt_s_i8, u8, 16, FLAP_MASK(a.i8[i] > b.i8[i], u8))
+FLAP_V_BINARY(v128_add_i16, u16, 8, (u16)(a.u16[i] + b.u16[i]))
+FLAP_V_BINARY(v128_sub_i16, u16, 8, (u16)(a.u16[i] - b.u16[i]))
+FLAP_V_BINARY(v128_eq_i16, u16, 8, FLAP_MASK(a.u16[i] == b.u16[i], u16))
+FLAP_V_BINARY(v128_gt_s_i16, u16, 8, FLAP_MASK(a.i16[i] > b.i16[i], u16))
+FLAP_V_BINARY(v128_add_i32, u32, 4, a.u32[i] + b.u32[i])
+FLAP_V_BINARY(v128_sub_i32, u32, 4, a.u32[i] - b.u32[i])
+FLAP_V_BINARY(v128_eq_i32, u32, 4, FLAP_MASK(a.u32[i] == b.u32[i], u32))
+FLAP_V_BINARY(v128_gt_s_i32, u32, 4, FLAP_MASK(a.i32[i] > b.i32[i], u32))
+FLAP_V_BINARY(v128_add_i64, u64, 2, a.u64[i] + b.u64[i])
+FLAP_V_BINARY(v128_sub_i64, u64, 2, a.u64[i] - b.u64[i])
+FLAP_V_BINARY(v128_eq_i64, u64, 2, FLAP_MASK(a.u64[i] == b.u64[i], u64))
+FLAP_V_BINARY(v128_gt_s_i64, u64, 2, FLAP_MASK(a.i64[i] > b.i64[i], u64))
+FLAP_V_BINARY(v128_add_sat_s_i8, i8, 16, flap_sat_i8((i32)a.i8[i] + b.i8[i]))
+FLAP_V_BINARY(v128_add_sat_u_i8, u8, 16, flap_sat_u8((i32)a.u8[i] + b.u8[i]))
+FLAP_V_BINARY(v128_sub_sat_s_i8, i8, 16, flap_sat_i8((i32)a.i8[i] - b.i8[i]))
+FLAP_V_BINARY(v128_sub_sat_u_i8, u8, 16, flap_sat_u8((i32)a.u8[i] - b.u8[i]))
+FLAP_V_BINARY(v128_avgr_u_i8, u8, 16, (u8)(((u32)a.u8[i] + b.u8[i] + 1) >> 1))
+FLAP_V_BINARY(v128_add_sat_s_i16, i16, 8, flap_sat_i16((i32)a.i16[i] + b.i16[i]))
+FLAP_V_BINARY(v128_add_sat_u_i16, u16, 8, flap_sat_u16((i32)a.u16[i] + b.u16[i]))
+FLAP_V_BINARY(v128_sub_sat_s_i16, i16, 8, flap_sat_i16((i32)a.i16[i] - b.i16[i]))
+FLAP_V_BINARY(v128_sub_sat_u_i16, u16, 8, flap_sat_u16((i32)a.u16[i] - b.u16[i]))
+FLAP_V_BINARY(v128_avgr_u_i16, u16, 8, (u16)(((u32)a.u16[i] + b.u16[i] + 1) >> 1))
+FLAP_V_BINARY(v128_mul_i16, u16, 8, (u16)((u32)a.u16[i] * b.u16[i]))
+FLAP_V_BINARY(v128_mul_i32, u32, 4, (u32)((u64)a.u32[i] * b.u32[i]))
+FLAP_V_BINARY(v128_mul_u32_to_u64, u64, 2, (u64)a.u32[2 * i] * b.u32[2 * i])
+FLAP_V_BINARY(v128_mulhi_s_i16, u16, 8, (u16)(((i32)a.i16[i] * b.i16[i]) >> 16))
+FLAP_V_BINARY(v128_mulhi_u_i16, u16, 8, (u16)(((u32)a.u16[i] * b.u16[i]) >> 16))
+FLAP_V_BINARY(v128_mulhrs_i16, u16, 8, (u16)(((((i32)a.i16[i] * b.i16[i]) >> 14) + 1) >> 1))
+FLAP_V_BINARY(v128_madd_i16, u32, 4, (u32)((i32)a.i16[2 * i] * b.i16[2 * i]) + (u32)((i32)a.i16[2 * i + 1] * b.i16[2 * i + 1]))
+FLAP_V_BINARY(v128_madd_u8_s8, i16, 8, flap_sat_i16((i32)a.u8[2 * i] * b.i8[2 * i] + (i32)a.u8[2 * i + 1] * b.i8[2 * i + 1]))
+FLAP_V_BINARY(v128_min_s_i8, i8, 16, a.i8[i] < b.i8[i] ? a.i8[i] : b.i8[i])
+FLAP_V_BINARY(v128_min_u_i8, u8, 16, a.u8[i] < b.u8[i] ? a.u8[i] : b.u8[i])
+FLAP_V_BINARY(v128_max_s_i8, i8, 16, a.i8[i] > b.i8[i] ? a.i8[i] : b.i8[i])
+FLAP_V_BINARY(v128_max_u_i8, u8, 16, a.u8[i] > b.u8[i] ? a.u8[i] : b.u8[i])
+FLAP_V_BINARY(v128_min_s_i16, i16, 8, a.i16[i] < b.i16[i] ? a.i16[i] : b.i16[i])
+FLAP_V_BINARY(v128_min_u_i16, u16, 8, a.u16[i] < b.u16[i] ? a.u16[i] : b.u16[i])
+FLAP_V_BINARY(v128_max_s_i16, i16, 8, a.i16[i] > b.i16[i] ? a.i16[i] : b.i16[i])
+FLAP_V_BINARY(v128_max_u_i16, u16, 8, a.u16[i] > b.u16[i] ? a.u16[i] : b.u16[i])
+FLAP_V_BINARY(v128_min_s_i32, i32, 4, a.i32[i] < b.i32[i] ? a.i32[i] : b.i32[i])
+FLAP_V_BINARY(v128_min_u_i32, u32, 4, a.u32[i] < b.u32[i] ? a.u32[i] : b.u32[i])
+FLAP_V_BINARY(v128_max_s_i32, i32, 4, a.i32[i] > b.i32[i] ? a.i32[i] : b.i32[i])
+FLAP_V_BINARY(v128_max_u_i32, u32, 4, a.u32[i] > b.u32[i] ? a.u32[i] : b.u32[i])
+/* Shift counts come from the low 64 bits of the right operand; logical shifts past the lane width give 0, and
