+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! Decides whether memory 0 has guard pages. The assembly interpreter turns faults in them into traps; the C
+//! interpreter (see ../Engine/build.rs) cannot, and wasm32 cannot reserve the address range, so there every access is
+//! bounds checked (see rule 1 in src/quickening.rs).
+
+use std::env;
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-env-changed=LIBWASM_INTERPRETER_BACKEND");
+    println!("cargo::rustc-check-cfg=cfg(libwasm_checked_memory)");
+    let is_wasm32 = env::var("CARGO_CFG_TARGET_ARCH").is_ok_and(|architecture| architecture == "wasm32");
+    if is_wasm32 || env::var("LIBWASM_INTERPRETER_BACKEND").is_ok_and(|backend| backend == "c") {
+        println!("cargo:rustc-cfg=libwasm_checked_memory");
+    }
+}
