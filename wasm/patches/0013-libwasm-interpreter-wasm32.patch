+    constant("POINTER_SIZE", size_of::<usize>());
+    fn field_size<T, F>(_: fn(&T) -> &F) -> usize {
+        size_of::<F>()
+    }
     macro_rules! field {
         ($name:literal, $type:ty, $field:ident) => {
             constant($name, offset_of!($type, $field));
+            if size_of::<usize>() == 4 && field_size(|value: &$type| &value.$field) == 4 {
