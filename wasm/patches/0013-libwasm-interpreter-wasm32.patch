+/// Compile a program that prints `abi::layout_constants()` for the target, and run it there with the command that
+/// LIBJS_TARGET_RUNNER names (wasmtime by default).
+fn layout_on_target(manifest_directory: &std::path::Path, output_directory: &std::path::Path) -> String {
+    println!("cargo:rerun-if-env-changed=LIBJS_TARGET_RUNNER");
+    let rustc = env::var("RUSTC").unwrap_or_else(|_| "rustc".to_string());
+    let target = env::var("TARGET").expect("TARGET");
+    let directory = output_directory.join("layout_for_target");
+    fs::create_dir_all(&directory).expect("create the layout generator directory");
+    let main = directory.join("main.rs");
+    let abi = manifest_directory.join("../Module/src/abi.rs");
+    write_if_changed(
+        &main,
+        &format!(
+            "#[path = {:?}]\n#[allow(dead_code)]\nmod abi;\nfn main() {{ print!(\"{{}}\", abi::layout_constants()); }}\n",
+            abi.display().to_string()
+        ),
+    );
+    let generator = directory.join(if target.starts_with("wasm") { "layout.wasm" } else { "layout" });
+    let status = std::process::Command::new(&rustc)
+        .args(["--edition", "2024", "-O", "--target", &target])
+        .arg(&main)
+        .arg("-o")
+        .arg(&generator)
+        .status()
+        .unwrap_or_else(|error| panic!("compile the layout generator for {target}: {error}"));
+    assert!(status.success(), "compiling the layout generator for {target} failed: {status}");
+    let runner = env::var("LIBJS_TARGET_RUNNER").unwrap_or_else(|_| "wasmtime".to_string());
+    let mut words = runner.split_whitespace();
+    let output = std::process::Command::new(words.next().expect("LIBJS_TARGET_RUNNER names a command"))
+        .args(words)
+        .arg(&generator)
+        .output()
+        .unwrap_or_else(|error| panic!("run the layout generator with {runner} (set LIBJS_TARGET_RUNNER): {error}"));
+    assert!(
+        output.status.success(),
+        "the layout generator failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8(output.stdout).expect("the layout is UTF-8")
+}
