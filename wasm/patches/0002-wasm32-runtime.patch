new file mode 100644
index 00000000..0959e856
--- /dev/null
+++ b/Libraries/LibJS/Rust/generate/layout_main.rs
@@ -0,0 +1,61 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! The layout table as a program of its own. build.rs computes the layout with the build machine's type layouts,
+//! which only match the target's where both have the same pointer width. For any other target, build.rs compiles this
+//! for the target and runs it there, under the runner that LIBJS_TARGET_RUNNER names, to get the target's layout.
+//!
+//! Usage: layout_main HEAP_REGION_OFFSET_MASK PRIMITIVE_STORAGE_CAGE_OFFSET_MASK VM_STACK_SPACE_LIMIT
+//! Prints the layout file, its static assertions, the embedding layout header and its static assertions, each after a
+//! line `@@ <name>` (see generate/target_layout.rs).
+
+#[allow(dead_code)]
+#[path = "../src/layout/mod.rs"]
+mod layout;
+
+#[path = "layout_forward.rs"]
+mod layout_forward;
+
+#[allow(dead_code)]
+#[path = "../src/gc/class_id.rs"]
+mod class_id;
+
+#[path = "c_type_spelling.rs"]
+mod c_type_spelling;
+
+#[path = "layout_table.rs"]
+mod layout_table;
+
+#[allow(dead_code)]
+#[path = "layout_header.rs"]
+mod layout_header;
+
+fn section(name: &str, text: &str) {
+    println!("@@ {name}");
+    print!("{text}");
+    if !text.ends_with('\n') {
+        println!();
+    }
+}
+
+fn main() {
+    let arguments: Vec<u64> = std::env::args()
+        .skip(1)
+        .map(|argument| argument.parse().expect("a number"))
+        .collect();
+    assert_eq!(arguments.len(), 3, "usage: layout_main HEAP_MASK CAGE_MASK STACK_LIMIT");
+    let configuration = layout_table::LayoutConfiguration {
+        heap_region_offset_mask: arguments[0],
+        primitive_storage_cage_offset_mask: arguments[1],
+        vm_stack_space_limit: arguments[2],
+    };
+    let layout = layout_table::generate(&configuration);
+    section("layout", &layout.text);
+    section("layout_static_assertions", &layout.static_assertions);
+    let header = layout_header::generate();
+    section("layout_header", &header.text);
+    section("layout_header_static_assertions", &header.static_assertions);
+}
