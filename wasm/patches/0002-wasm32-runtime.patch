new file mode 100644
index 00000000..387f5ec5
--- /dev/null
+++ b/Libraries/LibJS/Rust/generate/target_layout.rs
@@ -0,0 +1,103 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! The layouts of a target whose pointer width differs from the build machine's, where computing them with the build
+//! machine's type layouts would be wrong. Compiles generate/layout_main.rs for the target and runs it there, under the
+//! command that LIBJS_TARGET_RUNNER names (wasmtime by default).
+
+use std::env;
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+// NB: Each build script that includes this reads only some of the layouts.
+#[allow(dead_code)]
+pub struct TargetLayout {
+    pub layout: String,
+    pub layout_static_assertions: String,
+    pub layout_header: String,
+    pub layout_header_static_assertions: String,
+}
+
+/// Whether the layouts have to be computed on the target.
+pub fn needed() -> bool {
+    env::var("CARGO_CFG_TARGET_POINTER_WIDTH").is_ok_and(|width| width != "64")
+}
+
+/// `runtime_directory` is that of the libjs_rust crate. The arguments are those of layout_main.
+pub fn compute(runtime_directory: &Path, output_directory: &Path, arguments: [u64; 3]) -> TargetLayout {
+    println!("cargo:rerun-if-env-changed=LIBJS_TARGET_RUNNER");
+    let rustc = env::var("RUSTC").unwrap_or_else(|_| "rustc".to_string());
+    let target_triple = env::var("TARGET").expect("TARGET");
+    let directory = output_directory.join("layout_for_target");
+    fs::create_dir_all(&directory).expect("create the layout generator directory");
+
+    let run = |command: &mut Command, what: &str| {
+        let status = command.status().unwrap_or_else(|error| panic!("{what}: {error}"));
+        assert!(status.success(), "{what} failed: {status}");
+    };
+    let abi_library = directory.join("liblibjs_abi.rlib");
+    run(
+        Command::new(&rustc)
+            .args(["--edition", "2024", "--crate-type", "rlib", "--crate-name", "libjs_abi", "-O", "--target"])
+            .arg(&target_triple)
+            .arg(runtime_directory.join("../ABI/src/lib.rs"))
+            .arg("-o")
+            .arg(&abi_library),
+        "compile libjs_abi for the target",
+    );
+    let generator = directory.join(if target_triple.starts_with("wasm") { "layout_main.wasm" } else { "layout_main" });
+    run(
+        Command::new(&rustc)
+            .args(["--edition", "2024", "-O", "--target"])
+            .arg(&target_triple)
+            .arg("--extern")
+            .arg(format!("libjs_abi={}", abi_library.display()))
+            .arg(runtime_directory.join("generate/layout_main.rs"))
+            .arg("-o")
+            .arg(&generator),
+        "compile the layout generator for the target",
+    );
+
+    let runner = env::var("LIBJS_TARGET_RUNNER").unwrap_or_else(|_| "wasmtime".to_string());
+    let mut runner_words = runner.split_whitespace();
+    let mut command = Command::new(runner_words.next().expect("LIBJS_TARGET_RUNNER names a command"));
+    command
+        .args(runner_words)
+        .arg(&generator)
+        .args(arguments.iter().map(u64::to_string));
+    let output = command
+        .output()
+        .unwrap_or_else(|error| panic!("run the layout generator with {runner} (set LIBJS_TARGET_RUNNER): {error}"));
+    assert!(
+        output.status.success(),
+        "the layout generator failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let output = String::from_utf8(output.stdout).expect("the layouts are UTF-8");
+
+    let mut sections: Vec<(String, String)> = Vec::new();
+    for line in output.split_inclusive('\n') {
+        if let Some(name) = line.strip_prefix("@@ ") {
+            sections.push((name.trim().to_string(), String::new()));
+        } else {
+            sections.last_mut().expect("the output starts with a section").1.push_str(line);
+        }
+    }
+    let mut take = |name: &str| {
+        let index = sections
+            .iter()
+            .position(|(section, _)| section == name)
+            .unwrap_or_else(|| panic!("the layout generator wrote no {name}"));
+        sections.remove(index).1
+    };
+    TargetLayout {
+        layout: take("layout"),
+        layout_static_assertions: take("layout_static_assertions"),
+        layout_header: take("layout_header"),
+        layout_header_static_assertions: take("layout_header_static_assertions"),
+    }
+}
