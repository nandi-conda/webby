/// A copy of qt2wasm's proc/wit/proc.wit (latha-gui 0.9.0), with the world webby binds.
///
/// latha:proc: processes and message channels for wasm programs.
///
/// A wasm program (a WASI command, or a latha:gui app) can start other wasm
/// programs as "processes": each is its own instance, with its own linear
/// memory, running on its own native thread of the host. They talk over
/// channels: a channel is a pair of endpoints, a message is bytes plus
/// endpoints moved along with it (like file descriptors over a Unix socket,
/// SCM_RIGHTS). This is what multi-process programs (Ladybird's WebContent,
/// RequestServer, ImageDecoder) use in place of fork/exec and socketpairs.
///
/// Handles are small integers, private to an instance. An endpoint sent in a
/// message leaves the sender's table and gets a new handle in the receiver's.
/// An endpoint is closed when its handle is closed, or its instance ends; the
/// other side then reads what was queued and then `closed`.
///
/// The same functions exist for core modules (no component model) as imports
/// from the module "latha:proc", see ../latha_proc.h.
package latha:proc@0.1.0;

interface channels {
    /// An endpoint handle.
    type handle = u32;

    enum error {
        /// The other endpoint is gone (and nothing is queued any more).
        closed,
        /// Nothing arrived before the timeout.
        timeout,
        /// Not a handle of this instance (or sent along with itself).
        bad-handle,
        /// A message over the host's limit (16 MiB, 256 handles).
        too-big,
    }

    record message {
        data: list<u8>,
        handles: list<handle>,
    }

    /// A new channel: two connected endpoints.
    pair: func() -> tuple<handle, handle>;

    /// Queue a message on `h` for its peer. Never blocks. The endpoints in
    /// `handles` move with it (they are no longer ours, even if the peer is
    /// gone).
    send: func(h: handle, data: list<u8>, handles: list<handle>) -> result<_, error>;

    /// The next message on `h`. `timeout-ms`: 0 = do not wait, < 0 = wait
    /// for ever.
    recv: func(h: handle, timeout-ms: s32) -> result<message, error>;

    /// Wait until one of `hs` has a message (or its peer closed), at most
    /// `timeout-ms` (< 0 for ever). Returns the indices into `hs` that are
    /// ready (empty after a timeout).
    wait: func(hs: list<handle>, timeout-ms: s32) -> list<u32>;

    /// Close our endpoint.
    close: func(h: handle);

    /// The endpoint a process was started with (its parent's channel), once.
    parent: func() -> option<handle>;
}

interface process {
    use channels.{handle};

    /// Start `path` (a core wasm module with WASI preview 1, or a WASI command
    /// component) as a new process on its own thread. `args` are its
    /// arguments, its name first. A relative path is relative to the
    /// directory of the caller's own .wasm; "" means the caller's own module.
    /// The child sees the same directories and environment as we do (our
    /// environment as we were started with it). Returns
    /// its pid and our end of a channel whose other end is the child's
    /// `parent()`.
    spawn: func(path: string, args: list<string>) -> result<tuple<u32, handle>, string>;

    /// `spawn`, with `env` ("NAME=value" entries) as the child's whole
    /// environment instead of ours (latha-gui 0.4.0 and later).
    spawn-with-env: func(path: string, args: list<string>, env: list<string>) -> result<tuple<u32, handle>, string>;

    /// The exit code of a child once it ended (`timeout-ms` as for recv),
    /// else none. A child that trapped exits with 128 + 6.
    wait-exit: func(pid: u32, timeout-ms: s32) -> option<s32>;

    /// Ask a child to stop: it traps at its next loop back edge or call.
    kill: func(pid: u32);
}

/// Shared memory: an object of bytes that several processes map into their
/// own linear memory, so all of them see the same bytes (Ladybird's
/// AnonymousBuffer: bitmaps WebContent paints and the UI shows). A handle to
/// one lives in the same table as endpoints: `channels.close` closes it, and it
/// moves in a message like an endpoint does (send a `dup` to keep yours). The
/// object goes away with its last handle and mapping.
interface memory {
    use channels.{handle};

    enum error {
        /// Not a memory handle of this instance.
        bad-handle,
        /// An address, length or offset that is not a multiple of page-size.
        unaligned,
        /// A range outside our linear memory, or past the object's end.
        fault,
        /// The host could not make or map it.
        no-memory,
    }

    /// A new object of `size` bytes, zeroed.
    create: func(size: u64) -> result<handle, error>;
    /// Another handle to the same object.
    dup: func(h: handle) -> result<handle, error>;
    size: func(h: handle) -> result<u64, error>;
    /// Make it bigger (never smaller: a mapping past the end would fault on the
    /// host, so a smaller size is refused with `fault`).
    resize: func(h: handle, size: u64) -> result<_, error>;
    /// Make our linear memory [addr, addr + len) the object's bytes from `offset`.
    /// All three are multiples of page-size; the range must be in our memory
    /// already (allocate it, page aligned, then map over it).
    map-at: func(h: handle, offset: u64, addr: u32, len: u32) -> result<_, error>;
    /// Give [addr, addr + len) of our memory its own zeroed pages again.
    unmap-at: func(addr: u32, len: u32) -> result<_, error>;
    /// The host's page size (4096 on x86-64 Linux).
    page-size: func() -> u32;
    /// Whether `h` is a memory handle (else an endpoint, or not ours).
    is-memory: func(h: handle) -> bool;
}

/// A latha:gui app's worker (latha-gui 0.9.0 and later): an app that exports this can run a second instance of its
/// own component on another thread of the host, for work that should not hold up its window (a browser's engine).
/// The app calls `process.spawn("", args)` (the empty path is its own component); the host makes a new instance in
/// its own store on its own thread, with WASI, latha:proc, and latha:gui's gl and audio like the app's (the
/// window's own imports, such as host and pty, trap there), and calls `run` with `args`. Its `parent()` is the
/// app's channel; when `run` returns the worker ends with that exit code. The host sets LATHA_GUI_WORKER=1 in the
/// app's environment (and the worker's) when it can do this.
interface worker {
    run: func(args: list<string>) -> s32;
}

/// webby's use of it (wasm/ui/EngineWorker.cpp): the engine runs in a worker, the chrome talks to it over a channel.
world proc-guest {
    import channels;
    import process;
    import memory;
    export worker;
}
