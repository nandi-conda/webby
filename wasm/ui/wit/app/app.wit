/// webby.wasm built inside the engine build (target webby-ui): the Qt UI and the engine in one module, a latha:gui app
/// (the world is named `gui` because qt2wasm's platform plugin uses the `gui_` binding names) that imports MuPDF's
/// webby:pdf documents for the PDF viewer. deps/ is filled in by the build: latha:gui from qt2wasm, webby:pdf from
/// wasm/pdf/wit; `wac plug` then puts the webby-pdf component in.
package webby:app@0.1.0;

world gui {
    include latha:gui/gui@0.2.1;
    import webby:pdf/documents@0.1.0;
}
