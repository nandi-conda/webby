/// webby:engine: Ladybird (LibWeb, LibJS, Skia) as its own component, behind the same API as ../../WebView.h.
///
/// The engine component (webby-core.wasm, bin/webby-core.wasm in the engine build) exports `views`; webby's Qt UI
/// (webby-ui-shell.wasm) imports it, and `wac plug webby-ui-shell.wasm --plug webby-core.wasm -o webby.wasm` makes
/// the latha:gui app. A UI change rebuilds only the small UI component (wasm/ui/shell, a standalone CMake project
/// that needs no Ladybird build) and composes again.
///
/// The engine cannot call back into the UI (a component only calls what it imports), so what a page does comes
/// back as events: the UI takes them after each call.
package webby:engine@0.1.0;

interface views {
    /// Keyboard modifiers, in LibWeb's UIEvents::KeyModifier bit order.
    flags modifiers { alt, ctrl, shift, super, keypad }
    /// Mouse buttons, in LibWeb's UIEvents::MouseButton bit order.
    flags buttons { primary, secondary, middle, backward, forward }

    /// Text the page copied: to the clipboard, or (`selection`) to the X11 primary selection.
    record clipboard-write {
        text: string,
        selection: bool,
    }
    /// The page pastes: the UI reads the clipboard (or, `selection`, the primary selection) and calls the view's
    /// `answer-clipboard` with `id`. Unanswered, the paste waits.
    record clipboard-request {
        id: u64,
        selection: bool,
    }

    /// What a right-click hit (the page did not cancel its contextmenu event): the UI shows its menu. URLs are ""
    /// when there is none; `selection` is the selected text, `editable` a click in a text field.
    record context-menu {
        x: s32,
        y: s32,
        link: string,
        link-text: string,
        image: string,
        selection: string,
        editable: bool,
    }

    /// A navigation the engine saved as a file instead of showing it (Content-Disposition: attachment, or a type it
    /// cannot show): `path` where it went, or `error` why not ("" when saved). The page stays as it was.
    record download {
        url: string,
        path: string,
        size: u64,
        mime: string,
        error: string,
    }

    /// A navigation's response is a PDF (application/pdf, not an attachment; or a .pdf file): the view keeps `url` in
    /// its history and shows an empty page titled with the file's name; the UI shows the PDF itself (MuPDF, the
    /// webby:pdf component) while the view's URL is `url`.
    record pdf-document {
        url: string,
        mime: string,
        data: list<u8>,
    }

    /// What a page did since the last `take-events`, for the chrome.
    variant event {
        /// The page changed: `paint` it again.
        needs-paint,
        title-changed(string),
        url-changed(string),
        loading-changed(bool),
        /// The URL of the link under the pointer, "" when it leaves the link.
        link-hovered(string),
        clipboard-written(clipboard-write),
        clipboard-requested(clipboard-request),
        context-menu-requested(context-menu),
        download-finished(download),
        pdf-received(pdf-document),
    }

    record find-result {
        index: u32,
        total: s32,
    }

    /// One page (a tab). Sizes and coordinates are CSS pixels at device pixel ratio 1.
    resource view {
        /// The first view sets the engine up (its JS VM, resource loader, theme and fonts).
        constructor(width: u32, height: u32);
        load: func(url: string);
        reload: func();
        can-go-back: func() -> bool;
        can-go-forward: func() -> bool;
        go-back: func();
        go-forward: func();
        url: func() -> string;
        title: func() -> string;
        is-loading: func() -> bool;
        resize: func(width: u32, height: u32);
        needs-paint: func() -> bool;
        /// The page's pixels, premultiplied BGRA (Qt's ARGB32_Premultiplied), width x height, rows packed; none when
        /// nothing changed since the last paint (or before the first load).
        paint: func() -> option<list<u8>>;
        /// `button` is the one that changed, `held` the buttons held after the event.
        mouse-down: func(x: s32, y: s32, button: buttons, held: buttons, mods: modifiers, clicks: u32);
        mouse-up: func(x: s32, y: s32, button: buttons, held: buttons, mods: modifiers);
        mouse-move: func(x: s32, y: s32, held: buttons, mods: modifiers);
        mouse-leave: func();
        wheel: func(x: s32, y: s32, dx: f64, dy: f64, mods: modifiers);
        /// `key` is a LibWeb UIEvents::KeyCode (wasm/ui/KeyCodes.h), `code-point` the text the key types (0: none).
        key-down: func(key: u32, mods: modifiers, code-point: u32, repeat: bool);
        key-up: func(key: u32, mods: modifiers, code-point: u32);
        take-events: func() -> list<event>;
        /// The clipboard's text for a `clipboard-requested` event ("" if it holds none).
        answer-clipboard: func(id: u64, text: string);
        /// Editing in the focused frame, for the context menu: the selected text, select all, cut (removes the
        /// selection in an editable and returns it), and insert `text` at the caret as a paste would.
        selected-text: func() -> string;
        select-all: func();
        cut-selection: func() -> string;

        /// Find in page: every match of `query` highlighted, the active one scrolled into view. `index` counts from
        /// 0; `total` is -1 when not known yet, 0 for no match. `find-end` clears the highlights.
        find: func(query: string, case-sensitive: bool) -> find-result;
        find-next: func() -> find-result;
        find-previous: func() -> find-result;
        find-end: func();
        /// Page zoom, 1.0 for 100% (clamped to 0.25 .. 5); it stays across the view's navigations.
        set-zoom: func(level: f64);
        insert-text: func(text: string);
    }

    /// Run the engine's event loop until nothing is due right now (timers, tasks). Never blocks.
    pump: func();
}

world engine {
    export views;
}
