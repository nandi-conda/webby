+  // webby: and to tail calls, whose frame goes away at the call. The operands
+  // are evaluated first (they may read the stack space), then the stack is
+  // restored, then the call is made.
+  auto restoreBeforeTailCall = [&](Expression** ptr, ExpressionList& operands,
+                                   Expression** target) {
+    auto* block = builder.makeBlock();
+    auto save = [&](Expression*& operand) {
+      auto temp = builder.addVar(func, operand->type);
+      block->list.push_back(builder.makeLocalSet(temp, operand));
+      operand = builder.makeLocalGet(temp, operand->type);
+    };
+    for (auto*& operand : operands) {
+      save(operand);
+    }
+    if (target) {
+      save(*target);
+    }
+    block->list.push_back(makeStackRestore());
+    block->list.push_back(*ptr);
+    block->finalize();
+    *ptr = block;
+  };
+  FindAllPointers<Call> callFinder(func->body);
+  for (auto** ptr : callFinder.list) {
+    auto* call = (*ptr)->cast<Call>();
+    if (call->isReturn) {
+      restoreBeforeTailCall(ptr, call->operands, nullptr);
+    }
+  }
+  FindAllPointers<CallIndirect> indirectFinder(func->body);
+  for (auto** ptr : indirectFinder.list) {
+    auto* call = (*ptr)->cast<CallIndirect>();
+    if (call->isReturn) {
+      restoreBeforeTailCall(ptr, call->operands, &call->target);
+    }
+  }
+  FindAllPointers<CallRef> refFinder(func->body);
+  for (auto** ptr : refFinder.list) {
+    auto* call = (*ptr)->cast<CallRef>();
+    if (call->isReturn) {
+      restoreBeforeTailCall(ptr, call->operands, &call->target);
+    }
+  }
   // add stack restores to the body
