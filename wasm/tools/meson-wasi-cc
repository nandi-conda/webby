#!/usr/bin/env bash
# wasi-sdk clang for meson builds (MESON_WASI_CC=clang or clang++): wasm-ld has no --start-group/--end-group, which
# meson passes for GNU-like linkers. -pthread (meson's threads dependency, dav1d's) is dropped too: it turns on wasm
# atomics, which a single-threaded wasip1 module must not use (latha-gui's runtime has no threads proposal), and
# wasi-libc's single-threaded pthread stubs need no flag.
args=(); for a in "$@"; do case "$a" in -Wl,--start-group|-Wl,--end-group|-pthread) ;; *) args+=("$a");; esac; done
exec "${WASI_SDK_PREFIX:?}/bin/${MESON_WASI_CC:-clang}" "${args[@]}"
