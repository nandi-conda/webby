+#[derive(Clone, Copy, PartialEq)]
+enum SymbolMarkerKind {
+    Disc,
+    Circle,
+    Square,
+}
+
+/// Where a disc, circle or square list marker is drawn, in CSS pixels.
+struct SymbolMarkerShape {
+    kind: SymbolMarkerKind,
+    x: f32,
+    y: f32,
+    size: f32,
+}
+
+// INTEROP: Blink and Gecko draw the disc, circle and square markers as shapes sized from the ascent of the marker's
+//          font, not as its U+2022, U+25E6 and U+25AA glyphs, which many fonts draw much smaller. Like Blink
+//          (ListMarker::RelativeSymbolMarkerRect, InlineMarginsForOutside), the shape is two thirds of the ascent wide
+//          plus one, halved, and an outside marker's shape starts 7px plus two thirds of the ascent before the list
+//          item's content.
+/// The shape to draw in place of the text of `fragment`, when it is the text of a disc, circle or square list marker.
+fn symbol_marker_shape(
+    source: &crate::painting::paint_read::PaintSource<'_>,
+    block: NodeSlotId,
+    fragment: &FragmentRecord,
+    fragment_absolute_rect: CssPixelRect,
+) -> Option<SymbolMarkerShape> {
+    if source.node_kind_if_live(block) != Some(crate::layout::node_data::NodeKind::ListItemMarkerBox)
+        || !text_fragment::is_horizontal(fragment)
+    {
+        return None;
+    }
+    let text = source.rendered_text(fragment.layout_node)?;
+    let end = fragment
+        .start
+        .saturating_add(fragment.length_in_code_units)
+        .min(text.text.len());
+    let units = &text.text[fragment.start.min(end)..end];
+    let kind = match units {
+        [0x2022] | [0x2022, 0x20] => SymbolMarkerKind::Disc,
+        [0x25E6] | [0x25E6, 0x20] => SymbolMarkerKind::Circle,
+        [0x25AA] | [0x25AA, 0x20] => SymbolMarkerKind::Square,
+        _ => return None,
+    };
+    // NB: Blink rounds the ascent and works in whole pixels.
+    let ascent = text_fragment::first_available_font(source, fragment)?
+        .facts()
+        .ascent
+        .round();
+    if ascent <= 0.0 {
+        return None;
+    }
+    let two_thirds_of_ascent = (ascent * 2.0 / 3.0).floor();
+    let size = ((two_thirds_of_ascent + 1.0) / 2.0).floor();
+    // The marker box sits against the list item's content for an outside marker, and starts the line for an inside
+    // one.
+    const MARKER_PADDING: f32 = 7.0;
+    let marker_box = crate::painting::paintable_geometry::absolute_border_box_rect(source, block);
+    let is_inside = source.node_flags_if_live(block) & NodeFlag::ListMarkerIsInside as u32 != 0;
+    let is_rtl = fragment.direction == crate::css::css_enums::direction::RTL;
+    let x = match (is_inside, is_rtl) {
+        (false, false) => marker_box.right().to_float() - two_thirds_of_ascent - MARKER_PADDING,
+        (false, true) => marker_box.x.to_float() + two_thirds_of_ascent + MARKER_PADDING - size,
+        (true, false) => fragment_absolute_rect.x.to_float() + 1.0,
+        (true, true) => fragment_absolute_rect.right().to_float() - 1.0 - size,
+    };
+    let baseline = fragment_absolute_rect.y.to_float() + fragment.baseline.to_float();
+    let y = baseline - ascent + (3.0 * (ascent - two_thirds_of_ascent) / 2.0).floor();
+    Some(SymbolMarkerShape { kind, x, y, size })
+}
+
+fn paint_symbol_marker(
+    recorder: &mut crate::painting::display_list::recorder::DisplayListRecorder,
+    marker: &SymbolMarkerShape,
+    scale: f32,
+    color: Color,
+) {
+    use crate::painting::display_list::recorder::{FillPathParams, PaintStyleOrColor};
+    use libgfx_rust::path::Path;
+    use libgfx_rust::{ShouldAntiAlias, WindingRule};
+    let (x, y, size) = (marker.x * scale, marker.y * scale, marker.size * scale);
+    let mut path = Path::new();
+    let append_circle = |path: &mut Path, radius: f32| {
+        let (center_x, center_y) = (x + size / 2.0, y + size / 2.0);
+        path.move_to(FloatPoint {
+            x: center_x - radius,
+            y: center_y,
+        });
+        path.arc_to(
+            FloatPoint {
+                x: center_x + radius,
+                y: center_y,
+            },
+            radius,
+            false,
+            true,
+        );
+        path.arc_to(
+            FloatPoint {
+                x: center_x - radius,
+                y: center_y,
+            },
+            radius,
+            false,
+            true,
+        );
+        path.close();
+    };
+    match marker.kind {
+        SymbolMarkerKind::Disc => append_circle(&mut path, size / 2.0),
+        SymbolMarkerKind::Circle => {
+            // A one pixel stroke centered on the edge of the shape.
+            append_circle(&mut path, size / 2.0 + scale / 2.0);
+            append_circle(&mut path, (size / 2.0 - scale / 2.0).max(0.0));
+        }
+        SymbolMarkerKind::Square => {
+            path.move_to(FloatPoint { x, y });
+            path.line_to(FloatPoint { x: x + size, y });
+            path.line_to(FloatPoint {
+                x: x + size,
+                y: y + size,
+            });
+            path.line_to(FloatPoint { x, y: y + size });
+            path.close();
+        }
+    }
+    recorder.fill_path(FillPathParams {
+        force_dark_role: ForceDarkRole::Foreground,
+        path: &path,
+        opacity: 1.0,
+        paint_style_or_color: PaintStyleOrColor::Color(color),
+        winding_rule: WindingRule::EvenOdd,
+        should_anti_alias: ShouldAntiAlias::Yes,
+    });
+}
