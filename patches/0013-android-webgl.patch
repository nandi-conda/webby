+    bool use_cpu_painting_surface = true;
 #    else
     bool use_cpu_painting_surface = false;
 #    endif
@@ -177,6 +180,9 @@ OwnPtr<OpenGLContext> OpenGLContext::create(RefPtr<Gfx::SkiaBackendContext> skia
         EGL_PLATFORM_SURFACELESS_MESA,
 #    elif defined(AK_OS_WINDOWS)
         EGL_PLATFORM_ANGLE_TYPE_D3D11_ANGLE,
+#    elif defined(AK_OS_ANDROID)
+        // ANGLE's GLES backend on top of the system's EGL and GLES driver.
+        EGL_PLATFORM_ANGLE_TYPE_OPENGLES_ANGLE,
 #    endif
         EGL_NONE,
     };
