+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibWeb/WebAuthn/AuthenticatorResponse.h>
+
+namespace Web::WebAuthn {
+
+struct AttestationResponseData {
+    ByteBuffer client_data_json;
+    ByteBuffer attestation_object;
+    ByteBuffer authenticator_data;
+    Optional<ByteBuffer> public_key;
+    i32 public_key_algorithm { 0 };
+    Vector<String> transports;
+};
+
+// https://w3c.github.io/webauthn/#authenticatorattestationresponse
+class AuthenticatorAttestationResponse final : public AuthenticatorResponse {
+    WEB_WRAPPABLE(AuthenticatorAttestationResponse, AuthenticatorResponse);
+    GC_DECLARE_ALLOCATOR(AuthenticatorAttestationResponse);
+
+public:
+    [[nodiscard]] static GC::Ref<AuthenticatorAttestationResponse> create(AttestationResponseData);
+    virtual ~AuthenticatorAttestationResponse() override;
+
+    GC::Ref<JS::ArrayBuffer> attestation_object(JS::Realm&);
+    Vector<String> get_transports() const { return m_transports; }
+    GC::Ref<JS::ArrayBuffer> get_authenticator_data(JS::Realm&) const;
+    GC::Ptr<JS::ArrayBuffer> get_public_key(JS::Realm&) const;
+    i32 get_public_key_algorithm() const { return m_public_key_algorithm; }
+
+    ByteBuffer const& attestation_object_bytes() const { return m_attestation_object; }
+    ByteBuffer const& authenticator_data_bytes() const { return m_authenticator_data; }
+    Optional<ByteBuffer> const& public_key_bytes() const { return m_public_key; }
+
+private:
+    explicit AuthenticatorAttestationResponse(AttestationResponseData);
+
+    virtual void visit_edges(Visitor&) override;
+
+    ByteBuffer m_attestation_object;
+    ByteBuffer m_authenticator_data;
+    Optional<ByteBuffer> m_public_key;
+    i32 m_public_key_algorithm { 0 };
+    Vector<String> m_transports;
+
+    GC::Ptr<JS::ArrayBuffer> m_attestation_object_object;
+};
+
+}
