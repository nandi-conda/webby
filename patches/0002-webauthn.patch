+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibJS/Runtime/ArrayBuffer.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibWeb/WebAuthn/AuthenticatorResponse.h>
+
+namespace Web::WebAuthn {
+
+GC_DEFINE_ALLOCATOR(AuthenticatorResponse);
+
+AuthenticatorResponse::AuthenticatorResponse(ByteBuffer client_data_json)
+    : m_client_data_json(move(client_data_json))
+{
+}
+
+AuthenticatorResponse::~AuthenticatorResponse() = default;
+
+void AuthenticatorResponse::visit_edges(Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_client_data_json_object);
+}
+
+GC::Ref<JS::ArrayBuffer> AuthenticatorResponse::array_buffer_for(JS::Realm& realm, GC::Ptr<JS::ArrayBuffer>& cache, ByteBuffer const& bytes)
+{
+    if (!cache)
+        cache = JS::ArrayBuffer::create(realm, MUST(ByteBuffer::copy(bytes)));
+    return *cache;
+}
+
+// https://w3c.github.io/webauthn/#dom-authenticatorresponse-clientdatajson
+GC::Ref<JS::ArrayBuffer> AuthenticatorResponse::client_data_json(JS::Realm& realm)
+{
+    return array_buffer_for(realm, m_client_data_json_object, m_client_data_json);
+}
+
+}
