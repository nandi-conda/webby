@@ -0,0 +1,59 @@
+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibJS/Runtime/ArrayBuffer.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibWeb/WebAuthn/AuthenticatorAssertionResponse.h>
+
+namespace Web::WebAuthn {
+
+GC_DEFINE_ALLOCATOR(AuthenticatorAssertionResponse);
+
+GC::Ref<AuthenticatorAssertionResponse> AuthenticatorAssertionResponse::create(AssertionResponseData data)
+{
+    return GC::Heap::the().allocate<AuthenticatorAssertionResponse>(move(data));
+}
+
+AuthenticatorAssertionResponse::AuthenticatorAssertionResponse(AssertionResponseData data)
+    : AuthenticatorResponse(move(data.client_data_json))
+    , m_authenticator_data(move(data.authenticator_data))
+    , m_signature(move(data.signature))
+    , m_user_handle(move(data.user_handle))
+{
+}
+
+AuthenticatorAssertionResponse::~AuthenticatorAssertionResponse() = default;
+
+void AuthenticatorAssertionResponse::visit_edges(Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_authenticator_data_object);
+    visitor.visit(m_signature_object);
+    visitor.visit(m_user_handle_object);
+}
+
+// https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-authenticatordata
+GC::Ref<JS::ArrayBuffer> AuthenticatorAssertionResponse::authenticator_data(JS::Realm& realm)
+{
+    return array_buffer_for(realm, m_authenticator_data_object, m_authenticator_data);
+}
+
+// https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-signature
+GC::Ref<JS::ArrayBuffer> AuthenticatorAssertionResponse::signature(JS::Realm& realm)
+{
+    return array_buffer_for(realm, m_signature_object, m_signature);
+}
+
+// https://w3c.github.io/webauthn/#dom-authenticatorassertionresponse-userhandle
+GC::Ptr<JS::ArrayBuffer> AuthenticatorAssertionResponse::user_handle(JS::Realm& realm)
+{
+    if (!m_user_handle.has_value())
+        return nullptr;
+    return array_buffer_for(realm, m_user_handle_object, *m_user_handle);
+}
+
+}
