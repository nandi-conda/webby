+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <LibWeb/WebAuthn/AuthenticatorResponse.h>
+
+namespace Web::WebAuthn {
+
+struct AssertionResponseData {
+    ByteBuffer client_data_json;
+    ByteBuffer authenticator_data;
+    ByteBuffer signature;
+    Optional<ByteBuffer> user_handle;
+};
+
+// https://w3c.github.io/webauthn/#authenticatorassertionresponse
+class AuthenticatorAssertionResponse final : public AuthenticatorResponse {
+    WEB_WRAPPABLE(AuthenticatorAssertionResponse, AuthenticatorResponse);
+    GC_DECLARE_ALLOCATOR(AuthenticatorAssertionResponse);
+
+public:
+    [[nodiscard]] static GC::Ref<AuthenticatorAssertionResponse> create(AssertionResponseData);
+    virtual ~AuthenticatorAssertionResponse() override;
+
+    GC::Ref<JS::ArrayBuffer> authenticator_data(JS::Realm&);
+    GC::Ref<JS::ArrayBuffer> signature(JS::Realm&);
+    GC::Ptr<JS::ArrayBuffer> user_handle(JS::Realm&);
+
+    ByteBuffer const& authenticator_data_bytes() const { return m_authenticator_data; }
+    ByteBuffer const& signature_bytes() const { return m_signature; }
+    Optional<ByteBuffer> const& user_handle_bytes() const { return m_user_handle; }
+
+private:
+    explicit AuthenticatorAssertionResponse(AssertionResponseData);
+
+    virtual void visit_edges(Visitor&) override;
+
+    ByteBuffer m_authenticator_data;
+    ByteBuffer m_signature;
+    Optional<ByteBuffer> m_user_handle;
+
+    GC::Ptr<JS::ArrayBuffer> m_authenticator_data_object;
+    GC::Ptr<JS::ArrayBuffer> m_signature_object;
+    GC::Ptr<JS::ArrayBuffer> m_user_handle_object;
+};
+
+}
