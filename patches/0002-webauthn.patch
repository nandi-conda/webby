+void WebContentPage::did_request_webauthn(u64 request_id, String request)
+{
+    // The authenticator belongs to the embedder; without one, every ceremony fails as if the user had cancelled it.
+    if (view().on_request_webauthn) {
+        view().on_request_webauthn(*this, request_id, request);
+        return;
+    }
+    async_webauthn_response(request_id, R"({"error":"NotAllowedError","message":"This browser has no authenticator"})"_string);
+}
