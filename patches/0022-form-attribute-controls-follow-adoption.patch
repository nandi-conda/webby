+                if (auto* html_element = as_if<HTML::HTMLElement>(*element); html_element && html_element->is_form_associated_element() && html_element->has_attribute(HTML::AttributeNames::form)) {
+                    HTML::FormAssociatedElement& form_associated_element = *html_element;
+                    old_document.remove_form_associated_element_with_form_attribute(form_associated_element);
+                    add_form_associated_element_with_form_attribute(form_associated_element);
+                }
             }
 
             return TraversalDecision::Continue;
