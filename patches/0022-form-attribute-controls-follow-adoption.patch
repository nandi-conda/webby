                 if (!element->custom_element_registry() || !element->custom_element_registry()->is_scoped()) {
                     element->set_custom_element_registry(effective_global_custom_element_registry());
                 }
+
+                // AD-HOC: A listed form-associated element with a form attribute registered with its old document when
+                //         the attribute was set, and that document's list is what tells it about elements with IDs
+                //         coming and going. Move it to this document's list, or a control cloned from a <template>'s
