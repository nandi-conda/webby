diff --git a/Libraries/LibWeb/WebAssembly/Exception.cpp b/Libraries/LibWeb/WebAssembly/Exception.cpp
new file mode 100644
index 00000000..bf2284ae
--- /dev/null
+++ b/Libraries/LibWeb/WebAssembly/Exception.cpp
@@ -0,0 +1,183 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibJS/Runtime/Error.h>
+#include <LibJS/Runtime/VM.h>
+#include <LibWeb/Bindings/Exception.h>
+#include <LibWeb/WebAssembly/BindingsGlue.h>
+#include <LibWeb/WebAssembly/Exception.h>
+#include <LibWeb/WebAssembly/Tag.h>
+
+namespace Web::WebAssembly {
+
+GC_DEFINE_ALLOCATOR(Exception);
+
+// https://webassembly.github.io/spec/js-api/#initialize-an-exception-object
+GC::Ref<Exception> Exception::create(NonnullRefPtr<Detail::WebAssemblyCache> cache, Wasm::ExceptionAddress address, Optional<Utf16String> stack)
+{
+    // 1. Let map be the surrounding agent's associated exception object cache.
+    // 2. Assert: map[exnAddr] doesn't exist.
+    VERIFY(!cache->get_exception_instance(address).has_value());
+
+    // 3. Set exn.[[Address]] to exnAddr.
+    // 4. Set map[exnAddr] to exn.
+    // NB: The tag and payload of an exception never change, so they are read from the store when needed.
+    auto object = GC::Heap::the().allocate<Exception>(cache, address, move(stack));
+    cache->add_exception_instance(address, object);
+    return object;
+}
+
+// https://webassembly.github.io/spec/js-api/#create-an-exception-object
+GC::Ref<Exception> Exception::from_address(NonnullRefPtr<Detail::WebAssemblyCache> cache, Wasm::ExceptionAddress address)
+{
+    // 1. Let map be the surrounding agent's associated exception object cache.
+    // 2. If map[exnAddr] exists, return map[exnAddr].
+    if (auto object = cache->get_exception_instance(address); object.has_value())
+        return GC::Ref { **object };
+
+    // 3. Let exn be a new Exception.
+    // 4. Initialize exn from exnAddr.
+    // 5. Set exn.[[Stack]] to undefined.
+    return create(move(cache), address, {});
+}
+
+Exception::Exception(NonnullRefPtr<Detail::WebAssemblyCache> cache, Wasm::ExceptionAddress address, Optional<Utf16String> stack)
+    : m_cache(move(cache))
+    , m_address(address)
+    , m_stack(move(stack))
+{
+}
+
+void Exception::visit_edges(Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+
+    // NOTE: m_cache is already visited by the realm's HostDefined, which owns it.
+    visitor.ignore(m_cache);
+}
+
+Wasm::TagAddress Exception::tag_address() const
+{
+    auto* instance = cache().abstract_machine().store().get(m_address);
+    VERIFY(instance);
+    return instance->tag();
+}
+
+// https://webassembly.github.io/spec/js-api/#dom-exception-is
+bool Exception::is(GC::Ref<Tag> tag) const
+{
+    // 1. If this.[[Type]] is not equal to exceptionTag.[[Address]], return false.
+    // 2. Return true.
+    return &tag->cache() == &cache() && tag_address() == tag->address();
+}
+
+// https://webassembly.github.io/spec/js-api/#dom-exception-stack
+Variant<Utf16String, Empty> Exception::stack() const
+{
+    // 1. Return this.[[Stack]].
+    if (m_stack.has_value())
+        return *m_stack;
+    return Empty {};
+}
+
+}
+
+namespace Web::Bindings {
+
+static bool is_unsupported_exception_value_type(Wasm::ValueType const& type)
+{
+    return type.kind() == Wasm::ValueType::V128 || type.kind() == Wasm::ValueType::ExceptionReference;
+}
+
+// https://webassembly.github.io/spec/js-api/#dom-exception-exception
+WebIDL::ExceptionOr<GC::Ref<WebAssembly::Exception>> construct_exception(JS::Realm& realm, GC::Ref<WebAssembly::Tag> exception_tag, GC::RootVector<JS::Value> const& payload, ExceptionOptions const& options)
+{
+    auto cache = WebAssembly::Detail::get_cache(realm);
+    auto& store = cache->abstract_machine().store();
+
+    // NB: Tags of another realm's store cannot be thrown in this one.
+    if (&exception_tag->cache() != cache.ptr())
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "The tag belongs to another realm"_utf16 };
+
+    // 3. Let store be the surrounding agent's associated store.
+    // 4. Let [types] → [] be tag_type(store, exceptionTag.[[Address]]).
+    auto* tag_instance = store.get(exception_tag->address());
+    VERIFY(tag_instance);
+    auto types = tag_instance->type().parameters();
+
+    // 5. If types's size is not payload's size, throw a TypeError.
+    if (types.size() != payload.size())
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, Utf16String::formatted("The tag takes {} values, not {}", types.size(), payload.size()) };
+
+    // 6. Let wasmPayload be « ».
+    Vector<Wasm::Value> wasm_payload;
+    wasm_payload.ensure_capacity(payload.size());
+
+    // 7. For each value and resultType of payload and types, paired linearly,
+    for (size_t index = 0; index < payload.size(); ++index) {
+        // 1. If resultType is v128 or exnref, throw a TypeError.
+        if (is_unsupported_exception_value_type(types[index]))
+            return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "Cannot pass this value type to an exception"_utf16 };
+        // 2. Append ? ToWebAssemblyValue(value, resultType) to wasmPayload.
+        wasm_payload.unchecked_append(TRY(WebAssembly::Detail::to_webassembly_value(realm, payload[index], types[index])));
+    }
+
+    // 8. Let (store, exceptionAddr) be exn_alloc(store, exceptionTag.[[Address]], wasmPayload).
+    // 9. Set the surrounding agent's associated store to store.
+    auto address = store.allocate(exception_tag->address(), move(wasm_payload));
+    VERIFY(address.has_value());
+
+    // 10. Initialize this from exceptionAddr.
+    // 11. If options["traceStack"] is true, set this.[[Stack]] to either a DOMString representation of the current call
+    //     stack or undefined.
+    // 12. Otherwise, set this.[[Stack]] to undefined.
+    Optional<Utf16String> stack;
+    if (options.trace_stack) {
+        auto error = JS::Error::create(realm);
+        stack = error->stack_string();
+    }
+    return WebAssembly::Exception::create(move(cache), *address, move(stack));
+}
+
+// https://webassembly.github.io/spec/js-api/#dom-exception-getarg
+WebIDL::ExceptionOr<JS::Value> get_arg(JS::Realm& realm, WebAssembly::Exception& exception, GC::Ref<WebAssembly::Tag> exception_tag, u32 index)
+{
+    // 1. If this.[[Type]] is not equal to exceptionTag.[[Address]], throw a TypeError.
+    if (!exception.is(exception_tag))
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "The exception does not have this tag"_utf16 };
+
+    auto& store = exception.cache().abstract_machine().store();
+    auto* exception_instance = store.get(exception.address());
+    VERIFY(exception_instance);
+
+    // 2. Let payload be this.[[Payload]].
+    auto& payload = exception_instance->params();
+
+    // 3. If index ≥ payload's size, throw a RangeError.
+    if (index >= payload.size())
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::RangeError, Utf16String::formatted("The exception has {} values", payload.size()) };
+
+    // 4. Let [types] → [] be tag_type(store, exceptionTag.[[Address]]).
+    auto* tag_instance = store.get(exception_tag->address());
+    VERIFY(tag_instance);
+    auto const& type = tag_instance->type().parameters()[index];
+
+    // 5. If types[index] matches v128 or exnref, throw a TypeError.
+    if (is_unsupported_exception_value_type(type))
+        return WebIDL::SimpleException { WebIDL::SimpleExceptionType::TypeError, "Cannot read this value type from an exception"_utf16 };
+
+    // 6. Return ToJSValue(payload[index]).
+    auto value = payload[index];
+    return WebAssembly::Detail::to_js_value(realm, value, type);
+}
+
+WebAssembly::Exception* exception_from_value(JS::Value value)
+{
+    return value.is_object() ? Bindings::impl_from<WebAssembly::Exception>(&value.as_object()) : nullptr;
+}
+
+}
