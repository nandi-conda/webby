+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/Utf16String.h>
+#include <AK/Variant.h>
+#include <LibWasm/AbstractMachine/AbstractMachine.h>
+#include <LibWeb/Bindings/Wrappable.h>
+#include <LibWeb/WebAssembly/WebAssembly.h>
+
+namespace Web::WebAssembly {
+
+class Tag;
+
+// https://webassembly.github.io/spec/js-api/#exceptions
+class Exception : public Bindings::GCAllocatedWrappable {
+    WEB_WRAPPABLE(Exception, Bindings::GCAllocatedWrappable);
+    GC_DECLARE_ALLOCATOR(Exception);
+
+public:
+    static GC::Ref<Exception> create(NonnullRefPtr<Detail::WebAssemblyCache>, Wasm::ExceptionAddress, Optional<Utf16String> stack);
+    // The Exception object of an exception, which is the same object for as long as the cache lives.
+    static GC::Ref<Exception> from_address(NonnullRefPtr<Detail::WebAssemblyCache>, Wasm::ExceptionAddress);
+
+    Wasm::ExceptionAddress address() const { return m_address; }
+    Wasm::TagAddress tag_address() const;
+    Detail::WebAssemblyCache& cache() const { return *m_cache; }
+
+    bool is(GC::Ref<Tag>) const;
+    Variant<Utf16String, Empty> stack() const;
+
+private:
+    Exception(NonnullRefPtr<Detail::WebAssemblyCache>, Wasm::ExceptionAddress, Optional<Utf16String> stack);
+
+    virtual void visit_edges(Visitor&) override;
+
+    NonnullRefPtr<Detail::WebAssemblyCache> m_cache;
+    Wasm::ExceptionAddress m_address;
+    Optional<Utf16String> m_stack;
+};
+
+}
