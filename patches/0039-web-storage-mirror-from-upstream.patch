+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+    // Every file: document keeps its storage in one shared bottle (its storage key is the file: origin, whatever the
+    // path), so a change one of them makes has to fire the storage event in the others — in this process and in any
+    // other — the same as for two documents of one http origin.
+    //
+    // That one bottle is shared with every other file: test running at the same time, too. So this test writes a key
+    // of its own, the iframe reports only the events for that key, and nothing here clears the bottle. The iframe
+    // acknowledges the key before the parent writes: the message and the storage event come from different task
+    // sources, so nothing else orders them.
+    asyncTest(done => {
+        const key = "storage-events-reach-another-file-document-" + Date.now() + "-" + Math.random();
+        window.addEventListener("message", event => {
+            if (event.data === "ready") {
+                localStorage.setItem(key, "between-file-documents");
+                return;
+            }
+            println("iframe got storage event: " + event.data);
+            localStorage.removeItem(key);
+            done();
+        });
+        const iframe = document.createElement("iframe");
+        iframe.src = "../../data/storage-event-file-document-iframe.html";
+        iframe.onload = () => iframe.contentWindow.postMessage(key, "*");
+        document.body.appendChild(iframe);
+    });
+</script>
diff --git a/Tests/LibWeb/Text/input/HTML/storage-shared-across-same-origin-frames.html b/Tests/LibWeb/Text/input/HTML/storage-shared-across-same-origin-frames.html
new file mode 100644
index 0000000000..8e3deae75a
--- /dev/null
+++ b/Tests/LibWeb/Text/input/HTML/storage-shared-across-same-origin-frames.html
@@ -0,0 +1,48 @@
+<!DOCTYPE html>
+<script src="../include.js"></script>
+<script>
+    // Every bottle one page makes for a storage key has to answer from the same process-local cache — session storage
+    // included, which is partitioned per page. So a same-origin iframe and its parent must see one session map and one
+    // local map, in both directions and with no reload in between: a write in either frame is visible to a read in the
+    // other, and so is a removal.
+    asyncTest(done => {
+        sessionStorage.clear();
+        localStorage.clear();
+        sessionStorage.setItem("from-parent", "s1");
+        localStorage.setItem("from-parent", "l1");
+
+        window.addEventListener("message", event => {
+            const report = event.data;
+            println("child read session from-parent: " + report.session);
+            println("child read local from-parent: " + report.local);
+            println("parent read session from-child: " + sessionStorage.getItem("from-child"));
+            println("parent read local from-child: " + localStorage.getItem("from-child"));
+            println("parent session keys: " + Object.keys(sessionStorage).sort().join(","));
+            println("parent local keys: " + Object.keys(localStorage).sort().join(","));
+            println("child session keys: " + report.sessionKeys);
+            println("child local keys: " + report.localKeys);
+            sessionStorage.removeItem("from-parent");
+            localStorage.removeItem("from-parent");
+            println("child sees removal: " + event.source.sessionStorage.getItem("from-parent") + " " + event.source.localStorage.getItem("from-parent"));
+            println("child session length after removal: " + event.source.sessionStorage.length);
+            sessionStorage.clear();
+            localStorage.clear();
+            done();
+        });
+
+        const iframe = document.createElement("iframe");
+        iframe.srcdoc = `<script>
+            const session = sessionStorage.getItem("from-parent");
+            const local = localStorage.getItem("from-parent");
+            sessionStorage.setItem("from-child", "s2");
+            localStorage.setItem("from-child", "l2");
+            parent.postMessage({
+                session,
+                local,
+                sessionKeys: Object.keys(sessionStorage).sort().join(","),
+                localKeys: Object.keys(localStorage).sort().join(","),
+            }, "*");
+        <\/script>`;
+        document.body.appendChild(iframe);
+    });
+</script>
diff --git a/Tests/LibWeb/Text/input/SiteIsolation/iframe/storage-events-cross-processes.html b/Tests/LibWeb/Text/input/SiteIsolation/iframe/storage-events-cross-processes.html
new file mode 100644
index 0000000000..69d4cd564e
--- /dev/null
+++ b/Tests/LibWeb/Text/input/SiteIsolation/iframe/storage-events-cross-processes.html
@@ -0,0 +1,191 @@
+<!DOCTYPE html>
+<script src="../../include.js"></script>
+<script>
+    // A storage event has to reach every same-origin window, in whatever process it lives: the browser relays each
+    // change to every process mirroring the storage, and that process fires the event on its own Storage objects. The
+    // peer below never touches localStorage before listening, so listening alone has to connect it. The actor drives
+    // the peer over a BroadcastChannel and reports to this page; the peer reports every event it gets as it gets it,
+    // and the actor waits for the expected count before moving on.
+    //
+    // The peer runs in a second process because it's opened with noopener on a cross-site trampoline host, and the
+    // trampoline's navigation to the same-origin peer page is a cross-site top-level navigation in a browsing context
+    // group of one — which site isolation hands to a new WebContent process.
+    asyncTest(async (done) => {
+        const httpServer = httpTestServer();
+        const host = uniqueLocalhostHostname("storage-events");
+        const runId = crypto.randomUUID();
+        const channelName = `storage-events-${runId}`;
+        const htmlHeaders = { "Content-Type": "text/html" };
+
+        const describeEvent = `
+            const describe = (e) => ({
+                type: "event",
+                key: e.key,
+                oldValue: e.oldValue === null ? null : (e.oldValue.length > 64 ? "<" + e.oldValue.length + " chars>" : e.oldValue),
+                newValue: e.newValue === null ? null : (e.newValue.length > 64 ? "<" + e.newValue.length + " chars>" : e.newValue),
+                url: e.url,
+                isLocalStorage: e.storageArea === localStorage,
+            });`;
+
+        const peerUrl = new URL(
+            await httpServer.createEcho("GET", `/storage-events-peer-${runId}`, {
+                status: 200,
+                headers: htmlHeaders,
+                body: `<!DOCTYPE html><script>
+                    ${describeEvent}
+                    const channel = new BroadcastChannel(${JSON.stringify(channelName)});
+                    addEventListener("storage", (e) => channel.postMessage(describe(e)));
+                    channel.onmessage = (e) => {
+                        const command = e.data;
+                        if (command.op === "keys") {
+                            channel.postMessage({ type: "keys", keys: Object.keys(localStorage).sort() });
+                        } else if (command.op === "setBig") {
+                            let threw = false;
+                            try {
+                                localStorage.setItem(command.key, "p".repeat(command.size));
+                            } catch {
+                                threw = true;
+                            }
+                            channel.postMessage({ type: "written", threw });
+                        } else if (command.op === "close") {
+                            window.close();
+                        }
+                    };
+                    channel.postMessage({ type: "ready" });
+                <\/script>`,
+            })
+        );
+        peerUrl.hostname = host;
+
+        const trampolineUrl = new URL(
+            await httpServer.createEcho("GET", `/storage-events-trampoline-${runId}`, {
+                status: 200,
+                headers: htmlHeaders,
+                body: `<!DOCTYPE html><script>location.replace(${JSON.stringify(peerUrl.href)});<\/script>`,
+            })
+        );
+        trampolineUrl.hostname = uniqueLocalhostHostname("storage-events-trampoline");
+
+        const actorUrl = new URL(
+            await httpServer.createEcho("GET", `/storage-events-actor-${runId}`, {
+                status: 200,
+                headers: htmlHeaders,
+                body: `<!DOCTYPE html><script>
+                    ${describeEvent}
+                    const report = (line) => opener.postMessage(line, "*");
+                    const channel = new BroadcastChannel(${JSON.stringify(channelName)});
+                    const peerEvents = [];
+                    const ownEvents = [];
+                    const replies = [];
+                    let waiter = null;
+                    const wake = () => {
+                        if (waiter && waiter.ready()) {
+                            const resolve = waiter.resolve;
+                            waiter = null;
+                            resolve();
+                        }
+                    };
+                    const waitFor = (ready) => new Promise((resolve) => {
+                        waiter = { ready, resolve };
+                        wake();
+                    });
+                    channel.onmessage = (e) => {
+                        if (e.data.type === "event")
+                            peerEvents.push(e.data);
+                        else
+                            replies.push(e.data);
+                        wake();
+                    };
+                    addEventListener("storage", (e) => {
+                        ownEvents.push(describe(e));
+                        wake();
+                    });
+                    const nextReply = async () => {
+                        await waitFor(() => replies.length > 0);
+                        return replies.shift();
+                    };
+                    const formatEvent = (event) => "key=" + JSON.stringify(event.key)
+                        + " oldValue=" + JSON.stringify(event.oldValue)
+                        + " newValue=" + JSON.stringify(event.newValue)
+                        + " url-is-actor=" + (event.url === location.href)
+                        + " storageArea-is-localStorage=" + event.isLocalStorage;
+                    (async () => {
+                        localStorage.clear();
+                        window.open(${JSON.stringify(trampolineUrl.href)}, "_blank", "noopener");
+                        await nextReply();
+
+                        localStorage.setItem("a", "1");
+                        localStorage.setItem("a", "2");
+                        localStorage.setItem("a", "2");
+                        localStorage.removeItem("a");
+                        localStorage.setItem("b", "1");
+                        localStorage.clear();
+                        await waitFor(() => peerEvents.length >= 5);
+                        for (const event of peerEvents)
+                            report("peer saw " + formatEvent(event));
+                        report("peer saw " + peerEvents.length + " events for 6 operations (one changed nothing)");
+                        peerEvents.length = 0;
+
+                        // Two writes that fit alone but not together, each made from a mirror that can't know about the
+                        // other. The actor posts the peer's command and writes in the same task, so the command reaches
+                        // the peer ahead of the actor's change — but the peer handles the command in a queued task,
+                        // while a change is applied the moment it arrives, so the peer may or may not already see the
+                        // actor's write by then. Three outcomes are possible, and every line below holds in each: the
+                        // browser keeps exactly one of the two writes, both sides agree on which, and a write the
+                        // browser refused after its own window accepted it is reverted there with a storage event — on
+                        // the window that wrote it, which is the one that most needs to know. A "keys" round trip
+                        // settles both sides: it's handled after every change either side had in flight.
+                        const size = 3 * 1024 * 1024;
+                        const peerWritten = nextReply();
+                        channel.postMessage({ op: "setBig", key: "peerBig", size });
+                        let actorThrew = false;
+                        try {
+                            localStorage.setItem("actorBig", "a".repeat(size));
+                        } catch {
+                            actorThrew = true;
+                        }
+                        const peerThrew = (await peerWritten).threw;
+                        channel.postMessage({ op: "keys" });
+                        const peerKeys = (await nextReply()).keys;
+                        const actorKeys = Object.keys(localStorage).sort();
+                        const bigKey = (key) => key === "actorBig" || key === "peerBig";
+                        const actorBigKeys = actorKeys.filter(bigKey);
+                        const peerBigKeys = peerKeys.filter(bigKey);
+                        report("racing writes: at most one write was refused outright: " + !(actorThrew && peerThrew));
+                        report("racing writes: exactly one 3 MiB key kept, and both sides agree on which: " + (actorBigKeys.length === 1 && peerBigKeys.length === 1 && actorBigKeys[0] === peerBigKeys[0]));
+                        const kept = actorBigKeys[0];
+                        const accepted = [...peerEvents, ...ownEvents].filter((event) => bigKey(event.key) && event.newValue !== null);
+                        const reverted = [...peerEvents, ...ownEvents].filter((event) => bigKey(event.key) && event.newValue === null);
+                        const keptOnActor = kept === "actorBig";
+                        report("racing writes: the kept write reached the other side as one storage event: " + (accepted.length === 1 && accepted[0].key === kept && accepted[0].newValue === "<" + size + " chars>" && (keptOnActor ? peerEvents : ownEvents).includes(accepted[0])));
+                        // The other write was either refused outright by its own mirror (then nothing was ever applied,
+                        // and nothing reverts) or accepted there and refused by the browser (then its window reverts).
+                        const refusedOutright = actorThrew || peerThrew;
+                        const loserEvents = keptOnActor ? peerEvents : ownEvents;
+                        const revertedRight = refusedOutright
+                            ? reverted.length === 0
+                            : reverted.length === 1 && reverted[0].key !== kept && reverted[0].oldValue === "<" + size + " chars>" && reverted[0].isLocalStorage && loserEvents.includes(reverted[0]);
+                        report("racing writes: a write the browser refused after its window accepted it was reverted there with a storage event, and nothing else was: " + revertedRight);
+                        report("racing writes: no other events: " + (peerEvents.length + ownEvents.length === accepted.length + reverted.length));
+
+                        localStorage.clear();
+                        channel.postMessage({ op: "close" });
+                        report("done");
+                    })();
+                <\/script>`,
+            })
+        );
+        actorUrl.hostname = host;
+
+        let actor = null;
+        addEventListener("message", (event) => {
+            if (event.data === "done") {
+                actor.close();
+                done();
+                return;
+            }
+            println(event.data);
+        });
+        actor = window.open(actorUrl);
+    });
+</script>
diff --git a/Tests/LibWeb/Text/input/SiteIsolation/iframe/storage-mirrors-stay-consistent-across-processes.html b/Tests/LibWeb/Text/input/SiteIsolation/iframe/storage-mirrors-stay-consistent-across-processes.html
new file mode 100644
index 0000000000..dd972103bc
--- /dev/null
+++ b/Tests/LibWeb/Text/input/SiteIsolation/iframe/storage-mirrors-stay-consistent-across-processes.html
@@ -0,0 +1,186 @@
+<!DOCTYPE html>
+<script src="../../include.js"></script>
+<script>
+    // Each process answers web storage from a mirror of it, and the browser relays every change to every other process
+    // mirroring it. So two same-origin documents in two processes have to see each other's writes, overwrites,
+    // removals, and clears on their next read, keys and length included. And a write a process accepts from a stale
+    // mirror, but the browser then refuses, has to vanish from that process on its next read. The actor popup reports
+    // each observation to this page, and drives the peer over a BroadcastChannel.
+    //
+    // The peer runs in a second process because it's opened with noopener on a cross-site trampoline host, and the
+    // trampoline's navigation to the same-origin peer page is a cross-site top-level navigation in a browsing context
+    // group of one — which site isolation hands to a new WebContent process. A popup's first navigation away from
+    // about:blank stays in its opener's process, so opening the peer page directly would leave both in one process.
+    asyncTest(async (done) => {
+        const httpServer = httpTestServer();
+        const host = uniqueLocalhostHostname("storage-cache");
+        const runId = crypto.randomUUID();
+        const channelName = `storage-cache-${runId}`;
+        const htmlHeaders = { "Content-Type": "text/html" };
+
+        const snapshotSource = `
+            const snapshot = () => {
+                const entries = [];
+                for (let i = 0; i < localStorage.length; ++i) {
+                    const key = localStorage.key(i);
+                    entries.push(key + "=" + localStorage.getItem(key));
+                }
+                return "length " + localStorage.length + (entries.length ? ": " + entries.sort().join(",") : "");
+            };
+            const keys = () => {
+                const names = [];
+                for (let i = 0; i < localStorage.length; ++i)
+                    names.push(localStorage.key(i));
+                return names.sort();
+            };
+            const trySet = (key, value) => {
+                try {
+                    localStorage.setItem(key, value);
+                    return false;
+                } catch {
+                    return true;
+                }
+            };`;
+
+        const peerUrl = new URL(
+            await httpServer.createEcho("GET", `/storage-cache-peer-${runId}`, {
+                status: 200,
+                headers: htmlHeaders,
+                body: `<!DOCTYPE html><script>
+                    ${snapshotSource}
+                    const channel = new BroadcastChannel(${JSON.stringify(channelName)});
+                    channel.onmessage = (e) => {
+                        const command = e.data;
+                        if (command.op === "set")
+                            localStorage.setItem(command.key, command.value);
+                        else if (command.op === "remove")
+                            localStorage.removeItem(command.key);
+                        else if (command.op === "clear")
+                            localStorage.clear();
+                        else if (command.op === "setBig") {
+                            const threw = trySet(command.key, "p".repeat(command.size));
+                            return channel.postMessage({ type: "written", threw });
+                        }
+                        else if (command.op === "keys")
+                            return channel.postMessage({ type: "keys", keys: keys() });
+                        else if (command.op === "close")
+                            return window.close();
+                        channel.postMessage({ type: "snapshot", snapshot: snapshot() });
+                    };
+                    // Load this process's mirror before the actor writes anything: that copy is what has to be kept current.
+                    snapshot();
+                    channel.postMessage({ type: "ready" });
+                <\/script>`,
+            })
+        );
+        peerUrl.hostname = host;
+
+        const trampolineUrl = new URL(
+            await httpServer.createEcho("GET", `/storage-cache-trampoline-${runId}`, {
+                status: 200,
+                headers: htmlHeaders,
+                body: `<!DOCTYPE html><script>location.replace(${JSON.stringify(peerUrl.href)});<\/script>`,
+            })
+        );
+        trampolineUrl.hostname = uniqueLocalhostHostname("storage-cache-trampoline");
+
+        const actorUrl = new URL(
+            await httpServer.createEcho("GET", `/storage-cache-actor-${runId}`, {
+                status: 200,
+                headers: htmlHeaders,
+                body: `<!DOCTYPE html><script>
+                    ${snapshotSource}
+                    const report = (line) => opener.postMessage(line, "*");
+                    const channel = new BroadcastChannel(${JSON.stringify(channelName)});
+                    const replies = [];
+                    let waiter = null;
+                    const wake = () => {
+                        if (waiter && waiter.ready()) {
+                            const resolve = waiter.resolve;
+                            waiter = null;
+                            resolve();
+                        }
+                    };
+                    const waitFor = (ready) => new Promise((resolve) => {
+                        waiter = { ready, resolve };
+                        wake();
+                    });
+                    channel.onmessage = (e) => {
+                        replies.push(e.data);
+                        wake();
+                    };
+                    const nextReply = async () => {
+                        await waitFor(() => replies.length > 0);
+                        return replies.shift();
+                    };
+                    const ask = async (command) => {
+                        channel.postMessage(command);
+                        return nextReply();
+                    };
+                    const peerSnapshot = async () => (await ask({ op: "snapshot" })).snapshot;
+                    (async () => {
+                        localStorage.clear();
+                        snapshot();
+                        window.open(${JSON.stringify(trampolineUrl.href)}, "_blank", "noopener");
+                        await nextReply();
+                        report("peer initial: " + await peerSnapshot());
+                        localStorage.setItem("a", "1");
+                        report("after actor sets a=1, peer sees " + await peerSnapshot());
+                        await ask({ op: "set", key: "b", value: "2" });
+                        report("after peer sets b=2, actor sees " + snapshot());
+                        localStorage.setItem("a", "3");
+                        report("after actor overwrites a=3, peer sees " + await peerSnapshot());
+                        await ask({ op: "set", key: "b", value: "4" });
+                        report("after peer overwrites b=4, actor sees " + snapshot());
+                        localStorage.removeItem("a");
+                        report("after actor removes a, peer sees " + await peerSnapshot());
+                        await ask({ op: "remove", key: "b" });
+                        report("after peer removes b, actor sees " + snapshot());
+                        localStorage.setItem("c", "5");
+                        await ask({ op: "set", key: "d", value: "6" });
+                        report("after actor sets c=5 and peer sets d=6, actor sees " + snapshot());
+                        report("after actor sets c=5 and peer sets d=6, peer sees " + await peerSnapshot());
+                        await ask({ op: "clear" });
+                        report("after peer clears, actor sees " + snapshot());
+                        localStorage.setItem("e", "7");
+                        localStorage.clear();
+                        report("after actor sets e=7 then clears, peer sees " + await peerSnapshot());
+                        // Two writes that fit alone but not together, each made from a mirror that can't know about the
+                        // other. The actor posts the peer's command and writes in the same task, so the command reaches
+                        // the peer ahead of the actor's change — but the peer handles the command in a queued task,
+                        // while a change is applied the moment it arrives, so the peer may or may not already see the
+                        // actor's write by then. Whichever way it goes, the browser keeps exactly one of the two writes
+                        // and both sides agree on which; the "keys" round trip settles both sides first, since it's
+                        // handled after every change either side had in flight.
+                        const size = 3 * 1024 * 1024;
+                        const peerWritten = ask({ op: "setBig", key: "peerBig", size });
+                        const actorThrew = trySet("actorBig", "a".repeat(size));
+                        const peerThrew = (await peerWritten).threw;
+                        const bothWrote = "after both write 3 MiB at once from stale mirrors, ";
+                        report(bothWrote + "at most one write was refused outright: " + !(actorThrew && peerThrew));
+                        const peerKeys = (await ask({ op: "keys" })).keys;
+                        const actorKeys = keys();
+                        const bigKeys = ["actorBig", "peerBig"];
+                        const kept = actorKeys.map((key) => (bigKeys.includes(key) ? "a 3 MiB write" : key));
+                        report(bothWrote + "actor keeps " + kept.length + " key: " + kept.join(","));
+                        report(bothWrote + "peer agrees: " + (peerKeys.join(",") === actorKeys.join(",")));
+                        channel.postMessage({ op: "close" });
+                        report("done");
+                    })();
+                <\/script>`,
+            })
+        );
+        actorUrl.hostname = host;
+
+        let actor = null;
+        addEventListener("message", (event) => {
+            if (event.data === "done") {
+                actor.close();
+                done();
+                return;
+            }
+            println(event.data);
+        });
+        actor = window.open(actorUrl);
+    });
+</script>
