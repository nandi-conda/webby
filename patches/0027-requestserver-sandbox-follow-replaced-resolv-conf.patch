+    // webby: Landlock binds to inodes, and NetworkManager, resolvconf and VPN clients replace resolv.conf (and editors
+    // replace hosts) with a new file rather than rewriting it. glibc notices the change, cannot open the new file,
+    // and falls back to a nameserver on 127.0.0.1, so every lookup fails until the browser restarts. Grant the
+    // directories those files are replaced in instead: /etc, and wherever a resolv.conf symlink points.
+    TRY(Sandbox::add_landlock_path_if_exists(paths, "/etc"sv, Sandbox::LandlockPath::Access::ReadOnly));
+    if (char* resolv_conf = realpath("/etc/resolv.conf", nullptr)) {
+        auto directory = LexicalPath::dirname(ByteString { resolv_conf });
+        free(resolv_conf);
+        TRY(Sandbox::add_landlock_path_if_exists(paths, directory, Sandbox::LandlockPath::Access::ReadOnly));
