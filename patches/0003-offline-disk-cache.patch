+
+bool Request::offline_mode()
+{
+    return s_offline_mode;
+}
+
+// webby: offline, a fetch may only be answered from the disk cache. OnlyIfCached opens expired entries without
+// revalidating them, and a miss fails at once instead of waiting for a connection that can't succeed.
+static HTTP::CacheMode effective_cache_mode(HTTP::CacheMode cache_mode, RequestType type)
+{
+    if (!s_offline_mode || type != RequestType::Fetch)
+        return cache_mode;
+    return HTTP::CacheMode::OnlyIfCached;
+}
 
