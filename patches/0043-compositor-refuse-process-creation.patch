+void SeccompPolicy::refuse_process_creation()
+{
+    // webby: Fail an attempt to start a process with EPERM instead of killing the process. The NVIDIA EGL driver
+    //        (libnvidia-glsi) posix_spawn()s a helper the first time a display is initialized, which in the Compositor
+    //        happens for the first WebGL context, long after the sandbox is in place. posix_spawn() reports the error and
+    //        the driver carries on without its helper. Thread clones are allowed earlier in the filter (allow_threads()),
+    //        so only clones that would make a new process reach this.
+#ifdef __NR_clone
+    append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_clone, 0, 1));
+    append(SECCOMP_ERRNO(EPERM));
+#endif
+#ifdef __NR_clone3
+    append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_clone3, 0, 1));
+    append(SECCOMP_ERRNO(ENOSYS));
+#endif
+#ifdef __NR_fork
+    append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_fork, 0, 1));
+    append(SECCOMP_ERRNO(EPERM));
+#endif
+#ifdef __NR_vfork
+    append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_vfork, 0, 1));
+    append(SECCOMP_ERRNO(EPERM));
+#endif
+#ifdef __NR_execve
+    append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_execve, 0, 1));
+    append(SECCOMP_ERRNO(EPERM));
+#endif
+#ifdef __NR_execveat
+    append(BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_execveat, 0, 1));
+    append(SECCOMP_ERRNO(EPERM));
+#endif
+}
+
 void SeccompPolicy::allow_threads()
 {
 #ifdef __NR_clone
