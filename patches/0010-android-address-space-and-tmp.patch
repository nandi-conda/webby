+++ b/Libraries/LibCore/StandardPaths.cpp
@@ -251,6 +251,11 @@ ByteString StandardPaths::tempfile_directory()
 {
 #if defined(AK_OS_WINDOWS)
     return getenv("TEMP");
+#elif defined(AK_OS_ANDROID)
+    // Apps cannot write to /tmp; the host points TMPDIR at its cache directory.
+    if (auto* tmpdir = getenv("TMPDIR"); tmpdir && *tmpdir)
+        return tmpdir;
+    return "/data/local/tmp";
 #else
     return "/tmp";
 #endif
