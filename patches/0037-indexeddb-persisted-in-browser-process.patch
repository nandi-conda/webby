diff --git a/Libraries/LibWebView/IndexedDBStore.cpp b/Libraries/LibWebView/IndexedDBStore.cpp
new file mode 100644
index 0000000000..a361734dac
--- /dev/null
+++ b/Libraries/LibWebView/IndexedDBStore.cpp
@@ -0,0 +1,555 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Array.h>
+#include <AK/HashMap.h>
+#include <LibDatabase/Database.h>
+#include <LibWebView/IndexedDBStore.h>
+#include <LibWebView/WebContentClient.h>
+#include <LibWebView/WebWorkerClient.h>
+
+namespace WebView {
+
+using Web::IndexedDB::PersistedDatabase;
+using Web::IndexedDB::PersistedDatabaseChanges;
+using Web::IndexedDB::PersistedIndex;
+using Web::IndexedDB::PersistedKeyPath;
+using Web::IndexedDB::PersistedObjectStore;
+using Web::IndexedDB::PersistedUpgradeLock;
+
+static constexpr u32 INDEXED_DB_SCHEMA_BASELINE_VERSION = 1u;
+
+ErrorOr<Database::MigrationOutcome> IndexedDBStore::migrate_schema(Database::Database& database, Database::MigrationMode mode)
+{
+    auto migrations = to_array<Database::Migration>({
+        {
+            .version = INDEXED_DB_SCHEMA_BASELINE_VERSION,
+            .sql = R"#(
+                CREATE TABLE IF NOT EXISTS IndexedDBDatabases (
+                    storage_key TEXT,
+                    name TEXT,
+                    version INTEGER,
+                    last_access_time INTEGER,
+                    PRIMARY KEY(storage_key, name)
+                );
+                CREATE TABLE IF NOT EXISTS IndexedDBObjectStores (
+                    storage_key TEXT,
+                    database_name TEXT,
+                    name TEXT,
+                    key_path_type INTEGER,
+                    key_path TEXT,
+                    key_generator INTEGER,
+                    PRIMARY KEY(storage_key, database_name, name)
+                );
+                CREATE TABLE IF NOT EXISTS IndexedDBIndexes (
+                    storage_key TEXT,
+                    database_name TEXT,
+                    object_store_name TEXT,
+                    name TEXT,
+                    key_path_type INTEGER,
+                    key_path TEXT,
+                    is_unique INTEGER,
+                    multi_entry INTEGER,
+                    PRIMARY KEY(storage_key, database_name, object_store_name, name)
+                );
+                CREATE TABLE IF NOT EXISTS IndexedDBRecords (
+                    storage_key TEXT,
+                    database_name TEXT,
+                    object_store_name TEXT,
+                    key BLOB,
+                    value BLOB,
+                    PRIMARY KEY(storage_key, database_name, object_store_name, key)
+                );
+                CREATE TABLE IF NOT EXISTS IndexedDBIndexRecords (
+                    storage_key TEXT,
+                    database_name TEXT,
+                    object_store_name TEXT,
+                    index_name TEXT,
+                    key BLOB,
+                    primary_key BLOB,
+                    PRIMARY KEY(storage_key, database_name, object_store_name, index_name, key, primary_key)
+                );
+            )#"sv,
+        },
+    });
+
+    return database.migrate("IndexedDB"sv, migrations, mode);
+}
+
+ErrorOr<NonnullOwnPtr<IndexedDBStore>> IndexedDBStore::create(Database::Database& database)
+{
+    Statements statements {};
+
+    statements.select_databases = TRY(database.prepare_statement("SELECT name, version FROM IndexedDBDatabases WHERE storage_key = ?;"sv));
+    statements.select_database_version = TRY(database.prepare_statement("SELECT version FROM IndexedDBDatabases WHERE storage_key = ? AND name = ?;"sv));
+    statements.select_object_stores = TRY(database.prepare_statement("SELECT database_name, name, key_path_type, key_path, COALESCE(key_generator, -1) FROM IndexedDBObjectStores WHERE storage_key = ?;"sv));
+    statements.select_indexes = TRY(database.prepare_statement("SELECT database_name, object_store_name, name, key_path_type, key_path, is_unique, multi_entry FROM IndexedDBIndexes WHERE storage_key = ?;"sv));
+    statements.select_records = TRY(database.prepare_statement("SELECT database_name, object_store_name, key, value FROM IndexedDBRecords WHERE storage_key = ?;"sv));
+    statements.select_index_records = TRY(database.prepare_statement("SELECT database_name, object_store_name, index_name, key, primary_key FROM IndexedDBIndexRecords WHERE storage_key = ?;"sv));
+    statements.touch_database = TRY(database.prepare_statement("UPDATE IndexedDBDatabases SET last_access_time = ? WHERE storage_key = ? AND name = ?;"sv));
+    statements.insert_database = TRY(database.prepare_statement("INSERT OR REPLACE INTO IndexedDBDatabases (storage_key, name, version, last_access_time) VALUES (?, ?, ?, ?);"sv));
+    statements.insert_object_store = TRY(database.prepare_statement("INSERT OR REPLACE INTO IndexedDBObjectStores (storage_key, database_name, name, key_path_type, key_path, key_generator) VALUES (?, ?, ?, ?, ?, ?);"sv));
+    statements.insert_index = TRY(database.prepare_statement("INSERT OR REPLACE INTO IndexedDBIndexes (storage_key, database_name, object_store_name, name, key_path_type, key_path, is_unique, multi_entry) VALUES (?, ?, ?, ?, ?, ?, ?, ?);"sv));
+    statements.insert_record = TRY(database.prepare_statement("INSERT OR REPLACE INTO IndexedDBRecords (storage_key, database_name, object_store_name, key, value) VALUES (?, ?, ?, ?, ?);"sv));
+    statements.insert_index_record = TRY(database.prepare_statement("INSERT OR REPLACE INTO IndexedDBIndexRecords (storage_key, database_name, object_store_name, index_name, key, primary_key) VALUES (?, ?, ?, ?, ?, ?);"sv));
+    statements.delete_record = TRY(database.prepare_statement("DELETE FROM IndexedDBRecords WHERE storage_key = ? AND database_name = ? AND object_store_name = ? AND key = ?;"sv));
+    statements.delete_index_record = TRY(database.prepare_statement("DELETE FROM IndexedDBIndexRecords WHERE storage_key = ? AND database_name = ? AND object_store_name = ? AND index_name = ? AND key = ? AND primary_key = ?;"sv));
+    statements.update_key_generator = TRY(database.prepare_statement("UPDATE IndexedDBObjectStores SET key_generator = ? WHERE storage_key = ? AND database_name = ? AND name = ?;"sv));
+    statements.delete_database = TRY(database.prepare_statement("DELETE FROM IndexedDBDatabases WHERE storage_key = ? AND name = ?;"sv));
+    statements.delete_object_stores = TRY(database.prepare_statement("DELETE FROM IndexedDBObjectStores WHERE storage_key = ? AND database_name = ?;"sv));
+    statements.delete_indexes = TRY(database.prepare_statement("DELETE FROM IndexedDBIndexes WHERE storage_key = ? AND database_name = ?;"sv));
+    statements.delete_records = TRY(database.prepare_statement("DELETE FROM IndexedDBRecords WHERE storage_key = ? AND database_name = ?;"sv));
+    statements.delete_index_records = TRY(database.prepare_statement("DELETE FROM IndexedDBIndexRecords WHERE storage_key = ? AND database_name = ?;"sv));
+    statements.select_databases_accessed_since = TRY(database.prepare_statement("SELECT storage_key, name FROM IndexedDBDatabases WHERE last_access_time >= ?;"sv));
+    statements.estimate_size_accessed_since = TRY(database.prepare_statement(R"#(
+        SELECT COALESCE(SUM(LENGTH(r.key) + LENGTH(r.value)), 0) FROM IndexedDBRecords r
+        JOIN IndexedDBDatabases d ON d.storage_key = r.storage_key AND d.name = r.database_name
+        WHERE d.last_access_time >= ?;
+    )#"sv));
+
+    return adopt_own(*new IndexedDBStore { database, statements });
+}
+
+NonnullOwnPtr<IndexedDBStore> IndexedDBStore::create()
+{
+    auto database = MUST(Database::Database::create_memory_backed());
+    MUST(migrate_schema(*database, Database::MigrationMode::Apply));
+    return MUST(create(*database));
+}
+
+IndexedDBStore::IndexedDBStore(NonnullRefPtr<Database::Database> database, Statements statements)
+    : m_database(move(database))
+    , m_statements(statements)
+{
+}
+
+IndexedDBStore::~IndexedDBStore() = default;
+
+// A key path is stored as its type (0: none, 1: a string, 2: a list of strings) and its text, a list's strings joined
+// by commas (key path identifiers cannot contain one).
+enum class KeyPathType : u8 {
+    None = 0,
+    String = 1,
+    List = 2,
+};
+
+static Utf16String key_path_text(PersistedKeyPath const& key_path)
+{
+    return key_path.visit(
+        [](Utf16String const& string) { return string; },
+        [](Vector<Utf16String> const& strings) { return Utf16String::join(","sv, strings); });
+}
+
+static u8 key_path_type(Optional<PersistedKeyPath> const& key_path)
+{
+    if (!key_path.has_value())
+        return to_underlying(KeyPathType::None);
+    return to_underlying(key_path->has<Utf16String>() ? KeyPathType::String : KeyPathType::List);
+}
+
+static Optional<PersistedKeyPath> key_path_from(i64 type, Utf16String const& text)
+{
+    if (type == to_underlying(KeyPathType::String))
+        return PersistedKeyPath { text };
+    if (type == to_underlying(KeyPathType::List)) {
+        Vector<Utf16String> strings;
+        auto utf8 = text.to_utf8();
+        utf8.bytes_as_string_view().for_each_split_view(',', SplitBehavior::KeepEmpty, [&](StringView part) {
+            strings.append(Utf16String::from_utf8(part));
+        });
+        return PersistedKeyPath { move(strings) };
+    }
+    return {};
+}
+
+static bool is_same_client(IndexedDBClient const& a, IndexedDBClient const& b)
+{
+    if (a.index() != b.index())
+        return false;
+    return a.visit([&](auto const& weak_client) {
+        using ClientType = RemoveCVReference<decltype(weak_client)>;
+        return weak_client.ptr() == b.template get<ClientType>().ptr();
+    });
+}
+
+static i64 to_sql_integer(u64 value)
+{
+    // Versions and key generator numbers are at most 2^53 + 1 (an IndexedDB version is an unsigned long long, but
+    // one above 2^63 would not survive the trip).
+    return static_cast<i64>(min(value, static_cast<u64>(NumericLimits<i64>::max())));
+}
+
+Vector<PersistedDatabase> IndexedDBStore::load(IndexedDBClient const& client, Web::StorageAPI::StorageKey const& storage_key)
+{
+    // From now on, the client hears of every change another process commits to these databases.
+    bool already_subscribed = m_subscribers.find_if([&](auto const& subscriber) {
+        return is_same_client(subscriber.client, client) && subscriber.storage_key == storage_key;
+    }) != m_subscribers.end();
+    if (!already_subscribed)
+        m_subscribers.append({ client, storage_key });
+
+    auto key = storage_key.to_string();
+    auto databases = read_databases(key);
+
+    auto now = UnixDateTime::now();
+    for (auto const& database : databases)
+        m_database->execute_statement(m_statements.touch_database, {}, now, key, database.name);
+
+    return databases;
+}
+
+Optional<u64> IndexedDBStore::stored_version(String const& storage_key, Utf16String const& name)
+{
+    Optional<u64> version;
+    m_database->execute_statement(
+        m_statements.select_database_version,
+        [&](auto statement_id) -> ErrorOr<void> {
+            version = static_cast<u64>(m_database->result_column<i64>(statement_id, 0));
+            return {};
+        },
+        storage_key, name);
+    return version;
+}
+
+Vector<Utf16String> IndexedDBStore::read_database_names(String const& key)
+{
+    Vector<Utf16String> names;
+    m_database->execute_statement(
+        m_statements.select_databases,
+        [&](auto statement_id) -> ErrorOr<void> {
+            names.append(m_database->result_column<Utf16String>(statement_id, 0));
+            return {};
+        },
+        key);
+    return names;
+}
+
+Vector<PersistedDatabase> IndexedDBStore::read_databases(String const& key)
+{
+    Vector<PersistedDatabase> databases;
+    HashMap<Utf16String, size_t> database_indices;
+
+    m_database->execute_statement(
+        m_statements.select_databases,
+        [&](auto statement_id) -> ErrorOr<void> {
+            PersistedDatabase database;
+            database.name = m_database->result_column<Utf16String>(statement_id, 0);
+            database.version = static_cast<u64>(m_database->result_column<i64>(statement_id, 1));
+            database_indices.set(database.name, databases.size());
+            databases.append(move(database));
+            return {};
+        },
+        key);
+
+    auto object_store = [&](Utf16String const& database_name, Utf16String const& name) -> PersistedObjectStore* {
+        auto index = database_indices.get(database_name);
+        if (!index.has_value())
+            return nullptr;
+        for (auto& store : databases[*index].object_stores) {
+            if (store.name == name)
+                return &store;
+        }
+        return nullptr;
+    };
+
+    m_database->execute_statement(
+        m_statements.select_object_stores,
+        [&](auto statement_id) -> ErrorOr<void> {
+            auto database_name = m_database->result_column<Utf16String>(statement_id, 0);
+            auto index = database_indices.get(database_name);
+            if (!index.has_value())
+                return {};
+            PersistedObjectStore store;
+            store.name = m_database->result_column<Utf16String>(statement_id, 1);
+            store.key_path = key_path_from(m_database->result_column<i64>(statement_id, 2), m_database->result_column<Utf16String>(statement_id, 3));
+            if (auto key_generator = m_database->result_column<i64>(statement_id, 4); key_generator >= 0)
+                store.key_generator = static_cast<u64>(key_generator);
+            databases[*index].object_stores.append(move(store));
+            return {};
+        },
+        key);
+
+    m_database->execute_statement(
+        m_statements.select_indexes,
+        [&](auto statement_id) -> ErrorOr<void> {
+            auto* store = object_store(m_database->result_column<Utf16String>(statement_id, 0), m_database->result_column<Utf16String>(statement_id, 1));
+            if (!store)
+                return {};
+            auto key_path = key_path_from(m_database->result_column<i64>(statement_id, 3), m_database->result_column<Utf16String>(statement_id, 4));
+            if (!key_path.has_value())
+                return {};
+            PersistedIndex index;
+            index.name = m_database->result_column<Utf16String>(statement_id, 2);
+            index.key_path = key_path.release_value();
+            index.unique = m_database->result_column<i64>(statement_id, 5) != 0;
+            index.multi_entry = m_database->result_column<i64>(statement_id, 6) != 0;
+            store->indexes.append(move(index));
+            return {};
+        },
+        key);
+
+    m_database->execute_statement(
+        m_statements.select_records,
+        [&](auto statement_id) -> ErrorOr<void> {
+            auto* store = object_store(m_database->result_column<Utf16String>(statement_id, 0), m_database->result_column<Utf16String>(statement_id, 1));
+            if (!store)
+                return {};
+            store->records.append({ m_database->result_column<ByteBuffer>(statement_id, 2), m_database->result_column<ByteBuffer>(statement_id, 3) });
+            return {};
+        },
+        key);
+
+    m_database->execute_statement(
+        m_statements.select_index_records,
+        [&](auto statement_id) -> ErrorOr<void> {
+            auto* store = object_store(m_database->result_column<Utf16String>(statement_id, 0), m_database->result_column<Utf16String>(statement_id, 1));
+            if (!store)
+                return {};
+            auto index_name = m_database->result_column<Utf16String>(statement_id, 2);
+            for (auto& index : store->indexes) {
+                if (index.name == index_name) {
+                    index.records.append({ m_database->result_column<ByteBuffer>(statement_id, 3), m_database->result_column<ByteBuffer>(statement_id, 4) });
+                    break;
+                }
+            }
+            return {};
+        },
+        key);
+
+    return databases;
+}
+
+void IndexedDBStore::delete_database_rows(String const& storage_key, Utf16String const& name)
+{
+    m_database->execute_statement(m_statements.delete_database, {}, storage_key, name);
+    m_database->execute_statement(m_statements.delete_object_stores, {}, storage_key, name);
+    m_database->execute_statement(m_statements.delete_indexes, {}, storage_key, name);
+    m_database->execute_statement(m_statements.delete_records, {}, storage_key, name);
+    m_database->execute_statement(m_statements.delete_index_records, {}, storage_key, name);
+}
+
+void IndexedDBStore::insert_database_rows(String const& storage_key, PersistedDatabase const& database)
+{
+    m_database->execute_statement(m_statements.insert_database, {}, storage_key, database.name, to_sql_integer(database.version), UnixDateTime::now());
+
+    for (auto const& store : database.object_stores) {
+        // A store without a key generator has none (NULL).
+        Optional<i64> key_generator;
+        if (store.key_generator.has_value())
+            key_generator = to_sql_integer(*store.key_generator);
+        auto key_path = store.key_path.has_value() ? key_path_text(*store.key_path) : Utf16String {};
+        m_database->execute_statement(m_statements.insert_object_store, {}, storage_key, database.name, store.name, key_path_type(store.key_path), key_path, key_generator);
+
+        for (auto const& record : store.records)
+            m_database->execute_statement(m_statements.insert_record, {}, storage_key, database.name, store.name, record.key, record.value);
+
+        for (auto const& index : store.indexes) {
+            m_database->execute_statement(m_statements.insert_index, {}, storage_key, database.name, store.name, index.name,
+                key_path_type(index.key_path), key_path_text(index.key_path), index.unique, index.multi_entry);
+            for (auto const& record : index.records)
+                m_database->execute_statement(m_statements.insert_index_record, {}, storage_key, database.name, store.name, index.name, record.key, record.primary_key);
+        }
+    }
+}
+
+void IndexedDBStore::update_database_rows(String const& storage_key, PersistedDatabaseChanges const& changes)
+{
+    for (auto const& store : changes.object_stores) {
+        for (auto const& key : store.deleted)
+            m_database->execute_statement(m_statements.delete_record, {}, storage_key, changes.name, store.name, key);
+        for (auto const& record : store.stored)
+            m_database->execute_statement(m_statements.insert_record, {}, storage_key, changes.name, store.name, record.key, record.value);
+
+        for (auto const& index : store.indexes) {
+            for (auto const& record : index.deleted)
+                m_database->execute_statement(m_statements.delete_index_record, {}, storage_key, changes.name, store.name, index.name, record.key, record.primary_key);
+            for (auto const& record : index.stored)
+                m_database->execute_statement(m_statements.insert_index_record, {}, storage_key, changes.name, store.name, index.name, record.key, record.primary_key);
+        }
+
+        if (store.key_generator.has_value())
+            m_database->execute_statement(m_statements.update_key_generator, {}, to_sql_integer(*store.key_generator), storage_key, changes.name, store.name);
+    }
+
+    m_database->execute_statement(m_statements.touch_database, {}, UnixDateTime::now(), storage_key, changes.name);
+}
+
+void IndexedDBStore::commit(IndexedDBClient const& client, Web::StorageAPI::StorageKey const& storage_key, u64 commit_id, PersistedDatabaseChanges const& changes)
+{
+    auto key = storage_key.to_string();
+
+    // An upgrade (or a write) to a database that has since changed under the committer is refused.
+    bool refused = false;
+    auto version = stored_version(key, changes.name);
+    if (changes.kind == PersistedDatabaseChanges::Kind::Replace)
+        refused = version.value_or(0) != changes.base_version;
+    else if (changes.kind == PersistedDatabaseChanges::Kind::Update)
+        refused = !version.has_value();
+
+    auto result = m_database->transaction([&]() -> ErrorOr<void> {
+        if (refused)
+            return {};
+        switch (changes.kind) {
+        case PersistedDatabaseChanges::Kind::Replace:
+            delete_database_rows(key, changes.name);
+            if (changes.replacement.has_value())
+                insert_database_rows(key, *changes.replacement);
+            break;
+        case PersistedDatabaseChanges::Kind::Delete:
+            delete_database_rows(key, changes.name);
+            break;
+        case PersistedDatabaseChanges::Kind::Update:
+            update_database_rows(key, changes);
+            break;
+        }
+        return {};
+    });
+    if (result.is_error())
+        dbgln("IndexedDBStore: Unable to store changes to database '{}' of {}: {}", changes.name, key, result.error());
+
+    // The committer hears that its changes are in, after any change another process committed before them, so it knows
+    // which of those its own change supersedes.
+    client.visit([&](auto const& weak_client) {
+        if (auto strong_client = weak_client.strong_ref())
+            strong_client->async_indexed_database_changes_persisted(commit_id);
+    });
+
+    if (refused) {
+        // The committer gets the database as it is stored, which supersedes what it has.
+        PersistedDatabaseChanges current;
+        current.name = changes.name;
+        current.kind = PersistedDatabaseChanges::Kind::Delete;
+        if (version.has_value()) {
+            for (auto& database : read_databases(key)) {
+                if (database.name == changes.name) {
+                    current.kind = PersistedDatabaseChanges::Kind::Replace;
+                    current.base_version = changes.base_version;
+                    current.replacement = move(database);
+                    break;
+                }
+            }
+        }
+        client.visit([&](auto const& weak_client) {
+            if (auto strong_client = weak_client.strong_ref())
+                strong_client->async_indexed_database_changed(storage_key, current);
+        });
+        return;
+    }
+
+    send_to_subscribers(storage_key, &client, changes);
+}
+
+PersistedUpgradeLock IndexedDBStore::lock_for_upgrade(IndexedDBClient const& client, Web::StorageAPI::StorageKey const& storage_key, Utf16String const& name)
+{
+    // A lock whose holder went away is free.
+    m_upgrade_locks.remove_all_matching([](auto const& lock) {
+        return lock.client.visit([](auto const& weak_client) { return weak_client.is_null(); });
+    });
+
+    auto holder = m_upgrade_locks.find_if([&](auto const& lock) {
+        return lock.storage_key == storage_key && lock.name == name;
+    });
+    if (holder != m_upgrade_locks.end() && !is_same_client(holder->client, client))
+        return { false, {} };
+    if (holder == m_upgrade_locks.end())
+        m_upgrade_locks.append({ client, storage_key, name });
+
+    return { true, stored_version(storage_key.to_string(), name) };
+}
+
+void IndexedDBStore::release_upgrade_lock(IndexedDBClient const& client, Web::StorageAPI::StorageKey const& storage_key, Utf16String const& name)
+{
+    m_upgrade_locks.remove_all_matching([&](auto const& lock) {
+        return lock.storage_key == storage_key && lock.name == name && is_same_client(lock.client, client);
+    });
+}
+
+void IndexedDBStore::send_to_subscribers(Web::StorageAPI::StorageKey const& storage_key, IndexedDBClient const* except, PersistedDatabaseChanges const& changes)
+{
+    m_subscribers.remove_all_matching([](auto const& subscriber) {
+        return subscriber.client.visit([](auto const& weak_client) { return weak_client.is_null(); });
+    });
+
+    for (auto const& subscriber : m_subscribers) {
+        if (!(subscriber.storage_key == storage_key))
+            continue;
+        if (except && is_same_client(subscriber.client, *except))
+            continue;
+        subscriber.client.visit([&](auto const& weak_client) {
+            if (auto strong_client = weak_client.strong_ref())
+                strong_client->async_indexed_database_changed(storage_key, changes);
+        });
+    }
+}
+
+void IndexedDBStore::remove_databases_accessed_since(UnixDateTime since)
+{
+    Vector<RemovedDatabase> removed;
+
+    m_database->execute_statement(
+        m_statements.select_databases_accessed_since,
+        [&](auto statement_id) -> ErrorOr<void> {
+            removed.append({ m_database->result_column<String>(statement_id, 0), m_database->result_column<Utf16String>(statement_id, 1) });
+            return {};
+        },
+        since);
+
+    remove_databases(removed);
+}
+
+void IndexedDBStore::remove_databases_of(Web::StorageAPI::StorageKey const& storage_key)
+{
+    auto key = storage_key.to_string();
+    Vector<RemovedDatabase> removed;
+    for (auto const& database : read_database_names(key))
+        removed.append({ key, database });
+    remove_databases(removed);
+}
+
+void IndexedDBStore::remove_databases(Vector<RemovedDatabase> const& removed)
+{
+    auto result = m_database->transaction([&]() -> ErrorOr<void> {
+        for (auto const& database : removed)
+            delete_database_rows(database.storage_key, database.name);
+        return {};
+    });
+    if (result.is_error())
+        dbgln("IndexedDBStore: Unable to remove databases: {}", result.error());
+
+    // Processes that hold a removed database drop it too.
+    for (auto const& database : removed) {
+        PersistedDatabaseChanges changes;
+        changes.kind = PersistedDatabaseChanges::Kind::Delete;
+        changes.name = database.name;
+
+        Vector<Web::StorageAPI::StorageKey> storage_keys;
+        for (auto const& subscriber : m_subscribers) {
+            if (subscriber.storage_key.to_string() == database.storage_key && !storage_keys.contains_slow(subscriber.storage_key))
+                storage_keys.append(subscriber.storage_key);
+        }
+        for (auto const& storage_key : storage_keys)
+            send_to_subscribers(storage_key, nullptr, changes);
+    }
+}
+
+Requests::CacheSizes IndexedDBStore::estimate_storage_size_accessed_since(UnixDateTime since) const
+{
+    Requests::CacheSizes sizes;
+
+    m_database->execute_statement(
+        m_statements.estimate_size_accessed_since,
+        [&](auto statement_id) -> ErrorOr<void> { sizes.since_requested_time = static_cast<u64>(m_database->result_column<i64>(statement_id, 0)); return {}; },
+        since);
+
+    m_database->execute_statement(
+        m_statements.estimate_size_accessed_since,
+        [&](auto statement_id) -> ErrorOr<void> { sizes.total = static_cast<u64>(m_database->result_column<i64>(statement_id, 0)); return {}; },
+        UnixDateTime::earliest());
+
+    return sizes;
+}
+
+}
