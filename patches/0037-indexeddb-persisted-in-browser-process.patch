@@ -0,0 +1,177 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibIPC/Decoder.h>
+#include <LibIPC/Encoder.h>
+#include <LibWebCommon/IndexedDB/PersistedDatabase.h>
+
+namespace IPC {
+
+using namespace Web::IndexedDB;
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedRecord const& record)
+{
+    TRY(encoder.encode(record.key));
+    TRY(encoder.encode(record.value));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedRecord> decode(Decoder& decoder)
+{
+    auto key = TRY(decoder.decode<ByteBuffer>());
+    auto value = TRY(decoder.decode<ByteBuffer>());
+    return PersistedRecord { move(key), move(value) };
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedIndexRecord const& record)
+{
+    TRY(encoder.encode(record.key));
+    TRY(encoder.encode(record.primary_key));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedIndexRecord> decode(Decoder& decoder)
+{
+    auto key = TRY(decoder.decode<ByteBuffer>());
+    auto primary_key = TRY(decoder.decode<ByteBuffer>());
+    return PersistedIndexRecord { move(key), move(primary_key) };
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedIndex const& index)
+{
+    TRY(encoder.encode(index.name));
+    TRY(encoder.encode(index.key_path));
+    TRY(encoder.encode(index.unique));
+    TRY(encoder.encode(index.multi_entry));
+    TRY(encoder.encode(index.records));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedIndex> decode(Decoder& decoder)
+{
+    PersistedIndex index;
+    index.name = TRY(decoder.decode<Utf16String>());
+    index.key_path = TRY(decoder.decode<PersistedKeyPath>());
+    index.unique = TRY(decoder.decode<bool>());
+    index.multi_entry = TRY(decoder.decode<bool>());
+    index.records = TRY(decoder.decode<Vector<PersistedIndexRecord>>());
+    return index;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedObjectStore const& store)
+{
+    TRY(encoder.encode(store.name));
+    TRY(encoder.encode(store.key_path));
+    TRY(encoder.encode(store.key_generator));
+    TRY(encoder.encode(store.records));
+    TRY(encoder.encode(store.indexes));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedObjectStore> decode(Decoder& decoder)
+{
+    PersistedObjectStore store;
+    store.name = TRY(decoder.decode<Utf16String>());
+    store.key_path = TRY(decoder.decode<Optional<PersistedKeyPath>>());
+    store.key_generator = TRY(decoder.decode<Optional<u64>>());
+    store.records = TRY(decoder.decode<Vector<PersistedRecord>>());
+    store.indexes = TRY(decoder.decode<Vector<PersistedIndex>>());
+    return store;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedDatabase const& database)
+{
+    TRY(encoder.encode(database.name));
+    TRY(encoder.encode(database.version));
+    TRY(encoder.encode(database.object_stores));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedDatabase> decode(Decoder& decoder)
+{
+    PersistedDatabase database;
+    database.name = TRY(decoder.decode<Utf16String>());
+    database.version = TRY(decoder.decode<u64>());
+    database.object_stores = TRY(decoder.decode<Vector<PersistedObjectStore>>());
+    return database;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedIndexChanges const& changes)
+{
+    TRY(encoder.encode(changes.name));
+    TRY(encoder.encode(changes.stored));
+    TRY(encoder.encode(changes.deleted));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedIndexChanges> decode(Decoder& decoder)
+{
+    PersistedIndexChanges changes;
+    changes.name = TRY(decoder.decode<Utf16String>());
+    changes.stored = TRY(decoder.decode<Vector<PersistedIndexRecord>>());
+    changes.deleted = TRY(decoder.decode<Vector<PersistedIndexRecord>>());
+    return changes;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedObjectStoreChanges const& changes)
+{
+    TRY(encoder.encode(changes.name));
+    TRY(encoder.encode(changes.key_generator));
+    TRY(encoder.encode(changes.stored));
+    TRY(encoder.encode(changes.deleted));
+    TRY(encoder.encode(changes.indexes));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedObjectStoreChanges> decode(Decoder& decoder)
+{
+    PersistedObjectStoreChanges changes;
+    changes.name = TRY(decoder.decode<Utf16String>());
+    changes.key_generator = TRY(decoder.decode<Optional<u64>>());
+    changes.stored = TRY(decoder.decode<Vector<PersistedRecord>>());
+    changes.deleted = TRY(decoder.decode<Vector<ByteBuffer>>());
+    changes.indexes = TRY(decoder.decode<Vector<PersistedIndexChanges>>());
+    return changes;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedDatabaseChanges const& changes)
+{
+    TRY(encoder.encode(changes.kind));
+    TRY(encoder.encode(changes.name));
+    TRY(encoder.encode(changes.base_version));
+    TRY(encoder.encode(changes.replacement));
+    TRY(encoder.encode(changes.object_stores));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedDatabaseChanges> decode(Decoder& decoder)
+{
+    PersistedDatabaseChanges changes;
+    changes.kind = TRY(decoder.decode<PersistedDatabaseChanges::Kind>());
+    changes.name = TRY(decoder.decode<Utf16String>());
+    changes.base_version = TRY(decoder.decode<u64>());
+    changes.replacement = TRY(decoder.decode<Optional<PersistedDatabase>>());
+    changes.object_stores = TRY(decoder.decode<Vector<PersistedObjectStoreChanges>>());
+    return changes;
+}
+
+}
