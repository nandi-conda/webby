+    bool whole_database { false };
+    Vector<Utf16String> object_store_names;
+    Vector<ByteBuffer> keys;
+};
+
+static HashMap<u64, SentCommit>& sent_commits()
+{
+    static NeverDestroyed<HashMap<u64, SentCommit>> commits;
+    return *commits;
+}
+
+static PendingWrites const* pending_writes_for(StorageAPI::StorageKey const& storage_key, Utf16String const& database_name)
+{
+    auto by_database = pending_writes().find(storage_key);
+    if (by_database == pending_writes().end())
+        return nullptr;
+    auto writes = by_database->value.find(database_name);
+    if (writes == by_database->value.end())
+        return nullptr;
+    return &writes->value;
+}
+
+static bool is_pending(PendingWrites const* writes, Utf16String const& object_store_name, ByteBuffer const& key)
+{
+    if (!writes)
+        return false;
+    auto keys = writes->keys.find(object_store_name);
+    if (keys == writes->keys.end())
+        return false;
+    return keys->value.contains(key);
+}
+
+static void send_commit(JS::Realm& realm, StorageAPI::StorageKey const& storage_key, PersistedDatabaseChanges const& changes)
+{
+    static u64 next_commit_id = 1;
+    auto commit_id = next_commit_id++;
+
+    SentCommit sent { storage_key, changes.name, changes.kind != PersistedDatabaseChanges::Kind::Update, {}, {} };
+    auto& writes = pending_writes().ensure(storage_key).ensure(changes.name);
+
+    if (sent.whole_database) {
+        ++writes.whole_database;
+    } else {
+        auto note_key = [&](Utf16String const& object_store_name, ByteBuffer const& key) {
+            ++writes.keys.ensure(object_store_name).ensure(key, [] { return 0u; });
+            sent.object_store_names.append(object_store_name);
+            sent.keys.append(key);
+        };
+        for (auto const& store : changes.object_stores) {
+            for (auto const& record : store.stored)
+                note_key(store.name, record.key);
+            for (auto const& key : store.deleted)
+                note_key(store.name, key);
+        }
+    }
+
+    sent_commits().set(commit_id, move(sent));
+
+    auto& environment = HTML::relevant_settings_object(realm.global_object());
+    Bindings::principal_host_defined_page(realm).client().page_did_commit_indexed_database_changes(environment.id, commit_id, changes);
+}
+
+void did_persist_database_changes(u64 commit_id)
+{
+    auto sent = sent_commits().take(commit_id);
+    if (!sent.has_value())
+        return;
+
+    auto by_database = pending_writes().find(sent->storage_key);
+    if (by_database == pending_writes().end())
+        return;
+    auto writes = by_database->value.find(sent->database_name);
+    if (writes == by_database->value.end())
+        return;
+
+    if (sent->whole_database && writes->value.whole_database > 0)
+        --writes->value.whole_database;
+
+    for (size_t i = 0; i < sent->keys.size(); ++i) {
+        auto keys = writes->value.keys.find(sent->object_store_names[i]);
+        if (keys == writes->value.keys.end())
+            continue;
+        auto count = keys->value.find(sent->keys[i]);
+        if (count == keys->value.end())
+            continue;
+        if (--count->value == 0)
+            keys->value.remove(count);
+        if (keys->value.is_empty())
+            writes->value.keys.remove(keys);
+    }
+
+    if (writes->value.is_empty())
+        by_database->value.remove(writes);
+    if (by_database->value.is_empty())
+        pending_writes().remove(by_database);
+}
+
+static int compare_index_records(IndexRecord const& a, IndexRecord const& b)
+{
+    if (auto result = Key::compare_two_keys(a.key, b.key); result != 0)
+        return result;
+    return Key::compare_two_keys(a.value, b.value);
+}
+
+static GC::Ref<Database> install_database(StorageAPI::StorageKey const& storage_key, PersistedDatabase const& persisted)
+{
+    GC::DeferGC defer_gc { GC::Heap::the() };
+
+    auto database = MUST(Database::create_for_key_and_name(GC::Heap::the(), storage_key, persisted.name));
+    database->set_version(persisted.version);
+
+    for (auto const& persisted_store : persisted.object_stores) {
+        auto store = ObjectStore::create(database, persisted_store.name, persisted_store.key_generator.has_value(), persisted_store.key_path);
+        if (persisted_store.key_generator.has_value())
+            store->key_generator().set(*persisted_store.key_generator);
+
+        Vector<ObjectStoreRecord> records;
+        records.ensure_capacity(persisted_store.records.size());
+        for (auto const& persisted_record : persisted_store.records) {
+            auto key = decode_key(persisted_record.key);
+            auto value = ByteBuffer::copy(persisted_record.value);
+            if (key.is_error() || value.is_error())
+                continue;
+            records.unchecked_append(ObjectStoreRecord { key.release_value(), make<HTML::StorageSerializationRecord>(value.release_value()) });
+        }
+        quick_sort(records, [](auto const& a, auto const& b) { return Key::less_than(a.key, b.key); });
+        for (auto& record : records)
+            store->store_a_record(move(record));
+
+        for (auto const& persisted_index : persisted_store.indexes) {
+            auto index = Index::create(store, persisted_index.name, persisted_index.key_path, persisted_index.unique, persisted_index.multi_entry);
+
+            Vector<IndexRecord> index_records;
+            index_records.ensure_capacity(persisted_index.records.size());
+            for (auto const& persisted_record : persisted_index.records) {
+                auto key = decode_key(persisted_record.key);
+                auto primary_key = decode_key(persisted_record.primary_key);
+                if (key.is_error() || primary_key.is_error())
+                    continue;
+                index_records.unchecked_append({ key.release_value(), primary_key.release_value() });
+            }
+            quick_sort(index_records, [](auto const& a, auto const& b) { return compare_index_records(a, b) < 0; });
+            for (auto const& record : index_records)
+                index->store_a_record(record);
+        }
+    }
+
+    return database;
+}
+
+void load_persisted_databases(JS::Realm& realm, StorageAPI::StorageKey const& storage_key)
+{
+    if (loaded_storage_keys().contains(storage_key))
+        return;
+    loaded_storage_keys().set(storage_key);
+
+    auto& environment = HTML::relevant_settings_object(realm.global_object());
+    auto databases = Bindings::principal_host_defined_page(realm).client().page_did_request_indexed_databases(environment.id);
+
+    for (auto const& database : databases) {
+        if (Database::for_key_and_name(storage_key, database.name).has_value())
+            continue;
+        install_database(storage_key, database);
+    }
+}
+
+static PersistedDatabase snapshot_of(Database& database)
+{
+    PersistedDatabase persisted;
+    persisted.name = database.name();
+    persisted.version = database.version();
+
+    for (auto const& store : database.object_stores()) {
+        PersistedObjectStore persisted_store;
+        persisted_store.name = store->name();
+        persisted_store.key_path = store->key_path();
+        if (store->uses_a_key_generator())
+            persisted_store.key_generator = store->key_generator().current_number();
+
+        persisted_store.records.ensure_capacity(store->records().size());
+        for (auto const& record : store->records())
+            persisted_store.records.unchecked_append({ encode_key(*record.key), MUST(ByteBuffer::copy(record.value->data)) });
+
+        for (auto const& [name, index] : store->index_set()) {
+            PersistedIndex persisted_index;
+            persisted_index.name = name;
+            persisted_index.key_path = index->key_path();
+            persisted_index.unique = index->unique();
+            persisted_index.multi_entry = index->multi_entry();
+            persisted_index.records.ensure_capacity(index->records().size());
+            for (auto const& record : index->records())
+                persisted_index.records.unchecked_append({ encode_key(*record.key), encode_key(*record.value) });
+            persisted_store.indexes.append(move(persisted_index));
+        }
+
+        persisted.object_stores.append(move(persisted_store));
+    }
+
+    return persisted;
+}
+
+void persist_committed_transaction(IDBTransaction& transaction)
+{
+    if (transaction.mode() == TransactionMode::Readonly)
+        return;
+
+    auto database = transaction.connection()->associated_database();
+    auto const& storage_key = database->storage_key();
+    if (!storage_key.has_value() || !loaded_storage_keys().contains(*storage_key))
+        return;
+
+    // A connection to a database another process has since replaced or deleted writes to what is no longer stored.
+    auto current = Database::for_key_and_name(*storage_key, database->name());
+    if (!current.has_value() || &current.value() != database.ptr())
+        return;
+
+    PersistedDatabaseChanges changes;
+    changes.name = database->name();
+
+    if (transaction.is_upgrade_transaction()) {
+        changes.kind = PersistedDatabaseChanges::Kind::Replace;
+        changes.base_version = transaction.original_version();
+        changes.replacement = snapshot_of(*database);
+    } else {
+        changes.kind = PersistedDatabaseChanges::Kind::Update;
+        transaction.for_each_store_mutation_log([&](ObjectStore& store, MutationLog& log) {
+            PersistedObjectStoreChanges store_changes;
+            if (log.append_persisted_changes(store, store_changes))
+                changes.object_stores.append(move(store_changes));
+        });
+        if (changes.object_stores.is_empty())
+            return;
+    }
+
+    send_commit(HTML::relevant_realm(transaction.relevant_global_object()), *storage_key, changes);
+}
+
+void persist_deleted_database(JS::Realm& realm, StorageAPI::StorageKey const& storage_key, Utf16String const& name)
+{
+    if (!loaded_storage_keys().contains(storage_key))
+        return;
+
+    PersistedDatabaseChanges changes;
+    changes.kind = PersistedDatabaseChanges::Kind::Delete;
+    changes.name = name;
+    send_commit(realm, storage_key, changes);
+}
+
+// Applies what another process changed in database, except where a commit of ours that is not stored yet wrote.
+static void apply_object_store_changes(Database& database, PendingWrites const* writes, PersistedObjectStoreChanges const& changes)
+{
+    auto store = database.object_store_with_name(changes.name);
+    if (!store)
+        return;
+
+    // NB: These changes are already committed, so they are no part of any transaction of ours that may revert.
+    auto saved_log = store->mutation_log();
+    store->set_mutation_log(nullptr);
+
+    for (auto const& encoded_key : changes.deleted) {
+        if (is_pending(writes, changes.name, encoded_key))
+            continue;
+        if (auto key = decode_key(encoded_key); !key.is_error())
+            store->remove_record_with_key(key.value());
+    }
+
+    for (auto const& record : changes.stored) {
+        if (is_pending(writes, changes.name, record.key))
+            continue;
+        auto key = decode_key(record.key);
+        auto value = ByteBuffer::copy(record.value);
+        if (key.is_error() || value.is_error())
+            continue;
+        store->remove_record_with_key(key.value());
+        store->store_a_record(ObjectStoreRecord { key.value(), make<HTML::StorageSerializationRecord>(value.release_value()) });
+    }
+
+    for (auto const& index_changes : changes.indexes) {
+        auto index = store->index_set().get(index_changes.name);
+        if (!index.has_value())
+            continue;
+
+        auto decode_record = [&](PersistedIndexRecord const& record) -> Optional<IndexRecord> {
+            if (is_pending(writes, changes.name, record.primary_key))
+                return {};
+            auto key = decode_key(record.key);
+            auto primary_key = decode_key(record.primary_key);
+            if (key.is_error() || primary_key.is_error())
+                return {};
+            return IndexRecord { key.release_value(), primary_key.release_value() };
+        };
+
+        for (auto const& persisted_record : index_changes.deleted) {
+            if (auto record = decode_record(persisted_record); record.has_value())
+                (*index)->remove_record(*record);
+        }
+        for (auto const& persisted_record : index_changes.stored) {
+            if (auto record = decode_record(persisted_record); record.has_value()) {
+                (*index)->remove_record(*record);
+                (*index)->store_a_record(*record);
+            }
+        }
+    }
+
+    if (changes.key_generator.has_value() && store->uses_a_key_generator() && *changes.key_generator > store->key_generator().current_number())
+        store->key_generator().set(*changes.key_generator);
+
+    store->set_mutation_log(saved_log);
+}
+
+static bool key_paths_match(Optional<KeyPath> const& a, Optional<KeyPath> const& b)
+{
+    if (a.has_value() != b.has_value())
+        return false;
+    if (!a.has_value())
+        return true;
+    if (a->index() != b->index())
+        return false;
+    if (a->has<Utf16String>())
+        return a->get<Utf16String>() == b->get<Utf16String>();
+    return a->get<Vector<Utf16String>>() == b->get<Vector<Utf16String>>();
+}
+
+// Whether database has the version, object stores and indexes of persisted, so the records can be swapped in place.
+static bool has_schema_of(Database& database, PersistedDatabase const& persisted)
+{
+    if (database.version() != persisted.version || database.object_stores().size() != persisted.object_stores.size())
+        return false;
+
+    for (auto const& persisted_store : persisted.object_stores) {
+        auto store = database.object_store_with_name(persisted_store.name);
+        if (!store || !key_paths_match(store->key_path(), persisted_store.key_path) || store->uses_a_key_generator() != persisted_store.key_generator.has_value())
+            return false;
+        if (store->index_set().size() != persisted_store.indexes.size())
+            return false;
+        for (auto const& persisted_index : persisted_store.indexes) {
+            auto index = store->index_set().get(persisted_index.name);
+            if (!index.has_value() || !key_paths_match((*index)->key_path(), persisted_index.key_path) || (*index)->unique() != persisted_index.unique || (*index)->multi_entry() != persisted_index.multi_entry)
+                return false;
+        }
+    }
+    return true;
+}
+
+// Makes database's records those of persisted, as a set of changes: whatever persisted lacks is deleted.
+static void replace_records_in_place(Database& database, PendingWrites const* writes, PersistedDatabase const& persisted)
+{
+    for (auto const& persisted_store : persisted.object_stores) {
+        auto store = database.object_store_with_name(persisted_store.name);
+        VERIFY(store);
+
+        PersistedObjectStoreChanges changes;
+        changes.name = persisted_store.name;
+        changes.key_generator = persisted_store.key_generator;
+        changes.stored = persisted_store.records;
+
+        HashTable<ByteBuffer> persisted_keys;
+        for (auto const& record : persisted_store.records)
+            persisted_keys.set(record.key);
+        for (auto const& record : store->records()) {
+            auto key = encode_key(*record.key);
+            if (!persisted_keys.contains(key))
+                changes.deleted.append(move(key));
+        }
+
+        for (auto const& persisted_index : persisted_store.indexes) {
+            auto index = store->index_set().get(persisted_index.name).value();
+
+            PersistedIndexChanges index_changes;
+            index_changes.name = persisted_index.name;
+            index_changes.stored = persisted_index.records;
+
+            HashTable<ByteBuffer> persisted_records;
+            for (auto const& record : persisted_index.records) {
+                auto pair = record.key;
+                pair.append(record.primary_key.bytes());
+                persisted_records.set(move(pair));
+            }
+            for (auto const& record : index->records()) {
+                PersistedIndexRecord persisted_record { encode_key(*record.key), encode_key(*record.value) };
+                auto pair = persisted_record.key;
+                pair.append(persisted_record.primary_key.bytes());
+                if (!persisted_records.contains(pair))
+                    index_changes.deleted.append(move(persisted_record));
+            }
+
+            changes.indexes.append(move(index_changes));
+        }
+
+        apply_object_store_changes(database, writes, changes);
+    }
+}
+
+// As when a connection in this process upgrades or deletes a database: open connections hear of it first, and those
+// that do not close themselves are closed.
+static void close_connections_to_superseded_database(Database& database, Optional<u64> new_version)
+{
+    auto old_version = database.version();
+    for (auto const& connection : database.associated_connections_as_root_vector()) {
+        if (connection->close_pending())
+            continue;
+        queue_a_database_task(GC::create_function(GC::Heap::the(), [connection, old_version, new_version] {
+            if (connection->close_pending())
+                return;
+            fire_a_version_change_event(HTML::relevant_realm(connection->relevant_global_object()), HTML::EventNames::versionchange, connection, old_version, new_version);
+            if (!connection->close_pending())
+                close_a_database_connection(connection, nullptr, true);
+        }));
+    }
+}
+
+void apply_persisted_database_changes(StorageAPI::StorageKey const& storage_key, PersistedDatabaseChanges changes)
+{
+    if (!loaded_storage_keys().contains(storage_key))
+        return;
+
+    auto const* writes = pending_writes_for(storage_key, changes.name);
+
+    // A replacement or deletion of ours that is not stored yet supersedes this (or, if it is refused, we are sent what
+    // is stored instead).
+    if (writes && writes->whole_database > 0)
+        return;
+
+    auto existing = Database::for_key_and_name(storage_key, changes.name);
+    GC::Ptr<Database> database = existing.has_value() ? &existing.value() : nullptr;
+
+    if (changes.kind == PersistedDatabaseChanges::Kind::Update) {
+        if (database)
+            for (auto const& store_changes : changes.object_stores)
+                apply_object_store_changes(*database, writes, store_changes);
+        return;
+    }
+
+    // An upgrade of ours that is still running replaces the database when it commits, or is refused.
+    if (database && database->upgrade_transaction())
+        return;
+
+    if (changes.kind == PersistedDatabaseChanges::Kind::Replace && changes.replacement.has_value()) {
+        // Another process upgraded the database to what we have (most often: we both created it at once). Our
+        // connections stay open, and only the records change.
+        if (database && has_schema_of(*database, *changes.replacement)) {
+            replace_records_in_place(*database, writes, *changes.replacement);
+            return;
+        }
+    }
+
+    Optional<u64> new_version;
+    if (database)
+        MUST(Database::delete_for_key_and_name(storage_key, changes.name));
+    if (changes.kind == PersistedDatabaseChanges::Kind::Replace && changes.replacement.has_value()) {
+        install_database(storage_key, *changes.replacement);
+        new_version = changes.replacement->version;
+    }
+    if (database)
+        close_connections_to_superseded_database(*database, new_version);
+}
+
+}
