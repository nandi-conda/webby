+++ b/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.h
@@ -0,0 +1,138 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Optional.h>
+#include <AK/Utf16String.h>
+#include <AK/Variant.h>
+#include <AK/Vector.h>
+#include <LibIPC/Forward.h>
+#include <LibWebCommon/Export.h>
+
+// AD-HOC: The browser process keeps every storage key's IndexedDB databases (on disk, unless the session is private),
+//         so that they outlive the processes that use them and every content and worker process sees the same ones.
+//         A process loads a storage key's databases from it once, sends it what each transaction it commits changed,
+//         and is sent what other processes committed. Keys and values are opaque bytes here: LibWeb encodes keys, and
+//         values are storage serialization records.
+namespace Web::IndexedDB {
+
+using PersistedKeyPath = Variant<Utf16String, Vector<Utf16String>>;
+
+struct PersistedRecord {
+    ByteBuffer key;
+    ByteBuffer value;
+};
+
+struct PersistedIndexRecord {
+    ByteBuffer key;
+    ByteBuffer primary_key;
+};
+
+struct PersistedIndex {
+    Utf16String name;
+    PersistedKeyPath key_path { Utf16String {} };
+    bool unique { false };
+    bool multi_entry { false };
+    Vector<PersistedIndexRecord> records;
+};
+
+struct PersistedObjectStore {
+    Utf16String name;
+    Optional<PersistedKeyPath> key_path;
+    // The key generator's current number, if the store has a key generator.
+    Optional<u64> key_generator;
+    Vector<PersistedRecord> records;
+    Vector<PersistedIndex> indexes;
+};
+
+struct PersistedDatabase {
+    Utf16String name;
+    u64 version { 0 };
+    Vector<PersistedObjectStore> object_stores;
+};
+
+struct PersistedIndexChanges {
+    Utf16String name;
+    Vector<PersistedIndexRecord> stored;
+    Vector<PersistedIndexRecord> deleted;
+};
+
+struct PersistedObjectStoreChanges {
+    Utf16String name;
+    Optional<u64> key_generator;
+    // Records stored replace any record with the same key.
+    Vector<PersistedRecord> stored;
+    Vector<ByteBuffer> deleted;
+    Vector<PersistedIndexChanges> indexes;
+};
+
+// What one committed transaction (or a deletion) did to one database.
+struct PersistedDatabaseChanges {
+    enum class Kind : u8 {
+        // An upgrade transaction: the database is now `replacement` in full.
+        Replace,
+        // The database was deleted.
+        Delete,
+        // A readwrite transaction: `object_stores` lists what changed.
+        Update,
+    };
+
+    Kind kind { Kind::Update };
+    Utf16String name;
+    // For Replace: the version the upgrade started from (0 for a new database). The browser process refuses an upgrade
+    // of a database another process upgraded or deleted first, and sends the refused process what it has instead.
+    u64 base_version { 0 };
+    Optional<PersistedDatabase> replacement;
+    Vector<PersistedObjectStoreChanges> object_stores;
+};
+
+}
+
+namespace IPC {
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedRecord const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedRecord> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedIndexRecord const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedIndexRecord> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedIndex const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedIndex> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedObjectStore const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedObjectStore> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedDatabase const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedDatabase> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedIndexChanges const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedIndexChanges> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedObjectStoreChanges const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedObjectStoreChanges> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedDatabaseChanges const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedDatabaseChanges> decode(Decoder&);
+
+}
