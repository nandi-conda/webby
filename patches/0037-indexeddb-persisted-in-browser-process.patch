+++ b/Libraries/LibWeb/IndexedDB/Persistence.cpp
@@ -0,0 +1,386 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/ByteBuffer.h>
+#include <AK/Endian.h>
+#include <LibGC/Function.h>
+#include <LibGC/Heap.h>
+#include <LibJS/HostClassBuilder.h>
+#include <LibJS/Runtime/Realm.h>
+#include <LibURL/RustIntegration.h>
+#include <LibWeb/Bindings/MainThreadVM.h>
+#include <LibWeb/Bindings/PrincipalHostDefined.h>
+#include <LibWeb/HTML/Scripting/Environments.h>
+#include <LibWeb/IndexedDB/Persistence.h>
+#include <LibWeb/Page/Page.h>
+#include <LibWeb/Platform/Timer.h>
+
+// The persisted databases and changes cross to Rust as bytes, in this layout (little-endian): u32 counts and lengths,
+// strings as their UTF-16 code units, byte strings as their bytes, an optional as a presence byte then the value, a key
+// path as a tag byte (0: string, 1: sequence) then the string or the strings. Kept in step with persistence.rs.
+
+using namespace Web;
+using namespace Web::IndexedDB;
+
+namespace {
+
+class Writer {
+public:
+    void u8(::u8 value) { m_buffer.append(value); }
+    void u32(::u32 value)
+    {
+        LittleEndian<::u32> le = value;
+        m_buffer.append(&le, sizeof(le));
+    }
+    void u64(::u64 value)
+    {
+        LittleEndian<::u64> le = value;
+        m_buffer.append(&le, sizeof(le));
+    }
+    void boolean(bool value) { u8(value ? 1 : 0); }
+    void bytes(ReadonlyBytes value)
+    {
+        u32(value.size());
+        m_buffer.append(value);
+    }
+    void string(Utf16String const& value)
+    {
+        auto view = value.utf16_view();
+        u32(view.length_in_code_units());
+        for (size_t i = 0; i < view.length_in_code_units(); ++i) {
+            LittleEndian<u16> code_unit = view.code_unit_at(i);
+            m_buffer.append(&code_unit, sizeof(code_unit));
+        }
+    }
+    void key_path(PersistedKeyPath const& value)
+    {
+        value.visit(
+            [&](Utf16String const& string) {
+                u8(0);
+                string_(string);
+            },
+            [&](Vector<Utf16String> const& strings) {
+                u8(1);
+                u32(strings.size());
+                for (auto const& string : strings)
+                    string_(string);
+            });
+    }
+    void optional_u64(Optional<::u64> const& value)
+    {
+        boolean(value.has_value());
+        if (value.has_value())
+            u64(*value);
+    }
+
+    void database(PersistedDatabase const& database)
+    {
+        string(database.name);
+        u64(database.version);
+        u32(database.object_stores.size());
+        for (auto const& store : database.object_stores) {
+            string(store.name);
+            boolean(store.key_path.has_value());
+            if (store.key_path.has_value())
+                key_path(*store.key_path);
+            optional_u64(store.key_generator);
+            u32(store.records.size());
+            for (auto const& record : store.records) {
+                bytes(record.key);
+                bytes(record.value);
+            }
+            u32(store.indexes.size());
+            for (auto const& index : store.indexes) {
+                string(index.name);
+                key_path(index.key_path);
+                boolean(index.unique);
+                boolean(index.multi_entry);
+                u32(index.records.size());
+                for (auto const& record : index.records) {
+                    bytes(record.key);
+                    bytes(record.primary_key);
+                }
+            }
+        }
+    }
+
+    void index_records(Vector<PersistedIndexRecord> const& records)
+    {
+        u32(records.size());
+        for (auto const& record : records) {
+            bytes(record.key);
+            bytes(record.primary_key);
+        }
+    }
+
+    void changes(PersistedDatabaseChanges const& changes)
+    {
+        u8(to_underlying(changes.kind));
+        string(changes.name);
+        u64(changes.base_version);
+        boolean(changes.replacement.has_value());
+        if (changes.replacement.has_value())
+            database(*changes.replacement);
+        u32(changes.object_stores.size());
+        for (auto const& store : changes.object_stores) {
+            string(store.name);
+            optional_u64(store.key_generator);
+            u32(store.stored.size());
+            for (auto const& record : store.stored) {
+                bytes(record.key);
+                bytes(record.value);
+            }
+            u32(store.deleted.size());
+            for (auto const& key : store.deleted)
+                bytes(key);
+            u32(store.indexes.size());
+            for (auto const& index : store.indexes) {
+                string(index.name);
+                index_records(index.stored);
+                index_records(index.deleted);
+            }
+        }
+    }
+
+    ByteBuffer& buffer() { return m_buffer; }
+
+private:
+    void string_(Utf16String const& value) { string(value); }
+
+    ByteBuffer m_buffer;
+};
+
+class Reader {
+public:
+    explicit Reader(ReadonlyBytes bytes)
+        : m_bytes(bytes)
+    {
+    }
+
+    bool is_at_end() const { return m_offset == m_bytes.size(); }
+
+    ErrorOr<ReadonlyBytes> take(size_t count)
+    {
+        if (count > m_bytes.size() - m_offset)
+            return Error::from_string_literal("Truncated IndexedDB persistence data");
+        auto bytes = m_bytes.slice(m_offset, count);
+        m_offset += count;
+        return bytes;
+    }
+
+    ErrorOr<::u64> little_endian(size_t size)
+    {
+        auto bytes = TRY(take(size));
+        ::u64 value = 0;
+        for (size_t i = 0; i < size; ++i)
+            value |= static_cast<::u64>(bytes[i]) << (8 * i);
+        return value;
+    }
+
+    ErrorOr<::u8> u8() { return TRY(take(1))[0]; }
+    ErrorOr<::u32> u32() { return static_cast<::u32>(TRY(little_endian(4))); }
+    ErrorOr<::u64> u64() { return TRY(little_endian(8)); }
+    ErrorOr<bool> boolean() { return TRY(u8()) != 0; }
+    ErrorOr<ByteBuffer> bytes() { return ByteBuffer::copy(TRY(take(TRY(u32())))); }
+    ErrorOr<Utf16String> string()
+    {
+        auto length = TRY(u32());
+        Vector<char16_t> code_units;
+        TRY(code_units.try_ensure_capacity(length));
+        for (::u32 i = 0; i < length; ++i)
+            code_units.unchecked_append(static_cast<char16_t>(TRY(little_endian(2))));
+        return Utf16String::from_utf16(Utf16View { code_units.data(), code_units.size() });
+    }
+    ErrorOr<PersistedKeyPath> key_path()
+    {
+        if (TRY(u8()) == 0)
+            return PersistedKeyPath { TRY(string()) };
+        auto count = TRY(u32());
+        Vector<Utf16String> strings;
+        for (::u32 i = 0; i < count; ++i)
+            strings.append(TRY(string()));
+        return PersistedKeyPath { move(strings) };
+    }
+    ErrorOr<Optional<::u64>> optional_u64()
+    {
+        if (!TRY(boolean()))
+            return Optional<::u64> {};
+        return Optional<::u64> { TRY(u64()) };
+    }
+
+    ErrorOr<PersistedDatabase> database()
+    {
+        PersistedDatabase database;
+        database.name = TRY(string());
+        database.version = TRY(u64());
+        auto store_count = TRY(u32());
+        for (::u32 i = 0; i < store_count; ++i) {
+            PersistedObjectStore store;
+            store.name = TRY(string());
+            if (TRY(boolean()))
+                store.key_path = TRY(key_path());
+            store.key_generator = TRY(optional_u64());
+            auto record_count = TRY(u32());
+            for (::u32 j = 0; j < record_count; ++j) {
+                auto key = TRY(bytes());
+                auto value = TRY(bytes());
+                store.records.append({ move(key), move(value) });
+            }
+            auto index_count = TRY(u32());
+            for (::u32 j = 0; j < index_count; ++j) {
+                PersistedIndex index;
+                index.name = TRY(string());
+                index.key_path = TRY(key_path());
+                index.unique = TRY(boolean());
+                index.multi_entry = TRY(boolean());
+                index.records = TRY(index_records());
+                store.indexes.append(move(index));
+            }
+            database.object_stores.append(move(store));
+        }
+        return database;
+    }
+
+    ErrorOr<Vector<PersistedIndexRecord>> index_records()
+    {
+        Vector<PersistedIndexRecord> records;
+        auto count = TRY(u32());
+        for (::u32 i = 0; i < count; ++i) {
+            auto key = TRY(bytes());
+            auto primary_key = TRY(bytes());
+            records.append({ move(key), move(primary_key) });
+        }
+        return records;
+    }
+
+    ErrorOr<PersistedDatabaseChanges> changes()
+    {
+        PersistedDatabaseChanges changes;
+        auto kind = TRY(u8());
+        if (kind > to_underlying(PersistedDatabaseChanges::Kind::Update))
+            return Error::from_string_literal("Unknown IndexedDB change kind");
+        changes.kind = static_cast<PersistedDatabaseChanges::Kind>(kind);
+        changes.name = TRY(string());
+        changes.base_version = TRY(u64());
+        if (TRY(boolean()))
+            changes.replacement = TRY(database());
+        auto store_count = TRY(u32());
+        for (::u32 i = 0; i < store_count; ++i) {
+            PersistedObjectStoreChanges store;
+            store.name = TRY(string());
+            store.key_generator = TRY(optional_u64());
+            auto stored_count = TRY(u32());
+            for (::u32 j = 0; j < stored_count; ++j) {
+                auto key = TRY(bytes());
+                auto value = TRY(bytes());
+                store.stored.append({ move(key), move(value) });
+            }
+            auto deleted_count = TRY(u32());
+            for (::u32 j = 0; j < deleted_count; ++j)
+                store.deleted.append(TRY(bytes()));
+            auto index_count = TRY(u32());
+            for (::u32 j = 0; j < index_count; ++j) {
+                PersistedIndexChanges index;
+                index.name = TRY(string());
+                index.stored = TRY(index_records());
+                index.deleted = TRY(index_records());
+                store.indexes.append(move(index));
+            }
+            changes.object_stores.append(move(store));
+        }
+        return changes;
+    }
+
+private:
+    ReadonlyBytes m_bytes;
+    size_t m_offset { 0 };
+};
+
+Page& page_of(void* realm)
+{
+    return Bindings::principal_host_defined_page(*static_cast<JS::Realm*>(realm));
+}
+
+HTML::EnvironmentId environment_id_of(void* realm)
+{
+    return HTML::relevant_settings_object(static_cast<JS::Realm*>(realm)->global_object()).id;
+}
+
+}
+
+extern "C" {
+
+void web_rust_indexed_db_apply_persisted_changes(JSVM*, URL::FFI::FfiOrigin const*, ReadonlyBytes changes);
+void web_rust_indexed_db_did_persist_changes(JSVM*, u64 commit_id);
+
+void web_indexed_db_request_persisted_databases(void* realm, void* ctx, void (*on_bytes)(void*, ReadonlyBytes));
+void web_indexed_db_commit_persisted_changes(void* realm, u64 commit_id, ReadonlyBytes changes);
+void web_indexed_db_request_upgrade_lock(void* realm, FlatPtr name, bool* granted, bool* has_stored_version, u64* stored_version);
+void web_indexed_db_release_upgrade_lock(void* realm, FlatPtr name);
+void web_indexed_db_run_after(void* cell, u32 milliseconds, void (*steps)(JSVM*, void*));
+}
+
+void web_indexed_db_request_persisted_databases(void* realm, void* ctx, void (*on_bytes)(void*, ReadonlyBytes))
+{
+    auto databases = page_of(realm).client().page_did_request_indexed_databases(environment_id_of(realm));
+    Writer writer;
+    writer.u32(databases.size());
+    for (auto const& database : databases)
+        writer.database(database);
+    on_bytes(ctx, writer.buffer().bytes());
+}
+
+void web_indexed_db_commit_persisted_changes(void* realm, u64 commit_id, ReadonlyBytes bytes)
+{
+    Reader reader { bytes };
+    auto changes = reader.changes();
+    if (changes.is_error() || !reader.is_at_end()) {
+        dbgln("IndexedDB: Could not read the changes of commit {} to persist", commit_id);
+        return;
+    }
+    page_of(realm).client().page_did_commit_indexed_database_changes(environment_id_of(realm), commit_id, changes.value());
+}
+
+void web_indexed_db_request_upgrade_lock(void* realm, FlatPtr name, bool* granted, bool* has_stored_version, u64* stored_version)
+{
+    auto lock = page_of(realm).client().page_did_request_indexed_database_upgrade_lock(environment_id_of(realm), Utf16String::from_raw(name));
+    *granted = lock.granted;
+    *has_stored_version = lock.stored_version.has_value();
+    *stored_version = lock.stored_version.value_or(0);
+}
+
+void web_indexed_db_release_upgrade_lock(void* realm, FlatPtr name)
+{
+    page_of(realm).client().page_did_release_indexed_database_upgrade_lock(environment_id_of(realm), Utf16String::from_raw(name));
+}
+
+void web_indexed_db_run_after(void* cell, u32 milliseconds, void (*steps)(JSVM*, void*))
+{
+    GC::Ref<GC::Cell> function = *static_cast<GC::Cell*>(cell);
+    // NB: The timer's callback, which the collector scans, keeps the function alive until the steps run.
+    auto timer = Platform::Timer::create_single_shot(GC::Heap::the(), AK::Duration::from_milliseconds(milliseconds), GC::create_function(GC::Heap::the(), [function, steps] {
+        steps(JS::HostABI::vm_to_abi(Bindings::main_thread_vm()), function.ptr());
+    }));
+    timer->start();
+}
+
+namespace Web::IndexedDB {
+
+void apply_persisted_database_changes(StorageAPI::StorageKey const& storage_key, PersistedDatabaseChanges changes)
+{
+    Writer writer;
+    writer.changes(changes);
+    URL::RustIntegration::lend_origin_to_ffi(storage_key.origin, [&](URL::FFI::FfiOrigin const& origin) {
+        web_rust_indexed_db_apply_persisted_changes(JS::HostABI::vm_to_abi(Bindings::main_thread_vm()), &origin, writer.buffer().bytes());
+    });
+}
+
+void did_persist_database_changes(u64 commit_id)
+{
+    web_rust_indexed_db_did_persist_changes(JS::HostABI::vm_to_abi(Bindings::main_thread_vm()), commit_id);
+}
+
+}
diff --git a/Libraries/LibWeb/IndexedDB/Persistence.h b/Libraries/LibWeb/IndexedDB/Persistence.h
new file mode 100644
index 0000000000..90de371eb6
--- /dev/null
+++ b/Libraries/LibWeb/IndexedDB/Persistence.h
@@ -0,0 +1,26 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/Export.h>
+#include <LibWebCommon/IndexedDB/PersistedDatabase.h>
+#include <LibWebCommon/StorageAPI/StorageKey.h>
+
+// AD-HOC: The spec leaves where databases live to the user agent. Ours live in the browser process, which keeps them
+//         for the session (on disk, unless the session is private) and shares them between processes; see
+//         LibWebCommon/IndexedDB/PersistedDatabase.h. Each process keeps working on its own in-memory copy, which the
+//         Rust implementation loads, persists and updates (Bindings/Rust/src/indexed_db/internal/persistence.rs); this
+//         is its bridge to the page client and the IPC endpoints.
+namespace Web::IndexedDB {
+
+// What another process committed, which the browser process passes on.
+WEB_API void apply_persisted_database_changes(StorageAPI::StorageKey const&, PersistedDatabaseChanges);
+
+// The browser process has stored the changes of one of our commits.
+WEB_API void did_persist_database_changes(u64 commit_id);
+
+}
