+// Key encoding: a type byte, then the value. Numbers and dates are IEEE doubles, strings their UTF-16 code units, binary
+// keys their bytes, array keys their subkeys. Lengths and counts are u32. Everything is little-endian.
+enum class EncodedKeyType : u8 {
+    Number = 1,
+    Date = 2,
+    String = 3,
+    Binary = 4,
+    Array = 5,
+};
+
+static constexpr size_t MAX_KEY_DEPTH = 1024;
+
+static void append_u32(ByteBuffer& buffer, u32 value)
+{
+    LittleEndian<u32> little_endian = value;
+    buffer.append(&little_endian, sizeof(little_endian));
+}
+
+static void append_double(ByteBuffer& buffer, double value)
+{
+    // NB: Keys are never NaN, and -0 is the same key as +0, so it is stored as +0.
+    if (value == 0)
+        value = 0;
+    LittleEndian<u64> little_endian = bit_cast<u64>(value);
+    buffer.append(&little_endian, sizeof(little_endian));
+}
+
+static void append_key(ByteBuffer& buffer, Key const& key)
+{
+    switch (key.type()) {
+    case Key::KeyType::Number:
+        buffer.append(to_underlying(EncodedKeyType::Number));
+        append_double(buffer, key.value_as_double());
+        break;
+    case Key::KeyType::Date:
+        buffer.append(to_underlying(EncodedKeyType::Date));
+        append_double(buffer, key.value_as_double());
+        break;
+    case Key::KeyType::String: {
+        buffer.append(to_underlying(EncodedKeyType::String));
+        auto view = key.value_as_string().utf16_view();
+        append_u32(buffer, view.length_in_code_units());
+        for (size_t i = 0; i < view.length_in_code_units(); ++i) {
+            LittleEndian<u16> code_unit = view.code_unit_at(i);
+            buffer.append(&code_unit, sizeof(code_unit));
+        }
+        break;
+    }
+    case Key::KeyType::Binary: {
+        buffer.append(to_underlying(EncodedKeyType::Binary));
+        auto const& bytes = key.value_as_byte_buffer();
+        append_u32(buffer, bytes.size());
+        buffer.append(bytes.bytes());
+        break;
+    }
+    case Key::KeyType::Array: {
+        buffer.append(to_underlying(EncodedKeyType::Array));
+        auto subkeys = key.subkeys();
+        append_u32(buffer, subkeys.size());
+        for (auto const& subkey : subkeys)
+            append_key(buffer, *subkey);
+        break;
+    }
+    case Key::KeyType::Invalid:
+        VERIFY_NOT_REACHED();
+    }
+}
+
+ByteBuffer encode_key(Key const& key)
+{
+    ByteBuffer buffer;
+    append_key(buffer, key);
+    return buffer;
+}
+
+class KeyReader {
+public:
+    explicit KeyReader(ReadonlyBytes bytes)
+        : m_bytes(bytes)
+    {
+    }
+
+    bool is_at_end() const { return m_offset == m_bytes.size(); }
+
+    ErrorOr<ReadonlyBytes> read_bytes(size_t count)
+    {
+        if (count > m_bytes.size() - m_offset)
+            return Error::from_string_literal("Truncated IndexedDB key");
+        auto bytes = m_bytes.slice(m_offset, count);
+        m_offset += count;
+        return bytes;
+    }
+
+    ErrorOr<u8> read_u8() { return TRY(read_bytes(1))[0]; }
+
+    ErrorOr<u64> read_little_endian(size_t size)
+    {
+        auto bytes = TRY(read_bytes(size));
+        u64 value = 0;
+        for (size_t i = 0; i < size; ++i)
+            value |= static_cast<u64>(bytes[i]) << (8 * i);
+        return value;
+    }
+
+    ErrorOr<u16> read_u16() { return static_cast<u16>(TRY(read_little_endian(2))); }
+    ErrorOr<u32> read_u32() { return static_cast<u32>(TRY(read_little_endian(4))); }
+    ErrorOr<double> read_double() { return bit_cast<double>(TRY(read_little_endian(8))); }
+
+private:
+    ReadonlyBytes m_bytes;
+    size_t m_offset { 0 };
+};
+
+static ErrorOr<GC::Ref<Key>> read_key(KeyReader& reader, size_t depth)
+{
+    if (depth > MAX_KEY_DEPTH)
+        return Error::from_string_literal("IndexedDB key nested too deeply");
+
+    switch (static_cast<EncodedKeyType>(TRY(reader.read_u8()))) {
+    case EncodedKeyType::Number:
+        return Key::create_number(TRY(reader.read_double()));
+    case EncodedKeyType::Date:
+        return Key::create_date(TRY(reader.read_double()));
+    case EncodedKeyType::String: {
+        auto length = TRY(reader.read_u32());
+        Vector<char16_t> code_units;
+        TRY(code_units.try_ensure_capacity(length));
+        for (u32 i = 0; i < length; ++i)
+            code_units.unchecked_append(TRY(reader.read_u16()));
+        return Key::create_string(Utf16String::from_utf16(Utf16View { code_units.data(), code_units.size() }));
+    }
+    case EncodedKeyType::Binary: {
+        auto length = TRY(reader.read_u32());
+        return Key::create_binary(TRY(ByteBuffer::copy(TRY(reader.read_bytes(length)))));
+    }
+    case EncodedKeyType::Array: {
+        auto count = TRY(reader.read_u32());
+        auto keys = GC::Heap::the().allocate<GC::HeapVector<GC::Ref<Key>>>();
+        for (u32 i = 0; i < count; ++i)
+            keys->elements().append(TRY(read_key(reader, depth + 1)));
+        return Key::create_array(keys);
+    }
+    }
+
+    return Error::from_string_literal("Unknown IndexedDB key type");
+}
+
+ErrorOr<GC::Ref<Key>> decode_key(ReadonlyBytes bytes)
+{
+    KeyReader reader { bytes };
+    auto key = TRY(read_key(reader, 0));
+    if (!reader.is_at_end())
+        return Error::from_string_literal("Trailing bytes after IndexedDB key");
+    return key;
+}
