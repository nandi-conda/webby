+Messages::WebWorkerClient::DidRequestIndexedDatabasesResponse WebWorkerClient::did_request_indexed_databases(Web::HTML::EnvironmentId environment_id)
+{
+    auto session = m_session.strong_ref();
+    auto environment = hosted_environment(environment_id);
+    if (!session || !environment.has_value())
+        return Vector<Web::IndexedDB::PersistedDatabase> {};
+
+    auto storage_key = obtain_a_storage_key(*environment);
+    if (!storage_key.has_value())
+        return Vector<Web::IndexedDB::PersistedDatabase> {};
+
+    return session->indexed_db_store->load(WeakPtr<WebWorkerClient> { *this }, *storage_key);
+}
+
+void WebWorkerClient::did_commit_indexed_database_changes(Web::HTML::EnvironmentId environment_id, u64 commit_id, Web::IndexedDB::PersistedDatabaseChanges changes)
+{
+    auto session = m_session.strong_ref();
+    auto environment = hosted_environment(environment_id);
+    if (!session || !environment.has_value())
+        return;
+
+    auto storage_key = obtain_a_storage_key(*environment);
+    if (!storage_key.has_value())
+        return;
+
+    session->indexed_db_store->commit(WeakPtr<WebWorkerClient> { *this }, *storage_key, commit_id, changes);
+}
