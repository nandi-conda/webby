+// The storage keys whose databases this process has loaded. Only those are kept up to date.
+static HashTable<StorageAPI::StorageKey>& loaded_storage_keys()
+{
+    static NeverDestroyed<HashTable<StorageAPI::StorageKey>> storage_keys;
+    return *storage_keys;
+}
