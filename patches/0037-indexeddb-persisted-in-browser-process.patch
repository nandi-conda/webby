+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Utf16String.h>
+#include <LibGC/Ptr.h>
+#include <LibJS/Forward.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+#include <LibWebCommon/IndexedDB/PersistedDatabase.h>
+#include <LibWebCommon/StorageAPI/StorageKey.h>
+
+// AD-HOC: The spec leaves where databases live to the user agent. Ours live in the browser process, which keeps them
+//         for the session (on disk, unless the session is private) and shares them between processes; see
+//         LibWebCommon/IndexedDB/PersistedDatabase.h. Each process keeps working on its own in-memory copy.
+namespace Web::IndexedDB {
+
+class IDBTransaction;
+class Key;
+
+// The browser process tells keys apart by these bytes alone, so equal keys must encode to equal bytes.
+ByteBuffer encode_key(Key const&);
+ErrorOr<GC::Ref<Key>> decode_key(ReadonlyBytes);
+
+// Brings the databases the browser process has for storage key into this process, the first time it is asked to.
+void load_persisted_databases(JS::Realm&, StorageAPI::StorageKey const&);
+
+// Sends what a committing transaction changed to the browser process.
+void persist_committed_transaction(IDBTransaction&);
+
+// Tells the browser process that this process deleted a database.
+void persist_deleted_database(JS::Realm&, StorageAPI::StorageKey const&, Utf16String const& name);
+
+// What another process committed, which the browser process passes on.
+WEB_API void apply_persisted_database_changes(StorageAPI::StorageKey const&, PersistedDatabaseChanges);
+
+// The browser process has stored the changes of one of our commits.
+WEB_API void did_persist_database_changes(u64 commit_id);
+
+}
