+
+    ~IndexedDBStore();
+
+    Vector<Web::IndexedDB::PersistedDatabase> load(IndexedDBClient const&, Web::StorageAPI::StorageKey const&);
+    void commit(IndexedDBClient const&, Web::StorageAPI::StorageKey const&, u64 commit_id, Web::IndexedDB::PersistedDatabaseChanges const&);
+
+    // A client upgrades a database only while it holds its lock, so two processes never upgrade it at once.
+    Web::IndexedDB::PersistedUpgradeLock lock_for_upgrade(IndexedDBClient const&, Web::StorageAPI::StorageKey const&, Utf16String const& name);
+    void release_upgrade_lock(IndexedDBClient const&, Web::StorageAPI::StorageKey const&, Utf16String const& name);
+
+    void remove_databases_accessed_since(UnixDateTime);
