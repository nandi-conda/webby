diff --git a/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.cpp b/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.cpp
new file mode 100644
index 0000000000..7b6f1e3dae
--- /dev/null
+++ b/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.cpp
@@ -0,0 +1,177 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibIPC/Decoder.h>
+#include <LibIPC/Encoder.h>
+#include <LibWebCommon/IndexedDB/PersistedDatabase.h>
+
+namespace IPC {
+
+using namespace Web::IndexedDB;
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedRecord const& record)
+{
+    TRY(encoder.encode(record.key));
+    TRY(encoder.encode(record.value));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedRecord> decode(Decoder& decoder)
+{
+    auto key = TRY(decoder.decode<ByteBuffer>());
+    auto value = TRY(decoder.decode<ByteBuffer>());
+    return PersistedRecord { move(key), move(value) };
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedIndexRecord const& record)
+{
+    TRY(encoder.encode(record.key));
+    TRY(encoder.encode(record.primary_key));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedIndexRecord> decode(Decoder& decoder)
+{
+    auto key = TRY(decoder.decode<ByteBuffer>());
+    auto primary_key = TRY(decoder.decode<ByteBuffer>());
+    return PersistedIndexRecord { move(key), move(primary_key) };
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedIndex const& index)
+{
+    TRY(encoder.encode(index.name));
+    TRY(encoder.encode(index.key_path));
+    TRY(encoder.encode(index.unique));
+    TRY(encoder.encode(index.multi_entry));
+    TRY(encoder.encode(index.records));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedIndex> decode(Decoder& decoder)
+{
+    PersistedIndex index;
+    index.name = TRY(decoder.decode<Utf16String>());
+    index.key_path = TRY(decoder.decode<PersistedKeyPath>());
+    index.unique = TRY(decoder.decode<bool>());
+    index.multi_entry = TRY(decoder.decode<bool>());
+    index.records = TRY(decoder.decode<Vector<PersistedIndexRecord>>());
+    return index;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedObjectStore const& store)
+{
+    TRY(encoder.encode(store.name));
+    TRY(encoder.encode(store.key_path));
+    TRY(encoder.encode(store.key_generator));
+    TRY(encoder.encode(store.records));
+    TRY(encoder.encode(store.indexes));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedObjectStore> decode(Decoder& decoder)
+{
+    PersistedObjectStore store;
+    store.name = TRY(decoder.decode<Utf16String>());
+    store.key_path = TRY(decoder.decode<Optional<PersistedKeyPath>>());
+    store.key_generator = TRY(decoder.decode<Optional<u64>>());
+    store.records = TRY(decoder.decode<Vector<PersistedRecord>>());
+    store.indexes = TRY(decoder.decode<Vector<PersistedIndex>>());
+    return store;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedDatabase const& database)
+{
+    TRY(encoder.encode(database.name));
+    TRY(encoder.encode(database.version));
+    TRY(encoder.encode(database.object_stores));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedDatabase> decode(Decoder& decoder)
+{
+    PersistedDatabase database;
+    database.name = TRY(decoder.decode<Utf16String>());
+    database.version = TRY(decoder.decode<u64>());
+    database.object_stores = TRY(decoder.decode<Vector<PersistedObjectStore>>());
+    return database;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedIndexChanges const& changes)
+{
+    TRY(encoder.encode(changes.name));
+    TRY(encoder.encode(changes.stored));
+    TRY(encoder.encode(changes.deleted));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedIndexChanges> decode(Decoder& decoder)
+{
+    PersistedIndexChanges changes;
+    changes.name = TRY(decoder.decode<Utf16String>());
+    changes.stored = TRY(decoder.decode<Vector<PersistedIndexRecord>>());
+    changes.deleted = TRY(decoder.decode<Vector<PersistedIndexRecord>>());
+    return changes;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedObjectStoreChanges const& changes)
+{
+    TRY(encoder.encode(changes.name));
+    TRY(encoder.encode(changes.key_generator));
+    TRY(encoder.encode(changes.stored));
+    TRY(encoder.encode(changes.deleted));
+    TRY(encoder.encode(changes.indexes));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedObjectStoreChanges> decode(Decoder& decoder)
+{
+    PersistedObjectStoreChanges changes;
+    changes.name = TRY(decoder.decode<Utf16String>());
+    changes.key_generator = TRY(decoder.decode<Optional<u64>>());
+    changes.stored = TRY(decoder.decode<Vector<PersistedRecord>>());
+    changes.deleted = TRY(decoder.decode<Vector<ByteBuffer>>());
+    changes.indexes = TRY(decoder.decode<Vector<PersistedIndexChanges>>());
+    return changes;
+}
+
+template<>
+ErrorOr<void> encode(Encoder& encoder, PersistedDatabaseChanges const& changes)
+{
+    TRY(encoder.encode(changes.kind));
+    TRY(encoder.encode(changes.name));
+    TRY(encoder.encode(changes.base_version));
+    TRY(encoder.encode(changes.replacement));
+    TRY(encoder.encode(changes.object_stores));
+    return {};
+}
+
+template<>
+ErrorOr<PersistedDatabaseChanges> decode(Decoder& decoder)
+{
+    PersistedDatabaseChanges changes;
+    changes.kind = TRY(decoder.decode<PersistedDatabaseChanges::Kind>());
+    changes.name = TRY(decoder.decode<Utf16String>());
+    changes.base_version = TRY(decoder.decode<u64>());
+    changes.replacement = TRY(decoder.decode<Optional<PersistedDatabase>>());
+    changes.object_stores = TRY(decoder.decode<Vector<PersistedObjectStoreChanges>>());
+    return changes;
+}
+
+}
diff --git a/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.h b/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.h
new file mode 100644
index 0000000000..da9f79c16a
--- /dev/null
+++ b/Libraries/LibWebCommon/IndexedDB/PersistedDatabase.h
@@ -0,0 +1,145 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Optional.h>
+#include <AK/Utf16String.h>
+#include <AK/Variant.h>
+#include <AK/Vector.h>
+#include <LibIPC/Forward.h>
+#include <LibWebCommon/Export.h>
+
+// AD-HOC: The browser process keeps every storage key's IndexedDB databases (on disk, unless the session is private),
+//         so that they outlive the processes that use them and every content and worker process sees the same ones.
+//         A process loads a storage key's databases from it once, sends it what each transaction it commits changed,
+//         and is sent what other processes committed. Keys and values are opaque bytes here: LibWeb encodes keys, and
+//         values are storage serialization records.
+namespace Web::IndexedDB {
+
+using PersistedKeyPath = Variant<Utf16String, Vector<Utf16String>>;
+
+struct PersistedRecord {
+    ByteBuffer key;
+    ByteBuffer value;
+};
+
+struct PersistedIndexRecord {
+    ByteBuffer key;
+    ByteBuffer primary_key;
+};
+
+struct PersistedIndex {
+    Utf16String name;
+    PersistedKeyPath key_path { Utf16String {} };
+    bool unique { false };
+    bool multi_entry { false };
+    Vector<PersistedIndexRecord> records;
+};
+
+struct PersistedObjectStore {
+    Utf16String name;
+    Optional<PersistedKeyPath> key_path;
+    // The key generator's current number, if the store has a key generator.
+    Optional<u64> key_generator;
+    Vector<PersistedRecord> records;
+    Vector<PersistedIndex> indexes;
+};
+
+struct PersistedDatabase {
+    Utf16String name;
+    u64 version { 0 };
+    Vector<PersistedObjectStore> object_stores;
+};
+
+struct PersistedIndexChanges {
+    Utf16String name;
+    Vector<PersistedIndexRecord> stored;
+    Vector<PersistedIndexRecord> deleted;
+};
+
+struct PersistedObjectStoreChanges {
+    Utf16String name;
+    Optional<u64> key_generator;
+    // Records stored replace any record with the same key.
+    Vector<PersistedRecord> stored;
+    Vector<ByteBuffer> deleted;
+    Vector<PersistedIndexChanges> indexes;
+};
+
+// The browser process lets one process at a time upgrade a database. A process that gets to is told the version stored
+// (none if there is no such database), which may be newer than what other processes told it of so far.
+struct PersistedUpgradeLock {
+    bool granted { false };
+    Optional<u64> stored_version;
+};
+
+// What one committed transaction (or a deletion) did to one database.
+struct PersistedDatabaseChanges {
+    enum class Kind : u8 {
+        // An upgrade transaction: the database is now `replacement` in full.
+        Replace,
+        // The database was deleted.
+        Delete,
+        // A readwrite transaction: `object_stores` lists what changed.
+        Update,
+    };
+
+    Kind kind { Kind::Update };
+    Utf16String name;
+    // For Replace: the version the upgrade started from (0 for a new database). The browser process refuses an upgrade
+    // of a database another process upgraded or deleted first, and sends the refused process what it has instead.
+    u64 base_version { 0 };
+    Optional<PersistedDatabase> replacement;
+    Vector<PersistedObjectStoreChanges> object_stores;
+};
+
+}
+
+namespace IPC {
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedRecord const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedRecord> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedIndexRecord const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedIndexRecord> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedIndex const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedIndex> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedObjectStore const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedObjectStore> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedDatabase const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedDatabase> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedIndexChanges const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedIndexChanges> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedObjectStoreChanges const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedObjectStoreChanges> decode(Decoder&);
+
+template<>
+WEBCOMMON_API ErrorOr<void> encode(Encoder&, Web::IndexedDB::PersistedDatabaseChanges const&);
+template<>
+WEBCOMMON_API ErrorOr<Web::IndexedDB::PersistedDatabaseChanges> decode(Decoder&);
+
+}
