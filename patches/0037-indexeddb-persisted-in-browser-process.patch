+// Our commits the browser process has not stored yet. A change another process committed that reaches us before one of
+// them was stored before it, so ours supersedes it wherever both wrote.
+struct PendingWrites {
+    // Commits that replaced or deleted the whole database.
+    u32 whole_database { 0 };
+    // Per object store: the encoded keys of the records commits wrote, with how many commits wrote each.
+    HashMap<Utf16String, HashMap<ByteBuffer, u32>> keys;
+
+    bool is_empty() const { return whole_database == 0 && keys.is_empty(); }
+};
+
+using PendingWritesByDatabase = HashMap<Utf16String, PendingWrites>;
+
+static HashMap<StorageAPI::StorageKey, PendingWritesByDatabase>& pending_writes()
+{
+    static NeverDestroyed<HashMap<StorageAPI::StorageKey, PendingWritesByDatabase>> writes;
+    return *writes;
+}
