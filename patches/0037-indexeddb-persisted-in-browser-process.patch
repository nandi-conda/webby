+    multi_entry: bool,
+    records: Vec<PersistedIndexRecord>,
+}
+
+pub(crate) struct PersistedObjectStore {
+    name: Utf16String,
+    key_path: Option<KeyPath>,
+    key_generator: Option<u64>,
+    records: Vec<PersistedRecord>,
