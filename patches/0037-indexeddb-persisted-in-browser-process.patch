+#[derive(Clone, Copy, PartialEq, Eq)]
+enum ChangesKind {
+    // An upgrade transaction: the database is now `replacement` in full.
+    Replace = 0,
+    // The database was deleted.
+    Delete = 1,
+    // A readwrite transaction: `object_stores` lists what changed.
+    Update = 2,
+}
+
+struct PersistedDatabaseChanges {
+    kind: ChangesKind,
+    name: Utf16String,
+    // For Replace: the version the upgrade started from (0 for a new database).
+    base_version: u64,
+    replacement: Option<PersistedDatabase>,
+    object_stores: Vec<PersistedObjectStoreChanges>,
+}
+
+// Key encoding: a type byte, then the value. Numbers and dates are IEEE doubles, strings their UTF-16 code units, binary
+// keys their bytes, array keys their subkeys. Lengths and counts are u32. Everything is little-endian. The browser
+// process tells keys apart by these bytes alone, so equal keys must encode to equal bytes; profiles already hold keys in
+// this encoding.
+const ENCODED_NUMBER: u8 = 1;
+const ENCODED_DATE: u8 = 2;
+const ENCODED_STRING: u8 = 3;
+const ENCODED_BINARY: u8 = 4;
+const ENCODED_ARRAY: u8 = 5;
+const MAX_KEY_DEPTH: usize = 1024;
+
+#[allow(clippy::cast_possible_truncation, reason = "lengths of keys fit in u32")]
+fn append_length(buffer: &mut Vec<u8>, length: usize) {
+    buffer.extend_from_slice(&(length as u32).to_le_bytes());
+}
+
+fn append_double(buffer: &mut Vec<u8>, value: f64) {
+    // NB: Keys are never NaN, and -0 is the same key as +0, so it is stored as +0.
+    let value = if value == 0.0 { 0.0 } else { value };
+    buffer.extend_from_slice(&value.to_bits().to_le_bytes());
+}
+
+fn append_key(buffer: &mut Vec<u8>, key: &Key) {
+    match key.r#type() {
+        KeyType::Number => {
+            buffer.push(ENCODED_NUMBER);
+            append_double(buffer, key.value_as_double());
+        }
+        KeyType::Date => {
+            buffer.push(ENCODED_DATE);
+            append_double(buffer, key.value_as_double());
+        }
+        KeyType::String => {
+            buffer.push(ENCODED_STRING);
+            let code_units = key.value_as_string().to_utf16();
+            append_length(buffer, code_units.len());
+            for code_unit in code_units.iter() {
+                buffer.extend_from_slice(&code_unit.to_le_bytes());
+            }
+        }
+        KeyType::Binary => {
+            buffer.push(ENCODED_BINARY);
+            let bytes = key.value_as_byte_buffer();
+            append_length(buffer, bytes.len());
+            buffer.extend_from_slice(bytes);
+        }
+        KeyType::Array => {
+            buffer.push(ENCODED_ARRAY);
+            let subkeys = key.subkeys();
+            append_length(buffer, subkeys.len());
+            for subkey in subkeys {
+                append_key(buffer, subkey);
+            }
+        }
+        KeyType::Invalid => unreachable!("an invalid key is never stored"),
+    }
+}
+
+pub(crate) fn encode_key(key: &Key) -> Vec<u8> {
+    let mut buffer = Vec::new();
+    append_key(&mut buffer, key);
+    buffer
+}
+
+struct ByteReader<'a> {
+    bytes: &'a [u8],
+    offset: usize,
+}
+
+impl<'a> ByteReader<'a> {
+    fn new(bytes: &'a [u8]) -> Self {
+        Self { bytes, offset: 0 }
+    }
+
+    fn is_at_end(&self) -> bool {
+        self.offset == self.bytes.len()
+    }
+
+    fn take(&mut self, count: usize) -> Option<&'a [u8]> {
+        if count > self.bytes.len() - self.offset {
+            return None;
+        }
+        let bytes = &self.bytes[self.offset..self.offset + count];
+        self.offset += count;
+        Some(bytes)
+    }
+
+    fn u8(&mut self) -> Option<u8> {
+        Some(self.take(1)?[0])
+    }
+
+    fn u16(&mut self) -> Option<u16> {
+        Some(u16::from_le_bytes(self.take(2)?.try_into().ok()?))
+    }
+
+    fn u32(&mut self) -> Option<u32> {
+        Some(u32::from_le_bytes(self.take(4)?.try_into().ok()?))
+    }
+
+    fn u64(&mut self) -> Option<u64> {
+        Some(u64::from_le_bytes(self.take(8)?.try_into().ok()?))
+    }
+
+    fn double(&mut self) -> Option<f64> {
+        Some(f64::from_bits(self.u64()?))
+    }
+
+    fn boolean(&mut self) -> Option<bool> {
+        Some(self.u8()? != 0)
+    }
+
+    fn bytes(&mut self) -> Option<Vec<u8>> {
+        let length = self.u32()? as usize;
+        Some(self.take(length)?.to_vec())
+    }
+
+    fn string(&mut self) -> Option<Utf16String> {
+        let length = self.u32()? as usize;
+        let bytes = self.take(length.checked_mul(2)?)?;
+        let code_units: Vec<u16> = bytes
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .map(|pair| u16::from_le_bytes(*pair))
+            .collect();
+        Some(Utf16String::from_utf16(&code_units))
+    }
+
+    fn count(&mut self) -> Option<usize> {
+        let count = self.u32()? as usize;
+        // NB: Every element takes at least a byte, which keeps a corrupt count from reserving too much.
+        if count > self.bytes.len() - self.offset {
+            return None;
+        }
+        Some(count)
+    }
+
+    fn key_path(&mut self) -> Option<KeyPath> {
+        if self.u8()? == 0 {
+            return Some(KeyPath::String(self.string()?));
+        }
+        let count = self.count()?;
+        let mut strings = Vec::with_capacity(count);
+        for _ in 0..count {
+            strings.push(self.string()?);
+        }
+        Some(KeyPath::Sequence(strings))
+    }
+
+    fn optional_u64(&mut self) -> Option<Option<u64>> {
+        if !self.boolean()? {
+            return Some(None);
+        }
+        Some(Some(self.u64()?))
+    }
+
+    fn key(&mut self, depth: usize) -> Option<Rc<Key>> {
+        if depth > MAX_KEY_DEPTH {
+            return None;
+        }
+        match self.u8()? {
+            ENCODED_NUMBER => Some(Key::create_number(self.double()?)),
+            ENCODED_DATE => Some(Key::create_date(self.double()?)),
+            ENCODED_STRING => {
+                let length = self.u32()? as usize;
+                let mut code_units = Vec::with_capacity(length.min(self.bytes.len()));
+                for _ in 0..length {
+                    code_units.push(self.u16()?);
+                }
+                Some(Key::create_string(Utf16String::from_utf16(&code_units)))
+            }
+            ENCODED_BINARY => Some(Key::create_binary(self.bytes()?)),
+            ENCODED_ARRAY => {
+                let count = self.count()?;
+                let mut subkeys = Vec::with_capacity(count);
+                for _ in 0..count {
+                    subkeys.push(self.key(depth + 1)?);
+                }
+                Some(Key::create_array(subkeys))
+            }
+            _ => None,
+        }
+    }
+
+    fn records(&mut self) -> Option<Vec<PersistedRecord>> {
+        let count = self.count()?;
+        let mut records = Vec::with_capacity(count);
+        for _ in 0..count {
+            let key = self.bytes()?;
+            let value = self.bytes()?;
+            records.push(PersistedRecord { key, value });
+        }
+        Some(records)
+    }
+
+    fn index_records(&mut self) -> Option<Vec<PersistedIndexRecord>> {
+        let count = self.count()?;
+        let mut records = Vec::with_capacity(count);
+        for _ in 0..count {
+            let key = self.bytes()?;
+            let primary_key = self.bytes()?;
+            records.push(PersistedIndexRecord { key, primary_key });
+        }
+        Some(records)
+    }
+
+    fn database(&mut self) -> Option<PersistedDatabase> {
+        let name = self.string()?;
+        let version = self.u64()?;
+        let store_count = self.count()?;
+        let mut object_stores = Vec::with_capacity(store_count);
+        for _ in 0..store_count {
+            let name = self.string()?;
+            let key_path = if self.boolean()? { Some(self.key_path()?) } else { None };
+            let key_generator = self.optional_u64()?;
+            let records = self.records()?;
+            let index_count = self.count()?;
+            let mut indexes = Vec::with_capacity(index_count);
+            for _ in 0..index_count {
+                let name = self.string()?;
+                let key_path = self.key_path()?;
+                let unique = self.boolean()?;
+                let multi_entry = self.boolean()?;
+                let records = self.index_records()?;
+                indexes.push(PersistedIndex {
+                    name,
+                    key_path,
+                    unique,
+                    multi_entry,
+                    records,
+                });
+            }
+            object_stores.push(PersistedObjectStore {
+                name,
+                key_path,
+                key_generator,
+                records,
+                indexes,
+            });
+        }
+        Some(PersistedDatabase {
+            name,
+            version,
+            object_stores,
+        })
+    }
+
+    fn changes(&mut self) -> Option<PersistedDatabaseChanges> {
+        let kind = match self.u8()? {
+            0 => ChangesKind::Replace,
+            1 => ChangesKind::Delete,
+            2 => ChangesKind::Update,
+            _ => return None,
+        };
+        let name = self.string()?;
+        let base_version = self.u64()?;
+        let replacement = if self.boolean()? { Some(self.database()?) } else { None };
+        let store_count = self.count()?;
+        let mut object_stores = Vec::with_capacity(store_count);
+        for _ in 0..store_count {
+            let name = self.string()?;
+            let key_generator = self.optional_u64()?;
+            let stored = self.records()?;
+            let deleted_count = self.count()?;
+            let mut deleted = Vec::with_capacity(deleted_count);
+            for _ in 0..deleted_count {
+                deleted.push(self.bytes()?);
+            }
+            let index_count = self.count()?;
+            let mut indexes = Vec::with_capacity(index_count);
+            for _ in 0..index_count {
+                let name = self.string()?;
+                let stored = self.index_records()?;
+                let deleted = self.index_records()?;
+                indexes.push(PersistedIndexChanges { name, stored, deleted });
+            }
+            object_stores.push(PersistedObjectStoreChanges {
+                name,
+                key_generator,
+                stored,
+                deleted,
+                indexes,
+            });
+        }
+        Some(PersistedDatabaseChanges {
+            kind,
+            name,
+            base_version,
+            replacement,
+            object_stores,
+        })
+    }
+}
+
+pub(crate) fn decode_key(bytes: &[u8]) -> Option<Rc<Key>> {
+    let mut reader = ByteReader::new(bytes);
+    let key = reader.key(0)?;
+    reader.is_at_end().then_some(key)
+}
+
+#[derive(Default)]
+struct ByteWriter {
+    buffer: Vec<u8>,
+}
+
+impl ByteWriter {
+    fn u8(&mut self, value: u8) {
+        self.buffer.push(value);
+    }
+
+    fn u32(&mut self, value: usize) {
+        append_length(&mut self.buffer, value);
+    }
+
+    fn u64(&mut self, value: u64) {
+        self.buffer.extend_from_slice(&value.to_le_bytes());
+    }
+
+    fn boolean(&mut self, value: bool) {
+        self.u8(u8::from(value));
+    }
+
+    fn bytes(&mut self, bytes: &[u8]) {
+        self.u32(bytes.len());
+        self.buffer.extend_from_slice(bytes);
+    }
+
+    fn string(&mut self, string: &Utf16String) {
+        let code_units = string.to_utf16();
+        self.u32(code_units.len());
+        for code_unit in code_units.iter() {
+            self.buffer.extend_from_slice(&code_unit.to_le_bytes());
+        }
+    }
+
+    fn key_path(&mut self, key_path: &KeyPath) {
+        match key_path {
+            KeyPath::String(string) => {
+                self.u8(0);
+                self.string(string);
+            }
+            KeyPath::Sequence(strings) => {
+                self.u8(1);
+                self.u32(strings.len());
+                for string in strings {
+                    self.string(string);
+                }
+            }
+        }
+    }
+
+    fn optional_u64(&mut self, value: Option<u64>) {
+        self.boolean(value.is_some());
+        if let Some(value) = value {
+            self.u64(value);
+        }
+    }
+
+    fn records(&mut self, records: &[PersistedRecord]) {
+        self.u32(records.len());
+        for record in records {
+            self.bytes(&record.key);
+            self.bytes(&record.value);
+        }
+    }
+
+    fn index_records(&mut self, records: &[PersistedIndexRecord]) {
+        self.u32(records.len());
+        for record in records {
+            self.bytes(&record.key);
+            self.bytes(&record.primary_key);
+        }
+    }
+
+    fn database(&mut self, database: &PersistedDatabase) {
+        self.string(&database.name);
+        self.u64(database.version);
+        self.u32(database.object_stores.len());
+        for store in &database.object_stores {
+            self.string(&store.name);
+            self.boolean(store.key_path.is_some());
+            if let Some(key_path) = &store.key_path {
+                self.key_path(key_path);
+            }
+            self.optional_u64(store.key_generator);
+            self.records(&store.records);
+            self.u32(store.indexes.len());
+            for index in &store.indexes {
+                self.string(&index.name);
+                self.key_path(&index.key_path);
+                self.boolean(index.unique);
+                self.boolean(index.multi_entry);
+                self.index_records(&index.records);
+            }
+        }
+    }
+
+    fn changes(&mut self, changes: &PersistedDatabaseChanges) {
+        self.u8(changes.kind as u8);
+        self.string(&changes.name);
+        self.u64(changes.base_version);
+        self.boolean(changes.replacement.is_some());
+        if let Some(replacement) = &changes.replacement {
+            self.database(replacement);
+        }
+        self.u32(changes.object_stores.len());
+        for store in &changes.object_stores {
+            self.string(&store.name);
+            self.optional_u64(store.key_generator);
+            self.records(&store.stored);
+            self.u32(store.deleted.len());
+            for key in &store.deleted {
+                self.bytes(key);
+            }
+            self.u32(store.indexes.len());
+            for index in &store.indexes {
+                self.string(&index.name);
+                self.index_records(&index.stored);
+                self.index_records(&index.deleted);
+            }
+        }
+    }
+}
+
+// Our commits the browser process has not stored yet. A change another process committed that reaches us before one of
+// them was stored before it, so ours supersedes it wherever both wrote.
+#[derive(Clone, Default)]
+struct PendingWrites {
+    // Commits that replaced or deleted the whole database.
+    whole_database: u32,
+    // Per object store: the encoded keys of the records commits wrote, with how many commits wrote each.
+    keys: Vec<(Utf16String, HashMap<Vec<u8>, u32>)>,
+}
+
+impl PendingWrites {
+    fn is_empty(&self) -> bool {
+        self.whole_database == 0 && self.keys.is_empty()
+    }
+
+    fn is_pending(&self, object_store_name: &Utf16String, key: &[u8]) -> bool {
+        self.keys
+            .iter()
+            .find(|(name, _)| name == object_store_name)
+            .is_some_and(|(_, keys)| keys.contains_key(key))
+    }
+}
+
+fn is_pending(writes: Option<&PendingWrites>, object_store_name: &Utf16String, key: &[u8]) -> bool {
+    writes.is_some_and(|writes| writes.is_pending(object_store_name, key))
+}
+
+struct SentCommit {
+    storage_key: StorageKey,
+    database_name: Utf16String,
+    whole_database: bool,
+    keys: Vec<(Utf16String, Vec<u8>)>,
+}
+
+#[derive(Default)]
+struct State {
+    // The storage keys whose databases this process has loaded. Only those are kept up to date.
+    loaded_storage_keys: Vec<StorageKey>,
+    pending_writes: Vec<(StorageKey, Vec<(Utf16String, PendingWrites)>)>,
+    sent_commits: HashMap<u64, SentCommit>,
+    next_commit_id: u64,
+}
+
+impl State {
+    fn is_loaded(&self, storage_key: &StorageKey) -> bool {
+        self.loaded_storage_keys.iter().any(|key| key == storage_key)
+    }
+
+    fn pending_writes_for(&self, storage_key: &StorageKey, database_name: &Utf16String) -> Option<&PendingWrites> {
+        let (_, databases) = self.pending_writes.iter().find(|(key, _)| key == storage_key)?;
+        databases
+            .iter()
+            .find(|(name, _)| name == database_name)
+            .map(|(_, writes)| writes)
+    }
+
+    fn pending_writes_for_mut(&mut self, storage_key: &StorageKey, database_name: &Utf16String) -> &mut PendingWrites {
+        let position = match self.pending_writes.iter().position(|(key, _)| key == storage_key) {
+            Some(position) => position,
+            None => {
+                self.pending_writes.push((storage_key.clone(), Vec::new()));
+                self.pending_writes.len() - 1
+            }
+        };
+        let databases = &mut self.pending_writes[position].1;
+        let position = match databases.iter().position(|(name, _)| name == database_name) {
+            Some(position) => position,
+            None => {
+                databases.push((database_name.clone(), PendingWrites::default()));
+                databases.len() - 1
+            }
+        };
+        &mut databases[position].1
+    }
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State {
+        next_commit_id: 1,
+        ..State::default()
+    });
+}
+
+fn is_loaded(storage_key: &StorageKey) -> bool {
+    STATE.with_borrow(|state| state.is_loaded(storage_key))
+}
+
+fn realm_ptr(realm: Gc<Realm>) -> *mut c_void {
+    realm.as_ptr().cast()
+}
+
+fn send_commit(realm: Gc<Realm>, storage_key: &StorageKey, changes: &PersistedDatabaseChanges) {
+    let commit_id = STATE.with_borrow_mut(|state| {
+        let commit_id = state.next_commit_id;
+        state.next_commit_id += 1;
+
+        let mut sent = SentCommit {
+            storage_key: storage_key.clone(),
+            database_name: changes.name.clone(),
+            whole_database: changes.kind != ChangesKind::Update,
+            keys: Vec::new(),
+        };
+        let writes = state.pending_writes_for_mut(storage_key, &changes.name);
+        if sent.whole_database {
+            writes.whole_database += 1;
+        } else {
+            for store in &changes.object_stores {
+                let position = match writes.keys.iter().position(|(name, _)| *name == store.name) {
+                    Some(position) => position,
+                    None => {
+                        writes.keys.push((store.name.clone(), HashMap::new()));
+                        writes.keys.len() - 1
+                    }
+                };
+                let keys = &mut writes.keys[position].1;
+                let written = store
+                    .stored
+                    .iter()
+                    .map(|record| &record.key)
+                    .chain(store.deleted.iter());
+                for key in written {
+                    *keys.entry(key.clone()).or_insert(0) += 1;
+                    sent.keys.push((store.name.clone(), key.clone()));
+                }
+            }
+        }
+        state.sent_commits.insert(commit_id, sent);
+        commit_id
+    });
+
+    let mut writer = ByteWriter::default();
+    writer.changes(changes);
+    // SAFETY: The realm is live, and the bytes are lent for the call.
+    unsafe { web_indexed_db_commit_persisted_changes(realm_ptr(realm), commit_id, ak::Span::new(&writer.buffer)) };
+}
+
+fn did_persist_database_changes(commit_id: u64) {
+    STATE.with_borrow_mut(|state| {
+        let Some(sent) = state.sent_commits.remove(&commit_id) else {
+            return;
+        };
+        let Some(key_position) = state
+            .pending_writes
+            .iter()
+            .position(|(key, _)| *key == sent.storage_key)
+        else {
+            return;
+        };
+        let databases = &mut state.pending_writes[key_position].1;
+        let Some(database_position) = databases.iter().position(|(name, _)| *name == sent.database_name) else {
+            return;
+        };
+        let writes = &mut databases[database_position].1;
+
+        if sent.whole_database && writes.whole_database > 0 {
+            writes.whole_database -= 1;
+        }
+        for (store_name, key) in &sent.keys {
+            let Some(store_position) = writes.keys.iter().position(|(name, _)| name == store_name) else {
+                continue;
+            };
+            let keys = &mut writes.keys[store_position].1;
+            if let Some(count) = keys.get_mut(key) {
+                *count -= 1;
+                if *count == 0 {
+                    keys.remove(key);
+                }
+            }
+            if keys.is_empty() {
+                writes.keys.remove(store_position);
+            }
+        }
+
+        if writes.is_empty() {
+            databases.remove(database_position);
+        }
+        if databases.is_empty() {
+            state.pending_writes.remove(key_position);
+        }
+    });
+}
+
+fn compare_index_records(a: &IndexRecord, b: &IndexRecord) -> core::cmp::Ordering {
+    Key::ordering(&a.key, &b.key).then_with(|| Key::ordering(&a.value, &b.value))
+}
+
+fn install_database(vm: &Vm, storage_key: &StorageKey, persisted: &PersistedDatabase) -> DatabaseRef {
+    let database = Database::create_for_key_and_name(vm, storage_key, &persisted.name);
+    database.set_version(persisted.version);
+
+    for persisted_store in &persisted.object_stores {
+        let store = ObjectStore::create(
+            vm,
+            database,
+            persisted_store.name.clone(),
+            persisted_store.key_generator.is_some(),
+            persisted_store.key_path.clone(),
+        );
+        if let Some(current_number) = persisted_store.key_generator {
+            store.key_generator().set(current_number);
+        }
+
+        let mut records: Vec<ObjectStoreRecord> = persisted_store
+            .records
+            .iter()
+            .filter_map(|record| {
+                Some(ObjectStoreRecord {
+                    key: decode_key(&record.key)?,
+                    value: Rc::from(record.value.as_slice()),
+                })
+            })
+            .collect();
+        records.sort_by(|a, b| Key::ordering(&a.key, &b.key));
+        for record in records {
+            store.store_a_record(vm, record);
+        }
+
+        for persisted_index in &persisted_store.indexes {
+            let index = Index::create(
+                vm,
+                store,
+                &persisted_index.name,
+                &persisted_index.key_path,
+                persisted_index.unique,
+                persisted_index.multi_entry,
+            );
+            let mut index_records: Vec<IndexRecord> = persisted_index
+                .records
+                .iter()
+                .filter_map(|record| {
+                    Some(IndexRecord {
+                        key: decode_key(&record.key)?,
+                        value: decode_key(&record.primary_key)?,
+                    })
+                })
+                .collect();
+            index_records.sort_by(compare_index_records);
+            for record in &index_records {
+                Index::store_a_record(index, vm, record);
+            }
+        }
+    }
+
+    database
+}
+
+/// Brings the databases the browser process has for the storage key into this process, the first time it is asked to.
+pub(crate) fn load_persisted_databases(vm: &Vm, realm: Gc<Realm>, storage_key: &StorageKey) {
+    if is_loaded(storage_key) {
+        return;
+    }
+    STATE.with_borrow_mut(|state| state.loaded_storage_keys.push(storage_key.clone()));
+
+    unsafe extern "C" fn on_bytes(ctx: *mut c_void, bytes: ak::Span<'_, u8>) {
+        // SAFETY: ctx is the vector below, and the bytes are lent for the call.
+        unsafe { (*ctx.cast::<Vec<u8>>()).extend_from_slice(bytes.as_slice()) };
+    }
+    let mut bytes: Vec<u8> = Vec::new();
+    // SAFETY: The realm is live, and the vector outlives the call.
+    unsafe { web_indexed_db_request_persisted_databases(realm_ptr(realm), (&raw mut bytes).cast(), on_bytes) };
+
+    let mut reader = ByteReader::new(&bytes);
+    let Some(count) = reader.count() else {
+        return;
+    };
+    for _ in 0..count {
+        let Some(database) = reader.database() else {
+            return;
+        };
+        if Database::for_key_and_name(vm, storage_key, &database.name).is_some() {
+            continue;
+        }
+        install_database(vm, storage_key, &database);
+    }
+}
+
+// Whether opening name with version may run an upgrade, going by what this process has.
+fn open_may_upgrade(vm: &Vm, storage_key: &StorageKey, name: &Utf16String, version: Option<u64>) -> bool {
+    let Some(database) = Database::for_key_and_name(vm, storage_key, name) else {
+        return true;
+    };
+    if database.version() == 0 {
+        return true;
+    }
+    version.is_some_and(|version| database.version() < version)
+}
+
+fn local_version(vm: &Vm, storage_key: &StorageKey, name: &Utf16String) -> Option<u64> {
+    let database = Database::for_key_and_name(vm, storage_key, name)?;
+    (database.version() != 0).then(|| database.version())
+}
+
+fn request_upgrade_lock(realm: Gc<Realm>, name: &Utf16String) -> (bool, Option<u64>) {
+    let mut granted = false;
+    let mut has_stored_version = false;
+    let mut stored_version = 0;
+    // SAFETY: The realm is live, the name is lent for the call, and the out-parameters outlive it.
+    unsafe {
+        web_indexed_db_request_upgrade_lock(
+            realm_ptr(realm),
+            name.raw_identity(),
+            &raw mut granted,
+            &raw mut has_stored_version,
+            &raw mut stored_version,
+        );
+    }
+    (granted, has_stored_version.then_some(stored_version))
+}
+
+/// AD-HOC: Two processes must not upgrade a database at once (each would build its own and one would lose). Before an
+/// open request that may upgrade goes on, this process takes the database's lock from the browser process, waiting
+/// while another process holds it; `then` is told whether it took the lock, which it must give back with
+/// release_upgrade_lock() once the request is done.
+pub(crate) fn wait_for_upgrade_lock(
+    vm: &Vm,
+    realm: Gc<Realm>,
+    storage_key: &StorageKey,
+    name: &Utf16String,
+    version: Option<u64>,
+    then: FunctionWith<bool>,
+) {
+    try_upgrade_lock(vm, realm, storage_key, name, version, then, 0);
+}
+
+fn try_upgrade_lock(
+    vm: &Vm,
+    realm: Gc<Realm>,
+    storage_key: &StorageKey,
+    name: &Utf16String,
+    version: Option<u64>,
+    then: FunctionWith<bool>,
+    attempt: u32,
+) {
+    // What another process changed that we have not heard of yet is already on its way to us: try again once it is in
+    // (but not forever, should what we have never match).
+    const MAX_ATTEMPTS: u32 = 500;
+
+    if !open_may_upgrade(vm, storage_key, name, version) {
+        then.call(vm, false);
+        return;
+    }
+
+    let (mut granted, stored_version) = request_upgrade_lock(realm, name);
+    let behind = granted && stored_version != local_version(vm, storage_key, name);
+    if behind && attempt < MAX_ATTEMPTS {
+        release_upgrade_lock(realm, name);
+        granted = false;
+    }
+
+    if !granted && attempt < MAX_ATTEMPTS {
+        let retry = create_function(
+            vm,
+            (
+                realm,
+                NoCells((storage_key.clone(), version, attempt)),
+                name.clone(),
+                then,
+            ),
+            |vm, &(realm, NoCells((ref storage_key, version, attempt)), ref name, then), ()| {
+                try_upgrade_lock(vm, realm, storage_key, name, version, then, attempt + 1);
+            },
+        );
+        let milliseconds = if attempt < 10 { 1 } else { 10 };
+        // SAFETY: The function is live, and the timer keeps it alive until it runs.
+        unsafe { web_indexed_db_run_after(retry.cell_as_ptr(), milliseconds, run_function) };
+        return;
+    }
+
+    if !granted {
+        eprintln!(
+            "IndexedDB: Gave up waiting to upgrade database '{}'",
+            String::from_utf16_lossy(&name.to_utf16())
+        );
+    }
+
+    // The database we now have may not need the upgrade after all.
+    if granted && !open_may_upgrade(vm, storage_key, name, version) {
+        release_upgrade_lock(realm, name);
+        then.call(vm, false);
+        return;
+    }
+    then.call(vm, granted);
+}
+
+pub(crate) fn release_upgrade_lock(realm: Gc<Realm>, name: &Utf16String) {
+    // SAFETY: The realm is live, and the name is lent for the call.
+    unsafe { web_indexed_db_release_upgrade_lock(realm_ptr(realm), name.raw_identity()) };
+}
+
+fn snapshot_of(vm: &Vm, database: DatabaseRef) -> PersistedDatabase {
+    let mut object_stores = Vec::new();
+    for store in database.object_stores(vm).values().iter() {
+        let records = store
+            .records()
+            .iter()
+            .map(|record| PersistedRecord {
+                key: encode_key(&record.key),
+                value: record.value.to_vec(),
+            })
+            .collect();
+        let mut indexes = Vec::new();
+        for index in store.indexes(vm).values().iter() {
+            indexes.push(PersistedIndex {
+                name: index.name(),
+                key_path: index.key_path().clone(),
+                unique: index.unique(),
+                multi_entry: index.multi_entry(),
+                records: index
+                    .records()
+                    .iter()
+                    .map(|record| PersistedIndexRecord {
+                        key: encode_key(&record.key),
+                        primary_key: encode_key(&record.value),
+                    })
+                    .collect(),
+            });
+        }
+        object_stores.push(PersistedObjectStore {
+            name: store.name(),
+            key_path: store.key_path().cloned(),
+            key_generator: store
+                .uses_a_key_generator()
+                .then(|| store.key_generator().current_number()),
+            records,
+            indexes,
+        });
+    }
+    PersistedDatabase {
+        name: database.name(),
+        version: database.version(),
+        object_stores,
+    }
+}
+
+/// Sends what a committing transaction changed to the browser process.
+pub(crate) fn persist_committed_transaction(vm: &Vm, transaction: Ref<IDBTransaction>) {
+    if transaction.is_readonly() {
+        return;
+    }
+
+    let database = transaction.connection_object().associated_database();
+    let Some(storage_key) = database.storage_key() else {
+        return;
+    };
+    if !is_loaded(&storage_key) {
+        return;
+    }
+
+    // A connection to a database another process has since replaced or deleted writes to what is no longer stored.
+    if Database::for_key_and_name(vm, &storage_key, &database.name()) != Some(database) {
+        return;
+    }
+
+    let mut changes = PersistedDatabaseChanges {
+        kind: ChangesKind::Update,
+        name: database.name(),
+        base_version: 0,
+        replacement: None,
+        object_stores: Vec::new(),
+    };
+
+    if transaction.is_upgrade_transaction() {
+        changes.kind = ChangesKind::Replace;
+        changes.base_version = transaction.original_version();
+        changes.replacement = Some(snapshot_of(vm, database));
+    } else {
+        for (store, log) in transaction.store_mutation_logs(vm).values().iter() {
+            if let Some(store_changes) = log.persisted_changes(*store) {
+                changes.object_stores.push(store_changes);
+            }
+        }
+        if changes.object_stores.is_empty() {
+            return;
+        }
+    }
+
+    send_commit(transaction.realm(), &storage_key, &changes);
+}
+
+/// Tells the browser process that this process deleted a database.
+pub(crate) fn persist_deleted_database(realm: Gc<Realm>, storage_key: &StorageKey, name: &Utf16String) {
+    if !is_loaded(storage_key) {
+        return;
+    }
+    let changes = PersistedDatabaseChanges {
+        kind: ChangesKind::Delete,
+        name: name.clone(),
+        base_version: 0,
+        replacement: None,
+        object_stores: Vec::new(),
+    };
+    send_commit(realm, storage_key, &changes);
+}
+
+// Applies what another process changed in database, except where a commit of ours that is not stored yet wrote.
+fn apply_object_store_changes(
+    vm: &Vm,
+    database: DatabaseRef,
+    writes: Option<&PendingWrites>,
+    changes: &PersistedObjectStoreChanges,
+) {
+    let Some(store) = database.object_store_with_name(&changes.name) else {
+        return;
+    };
+
+    // NB: These changes are already committed, so they are no part of any transaction of ours that may revert.
+    let saved_log = store.mutation_log();
+    store.set_mutation_log(None);
+
+    for encoded_key in &changes.deleted {
+        if is_pending(writes, &changes.name, encoded_key) {
+            continue;
+        }
+        if let Some(key) = decode_key(encoded_key) {
+            store.remove_record_with_key(&key);
+        }
+    }
+
+    for record in &changes.stored {
+        if is_pending(writes, &changes.name, &record.key) {
+            continue;
+        }
+        let Some(key) = decode_key(&record.key) else {
+            continue;
+        };
+        store.remove_record_with_key(&key);
+        store.store_a_record(
+            vm,
+            ObjectStoreRecord {
+                key,
+                value: Rc::from(record.value.as_slice()),
+            },
+        );
+    }
+
+    for index_changes in &changes.indexes {
+        let Some(index) = store.index_set_get(&index_changes.name) else {
+            continue;
+        };
+
+        let decode_record = |record: &PersistedIndexRecord| -> Option<IndexRecord> {
+            if is_pending(writes, &changes.name, &record.primary_key) {
+                return None;
+            }
+            Some(IndexRecord {
+                key: decode_key(&record.key)?,
+                value: decode_key(&record.primary_key)?,
+            })
+        };
+
+        for persisted_record in &index_changes.deleted {
+            if let Some(record) = decode_record(persisted_record) {
+                index.remove_record(&record);
+            }
+        }
+        for persisted_record in &index_changes.stored {
+            if let Some(record) = decode_record(persisted_record) {
+                index.remove_record(&record);
+                Index::store_a_record(index, vm, &record);
+            }
+        }
+    }
+
+    if let Some(current_number) = changes.key_generator
+        && store.uses_a_key_generator()
+        && current_number > store.key_generator().current_number()
+    {
+        store.key_generator().set(current_number);
+    }
+
+    store.set_mutation_log(saved_log);
+}
+
+fn key_paths_match(a: Option<&KeyPath>, b: Option<&KeyPath>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(KeyPath::String(a)), Some(KeyPath::String(b))) => a == b,
+        (Some(KeyPath::Sequence(a)), Some(KeyPath::Sequence(b))) => a == b,
+        _ => false,
+    }
+}
+
+// Whether database has the version, object stores and indexes of persisted, so the records can be swapped in place.
+fn has_schema_of(vm: &Vm, database: DatabaseRef, persisted: &PersistedDatabase) -> bool {
+    if database.version() != persisted.version
+        || database.object_stores(vm).values().len() != persisted.object_stores.len()
+    {
+        return false;
+    }
+
+    for persisted_store in &persisted.object_stores {
+        let Some(store) = database.object_store_with_name(&persisted_store.name) else {
+            return false;
+        };
+        if !key_paths_match(store.key_path(), persisted_store.key_path.as_ref())
+            || store.uses_a_key_generator() != persisted_store.key_generator.is_some()
+            || store.indexes(vm).values().len() != persisted_store.indexes.len()
+        {
+            return false;
+        }
+        for persisted_index in &persisted_store.indexes {
+            let Some(index) = store.index_set_get(&persisted_index.name) else {
+                return false;
+            };
+            if !key_paths_match(Some(index.key_path()), Some(&persisted_index.key_path))
+                || index.unique() != persisted_index.unique
+                || index.multi_entry() != persisted_index.multi_entry
+            {
+                return false;
+            }
+        }
+    }
+    true
+}
+
+// Makes database's records those of persisted, as a set of changes: whatever persisted lacks is deleted.
+fn replace_records_in_place(
+    vm: &Vm,
+    database: DatabaseRef,
+    writes: Option<&PendingWrites>,
+    persisted: &PersistedDatabase,
+) {
+    for persisted_store in &persisted.object_stores {
+        let store = database
+            .object_store_with_name(&persisted_store.name)
+            .expect("the database has the persisted schema");
+
+        let persisted_keys: std::collections::HashSet<&[u8]> = persisted_store
+            .records
+            .iter()
+            .map(|record| record.key.as_slice())
+            .collect();
+        let deleted = store
+            .records()
+            .iter()
+            .map(|record| encode_key(&record.key))
+            .filter(|key| !persisted_keys.contains(key.as_slice()))
+            .collect();
+
+        let mut indexes = Vec::new();
+        for persisted_index in &persisted_store.indexes {
+            let index = store
+                .index_set_get(&persisted_index.name)
+                .expect("the database has the persisted schema");
+            let pair = |key: &[u8], primary_key: &[u8]| {
+                let mut pair = key.to_vec();
+                pair.extend_from_slice(primary_key);
+                pair
+            };
+            let persisted_records: std::collections::HashSet<Vec<u8>> = persisted_index
+                .records
+                .iter()
+                .map(|record| pair(&record.key, &record.primary_key))
+                .collect();
+            let deleted = index
+                .records()
+                .iter()
+                .map(|record| PersistedIndexRecord {
+                    key: encode_key(&record.key),
+                    primary_key: encode_key(&record.value),
+                })
+                .filter(|record| !persisted_records.contains(&pair(&record.key, &record.primary_key)))
+                .collect();
+            indexes.push(PersistedIndexChanges {
+                name: persisted_index.name.clone(),
+                stored: persisted_index.records.clone(),
+                deleted,
+            });
+        }
+
+        let changes = PersistedObjectStoreChanges {
+            name: persisted_store.name.clone(),
+            key_generator: persisted_store.key_generator,
+            stored: persisted_store.records.clone(),
+            deleted,
+            indexes,
+        };
+        apply_object_store_changes(vm, database, writes, &changes);
+    }
+}
+
+// As when a connection in this process upgrades or deletes a database: open connections hear of it first, and those
+// that do not close themselves are closed.
+fn close_connections_to_superseded_database(vm: &Vm, database: DatabaseRef, new_version: Option<u64>) {
+    let old_version = database.version();
+    for connection in database.associated_connections(vm).values().iter() {
+        if connection.close_pending() {
+            continue;
+        }
+        queue_a_database_task(
+            vm,
+            create_function(
+                vm,
+                (*connection, NoCells((old_version, new_version))),
+                |vm, &(connection, NoCells((old_version, new_version))), ()| {
+                    if connection.close_pending() {
+                        return;
+                    }
+                    fire_a_version_change_event(
+                        vm,
+                        connection.realm(),
+                        "versionchange",
+                        connection.event_target(),
+                        old_version,
+                        new_version,
+                    );
+                    if !connection.close_pending() {
+                        close_a_database_connection(vm, connection, None, true);
+                    }
+                },
+            ),
+        );
+    }
+}
+
+fn apply_persisted_database_changes(vm: &Vm, storage_key: &StorageKey, changes: PersistedDatabaseChanges) {
+    if !is_loaded(storage_key) {
+        return;
+    }
+
+    let writes = STATE.with_borrow(|state| state.pending_writes_for(storage_key, &changes.name).cloned());
+    let writes = writes.as_ref();
+
+    // A replacement or deletion of ours that is not stored yet supersedes this (or, if it is refused, we are sent what
+    // is stored instead).
+    if writes.is_some_and(|writes| writes.whole_database > 0) {
+        return;
+    }
+
+    let database = Database::for_key_and_name(vm, storage_key, &changes.name);
+
+    if changes.kind == ChangesKind::Update {
+        if let Some(database) = database {
+            for store_changes in &changes.object_stores {
+                apply_object_store_changes(vm, database, writes, store_changes);
+            }
+        }
+        return;
+    }
+
+    // An upgrade of ours that is still running replaces the database when it commits, or is refused.
+    if database.is_some_and(|database| database.upgrade_transaction().is_some()) {
+        return;
+    }
+
+    if changes.kind == ChangesKind::Replace
+        && let Some(replacement) = &changes.replacement
+    {
+        // Versions only go up, short of a deletion.
+        if database.is_some_and(|database| replacement.version < database.version()) {
+            return;
+        }
+
+        // Another process upgraded the database to what we have (most often: we both created it at once). Our
+        // connections stay open, and only the records change.
+        if let Some(database) = database
+            && has_schema_of(vm, database, replacement)
+        {
+            replace_records_in_place(vm, database, writes, replacement);
+            return;
+        }
+    }
+
+    let mut new_version = None;
+    if database.is_some() {
+        Database::delete_for_key_and_name(vm, storage_key, &changes.name);
+    }
+    if changes.kind == ChangesKind::Replace
+        && let Some(replacement) = &changes.replacement
+    {
+        install_database(vm, storage_key, replacement);
+        new_version = Some(replacement.version);
+    }
+    if let Some(database) = database {
+        close_connections_to_superseded_database(vm, database, new_version);
+    }
+}
+
+/// What another process committed, which the browser process passes on.
+///
+/// # Safety
+///
+/// The pointers must be the live VM and an origin that LibWeb lends.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn web_rust_indexed_db_apply_persisted_changes(
+    vm: *mut c_void,
+    origin: *const FfiOrigin,
+    changes: ak::Span<'_, u8>,
+) {
+    // SAFETY: The caller passes the live VM and lends a live origin.
+    let (vm, storage_key) = unsafe {
+        (
+            &*vm.cast::<Vm>(),
+            StorageKey {
+                origin: (*origin).to_origin(),
+            },
+        )
+    };
+    let mut reader = ByteReader::new(changes.as_slice());
+    let Some(changes) = reader.changes() else {
+        eprintln!("IndexedDB: Could not read the changes another process committed");
+        return;
+    };
+    apply_persisted_database_changes(vm, &storage_key, changes);
+}
+
+/// The browser process has stored the changes of one of our commits.
+///
+/// # Safety
+///
+/// The pointer must be the live VM.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn web_rust_indexed_db_did_persist_changes(_vm: *mut c_void, commit_id: u64) {
+    did_persist_database_changes(commit_id);
+}
