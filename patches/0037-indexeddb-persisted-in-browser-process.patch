+
+private:
+    struct Statements {
+        Database::StatementID select_databases { 0 };
+        Database::StatementID select_database_version { 0 };
+        Database::StatementID select_object_stores { 0 };
+        Database::StatementID select_indexes { 0 };
+        Database::StatementID select_records { 0 };
+        Database::StatementID select_index_records { 0 };
+        Database::StatementID touch_database { 0 };
+        Database::StatementID insert_database { 0 };
+        Database::StatementID insert_object_store { 0 };
+        Database::StatementID insert_index { 0 };
+        Database::StatementID insert_record { 0 };
+        Database::StatementID insert_index_record { 0 };
+        Database::StatementID delete_record { 0 };
+        Database::StatementID delete_index_record { 0 };
+        Database::StatementID update_key_generator { 0 };
+        Database::StatementID delete_database { 0 };
+        Database::StatementID delete_object_stores { 0 };
+        Database::StatementID delete_indexes { 0 };
+        Database::StatementID delete_records { 0 };
+        Database::StatementID delete_index_records { 0 };
+        Database::StatementID select_databases_accessed_since { 0 };
+        Database::StatementID estimate_size_accessed_since { 0 };
+    };
+
+    struct Subscriber {
+        IndexedDBClient client;
+        Web::StorageAPI::StorageKey storage_key;
+    };
+
+    struct RemovedDatabase {
+        String storage_key;
+        Utf16String name;
+    };
+
+    struct UpgradeLock {
+        IndexedDBClient client;
+        Web::StorageAPI::StorageKey storage_key;
+        Utf16String name;
+    };
+
+    IndexedDBStore(NonnullRefPtr<Database::Database>, Statements);
+
+    Vector<Web::IndexedDB::PersistedDatabase> read_databases(String const& storage_key);
+    Optional<u64> stored_version(String const& storage_key, Utf16String const& name);
+    Vector<Utf16String> read_database_names(String const& storage_key);
+    void remove_databases(Vector<RemovedDatabase> const&);
+
+    void delete_database_rows(String const& storage_key, Utf16String const& name);
+    void insert_database_rows(String const& storage_key, Web::IndexedDB::PersistedDatabase const&);
+    void update_database_rows(String const& storage_key, Web::IndexedDB::PersistedDatabaseChanges const&);
+
+    void send_to_subscribers(Web::StorageAPI::StorageKey const&, IndexedDBClient const* except, Web::IndexedDB::PersistedDatabaseChanges const&);
+
+    NonnullRefPtr<Database::Database> m_database;
+    Statements m_statements;
+    Vector<Subscriber> m_subscribers;
+    Vector<UpgradeLock> m_upgrade_locks;
+};
+
