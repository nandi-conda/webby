+using IndexedDBClient = Variant<WeakPtr<WebContentClient>, WeakPtr<WebWorkerClient>>;
+
+// AD-HOC: Every IndexedDB database of a browsing session, shared by all of its content and worker processes. A process
+//         loads a storage key's databases once (and is then told of every change other processes commit to them) and
+//         sends what each of its transactions commits. The ordinary session keeps them in SQLite in the profile; a
+//         private one keeps them in memory.
+class WEBVIEW_API IndexedDBStore {
+    AK_MAKE_NONCOPYABLE(IndexedDBStore);
+    AK_MAKE_NONMOVABLE(IndexedDBStore);
+
+public:
+    AK_ALLOC_WITH_KMALLOC;
+
+    static ErrorOr<Database::MigrationOutcome> migrate_schema(Database::Database&, Database::MigrationMode);
