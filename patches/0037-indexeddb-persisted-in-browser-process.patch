+    // AD-HOC: Describes where the records this log touched in store ended up, for the browser process to store, or
+    //         None if nothing changed. Readwrite transactions only: schema entries are not described.
+    pub(crate) fn persisted_changes(&self, store: ObjectStoreRef) -> Option<PersistedObjectStoreChanges> {
+        // The records and index records this log stored or deleted, by their encoded keys. What gets persisted is
+        // whether each is there now, and with which value.
+        let mut record_keys: HashMap<Vec<u8>, Rc<Key>> = HashMap::new();
+        let mut index_records: Vec<(IndexRef, HashMap<Vec<u8>, IndexRecord>)> = Vec::new();
+        let mut key_generator_changed = false;
+
+        let mut note_index_record = |index: IndexRef, record: &IndexRecord| {
+            let mut encoded = encode_key(&record.key);
+            encoded.extend_from_slice(&encode_key(&record.value));
+            let position = match index_records.iter().position(|(entry, _)| *entry == index) {
+                Some(position) => position,
+                None => {
+                    index_records.push((index, HashMap::new()));
+                    index_records.len() - 1
+                }
+            };
+            index_records[position].1.insert(encoded, record.clone());
+        };
+
+        for entry in self.entries.borrow().iter() {
+            match entry {
+                Entry::RecordsDeleted { records } => {
+                    for record in records {
+                        record_keys.insert(encode_key(&record.key), record.key.clone());
+                    }
+                }
+                Entry::RecordStored { key } => {
+                    record_keys.insert(encode_key(key), key.clone());
+                }
+                Entry::IndexRecordsDeleted { index, records } => {
+                    for record in records {
+                        note_index_record(*index, record);
+                    }
+                }
+                Entry::IndexRecordStored { index, record } => {
+                    note_index_record(*index, record);
+                }
+                Entry::KeyGeneratorChanged { .. } => {
+                    key_generator_changed = true;
+                }
+                _ => {}
+            }
+        }
+
+        if record_keys.is_empty() && index_records.is_empty() && !key_generator_changed {
+            return None;
+        }
+
+        let mut changes = PersistedObjectStoreChanges {
+            name: store.name(),
+            ..PersistedObjectStoreChanges::default()
+        };
+
+        for (encoded_key, key) in record_keys {
+            match store.record_with_key(&key) {
+                Some(record) => changes.stored.push(PersistedRecord {
+                    key: encoded_key,
+                    value: record.value.to_vec(),
+                }),
+                None => changes.deleted.push(encoded_key),
+            }
+        }
+
+        for (index, records) in index_records {
+            // An index deleted since is not persisted.
+            if store.index_set_get(&index.name()).is_none_or(|current| current != index) {
+                continue;
+            }
+            let mut index_changes = PersistedIndexChanges {
+                name: index.name(),
+                ..PersistedIndexChanges::default()
+            };
+            for record in records.values() {
+                let persisted_record = PersistedIndexRecord {
+                    key: encode_key(&record.key),
+                    primary_key: encode_key(&record.value),
+                };
+                if index.has_record(record) {
+                    index_changes.stored.push(persisted_record);
+                } else {
+                    index_changes.deleted.push(persisted_record);
+                }
+            }
+            changes.indexes.push(index_changes);
+        }
