+// The browser process obtains the storage key of a page's IndexedDB databases from the environment that asks.
+Messages::WebContentClient::DidRequestIndexedDatabasesResponse WebContentClient::did_request_indexed_databases(Web::PageId page_id, Web::HTML::EnvironmentId environment_id)
+{
+    auto* page = this->page(page_id);
+    if (!page)
+        return Vector<Web::IndexedDB::PersistedDatabase> {};
+
+    auto storage_key = page->indexed_database_storage_key(environment_id);
+    if (!storage_key.has_value())
+        return Vector<Web::IndexedDB::PersistedDatabase> {};
+
+    return session().indexed_db_store->load(WeakPtr<WebContentClient> { *this }, *storage_key);
+}
+
+void WebContentClient::did_commit_indexed_database_changes(Web::PageId page_id, Web::HTML::EnvironmentId environment_id, u64 commit_id, Web::IndexedDB::PersistedDatabaseChanges changes)
+{
+    auto* page = this->page(page_id);
+    if (!page)
+        return;
+
+    auto storage_key = page->indexed_database_storage_key(environment_id);
+    if (!storage_key.has_value())
+        return;
+
+    session().indexed_db_store->commit(WeakPtr<WebContentClient> { *this }, *storage_key, commit_id, changes);
+}
+
+Messages::WebContentClient::DidRequestIndexedDatabaseUpgradeLockResponse WebContentClient::did_request_indexed_database_upgrade_lock(Web::PageId page_id, Web::HTML::EnvironmentId environment_id, Utf16String name)
+{
+    auto* page = this->page(page_id);
+    if (!page)
+        return { false, {} };
+
+    auto storage_key = page->indexed_database_storage_key(environment_id);
+    if (!storage_key.has_value())
+        return { false, {} };
+
+    auto lock = session().indexed_db_store->lock_for_upgrade(WeakPtr<WebContentClient> { *this }, *storage_key, name);
+    return { lock.granted, lock.stored_version };
+}
+
+void WebContentClient::did_release_indexed_database_upgrade_lock(Web::PageId page_id, Web::HTML::EnvironmentId environment_id, Utf16String name)
+{
+    auto* page = this->page(page_id);
+    if (!page)
+        return;
+
+    auto storage_key = page->indexed_database_storage_key(environment_id);
+    if (!storage_key.has_value())
+        return;
+
+    session().indexed_db_store->release_upgrade_lock(WeakPtr<WebContentClient> { *this }, *storage_key, name);
+}
