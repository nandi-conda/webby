+bool MutationLog::append_persisted_changes(ObjectStore& store, PersistedObjectStoreChanges& changes) const
+{
+    // The records and index records this log stored or deleted, by their encoded keys. What gets persisted is whether
+    // each is there now, and with which value.
+    HashMap<ByteBuffer, GC::Ref<Key>> record_keys;
+    HashMap<Utf16String, HashMap<ByteBuffer, IndexRecord>> index_records;
+    bool key_generator_changed = false;
+
+    auto note_index_record = [&](Index const& index, IndexRecord const& record) {
+        auto encoded = encode_key(*record.key);
+        auto encoded_value = encode_key(*record.value);
+        encoded.append(encoded_value.bytes());
+        index_records.ensure(index.name()).set(move(encoded), record);
+    };
+
+    for (auto const& entry : m_entries) {
+        entry.visit(
+            [&](RecordsDeleted const& e) {
+                for (auto const& record : e.records)
+                    record_keys.set(encode_key(*record.key), record.key);
+            },
+            [&](RecordStored const& e) {
+                record_keys.set(encode_key(*e.key), e.key);
+            },
+            [&](IndexRecordsDeleted const& e) {
+                for (auto const& record : e.records)
+                    note_index_record(*e.index, record);
+            },
+            [&](IndexRecordStored const& e) {
+                note_index_record(*e.index, e.record);
+            },
+            [&](KeyGeneratorChanged const&) {
+                key_generator_changed = true;
+            },
+            [&](auto const&) {
+            });
+    }
+
+    if (record_keys.is_empty() && index_records.is_empty() && !key_generator_changed)
+        return false;
+
+    changes.name = store.name();
+
+    for (auto const& [encoded_key, key] : record_keys) {
+        if (auto record = store.record_with_key(key); record.has_value())
+            changes.stored.append({ encoded_key, MUST(ByteBuffer::copy(record->value->data)) });
+        else
+            changes.deleted.append(encoded_key);
+    }
+
+    for (auto const& [index_name, records] : index_records) {
+        auto index = store.index_set().get(index_name);
+        if (!index.has_value())
+            continue;
+
+        PersistedIndexChanges index_changes;
+        index_changes.name = index_name;
+        for (auto const& [_, record] : records) {
+            PersistedIndexRecord persisted_record { encode_key(*record.key), encode_key(*record.value) };
+            if ((*index)->has_record(record))
+                index_changes.stored.append(move(persisted_record));
+            else
+                index_changes.deleted.append(move(persisted_record));
+        }
+        changes.indexes.append(move(index_changes));
+    }
+
+    if (store.uses_a_key_generator())
+        changes.key_generator = store.key_generator().current_number();
+
+    return true;
+}
