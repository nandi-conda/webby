+    // One read for the whole frame, then flip its rows (GL's run bottom-up): on a hardware GPU every glReadPixels
+    // call waits for the GPU and copies out of the tiled framebuffer, so reading row by row costs a sync per row.
+    auto row_bytes = static_cast<size_t>(m_size.width()) * 4;
+    if (bitmap->pitch() == row_bytes) {
+        glReadPixels(0, 0, m_size.width(), m_size.height(), GL_RGBA, GL_UNSIGNED_BYTE, bitmap->scanline_u8(0));
+        auto row = MUST(ByteBuffer::create_uninitialized(row_bytes));
+        for (int top = 0, bottom = m_size.height() - 1; top < bottom; ++top, --bottom) {
+            memcpy(row.data(), bitmap->scanline_u8(top), row_bytes);
+            memcpy(bitmap->scanline_u8(top), bitmap->scanline_u8(bottom), row_bytes);
+            memcpy(bitmap->scanline_u8(bottom), row.data(), row_bytes);
+        }
+    } else {
+        for (int source_y = 0; source_y < m_size.height(); ++source_y)
+            glReadPixels(0, source_y, m_size.width(), 1, GL_RGBA, GL_UNSIGNED_BYTE, bitmap->scanline_u8(m_size.height() - source_y - 1));
+    }
 
