+// Sets the end and else positions of the structured instructions, as Expression::parse does.
+ParseResult<Expression> finish_expression(Vector<Instruction> instructions)
+{
+    Vector<InstructionPointer> stack;
+    Vector<Instruction> result;
+    result.ensure_capacity(instructions.size() + 1);
+    InstructionPointer ip { 0 };
+    for (auto& instruction : instructions) {
+        switch (instruction.opcode().value()) {
+        case Instructions::block.value():
+        case Instructions::loop.value():
+        case Instructions::if_.value():
+        case Instructions::try_table.value():
+            stack.append(ip);
+            break;
+        case Instructions::structured_end.value(): {
+            if (stack.is_empty()) {
+                result.empend(Instructions::synthetic_end_expression);
+                return Expression { move(result) };
+            }
+            auto entry = stack.take_last();
+            bool valid_type = result[entry.value()].arguments().visit(
+                [&](Instruction::StructuredInstructionArgs& args) {
+                    args.end_ip = ip + (args.else_ip().has_value() ? 1 : 0);
+                    return true;
+                },
+                [&](Instruction::TryTableArgs& args) {
+                    args.end_ip = ip;
+                    return true;
+                },
+                [](auto&) { return false; });
+            if (!valid_type)
+                return ParseError::InvalidType;
+            break;
+        }
+        case Instructions::structured_else.value(): {
+            if (stack.is_empty())
+                return ParseError::UnknownInstruction;
+            auto* args = result[stack.last().value()].arguments().get_pointer<Instruction::StructuredInstructionArgs>();
+            if (!args)
+                return ParseError::InvalidType;
+            args->else_ip() = ip + 1;
+            break;
+        }
+        }
+        result.append(move(instruction));
+        ++ip;
+    }
+    return ParseError::UnexpectedEof;
+}
+
+// Parses a function body that may use the legacy exception instructions, and lowers them (see above).
+ParseResult<Expression> parse_function_body(ConstrainedStream& stream, Vector<Locals>& locals, size_t size_hint)
+{
+    Vector<Instruction> raw;
+    raw.ensure_capacity(size_hint);
+    HashMap<size_t, LegacyInstruction> legacy;
+    bool has_delegate = false;
+    size_t nesting = 0;
+    while (true) {
+        auto byte = TRY_READ(stream, u8, ParseError::ExpectedKindTag);
+        switch (byte) {
+        case 0x06: // try bt
+            legacy.set(raw.size(), { LegacyOp::Try, TRY(BlockType::parse(stream)), 0 });
+            raw.empend(Instructions::nop);
+            ++nesting;
+            continue;
+        case 0x07: // catch x
+            legacy.set(raw.size(), { LegacyOp::Catch, {}, TRY(GenericIndexParser<TagIndex>::parse(stream)).value() });
+            raw.empend(Instructions::nop);
+            continue;
+        case 0x19: // catch_all
+            legacy.set(raw.size(), { LegacyOp::CatchAll, {}, 0 });
+            raw.empend(Instructions::nop);
+            continue;
+        case 0x18: // delegate l
+            if (nesting == 0)
+                return ParseError::UnknownInstruction;
+            --nesting;
+            legacy.set(raw.size(), { LegacyOp::Delegate, {}, TRY(GenericIndexParser<LabelIndex>::parse(stream)).value() });
+            raw.empend(Instructions::nop);
+            has_delegate = true;
+            continue;
+        case 0x09: // rethrow l
+            legacy.set(raw.size(), { LegacyOp::Rethrow, {}, TRY(GenericIndexParser<LabelIndex>::parse(stream)).value() });
+            raw.empend(Instructions::nop);
+            continue;
+        default:
+            break;
+        }
+
+        auto instruction = TRY(Instruction::parse(stream, OpCode { byte }));
+        auto opcode = instruction.opcode();
+        if (opcode == Instructions::block || opcode == Instructions::loop || opcode == Instructions::if_ || opcode == Instructions::try_table) {
+            ++nesting;
+        } else if (opcode == Instructions::structured_end) {
+            if (nesting == 0) {
+                raw.append(move(instruction));
+                break;
+            }
+            --nesting;
+        }
+        raw.append(move(instruction));
+    }
+
+    if (legacy.is_empty())
+        return finish_expression(move(raw));
+
+    auto* context = s_legacy_exception_context;
+    if (!context || context->next_function == 0 || context->next_function > context->function_types.size())
+        return ParseError::UnknownInstruction;
+    auto type_index = context->function_types[context->next_function - 1].value();
+    if (type_index >= context->types.types().size() || !context->types.types()[type_index].is_function())
+        return ParseError::InvalidType;
+    u64 first_new_local = context->types.types()[type_index].function().parameters().size();
+    for (auto const& entry : locals)
+        first_new_local += entry.n();
+    if (first_new_local > NumericLimits<u32>::max())
+        return ParseError::HugeAllocationRequested;
+
+    LegacyExceptionLowering lowering { raw, legacy, *context, static_cast<u32>(first_new_local) };
+    auto instructions = TRY(lowering.lower(has_delegate));
+    locals.extend(lowering.take_locals());
+    return finish_expression(move(instructions));
+}
+
