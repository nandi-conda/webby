+int EventLoopManagerUnix::current_thread_wait_set(Vector<int>& read_fds)
+{
+    auto& thread_data = ThreadData::the();
+    MutexLocker locker(thread_data.mutex);
+
+    read_fds.clear_with_capacity();
+    for (auto const& poll_fd : thread_data.poll_fds) {
+        if (poll_fd.events & POLLIN)
+            read_fds.append(poll_fd.fd);
+    }
+
+    if (ThreadEventQueue::current().has_pending_events())
+        return 0;
+    auto now = MonotonicTime::now();
+    thread_data.timeouts.absolutize_relative_timeouts(now);
+    auto next_timer_expiration = thread_data.timeouts.next_timer_expiration();
+    if (!next_timer_expiration.has_value())
+        return -1;
+    auto timeout = next_timer_expiration.value() - now;
+    if (timeout.is_negative())
+        return 0;
+    return static_cast<int>(min<i64>(AK::NumericLimits<i32>::max(), timeout.to_ceiled_milliseconds()));
+}
